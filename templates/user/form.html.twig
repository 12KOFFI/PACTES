{% extends 'base_dashboard.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier mon profil' : 'Créer un compte' }} | {{ parent() }}{% endblock %}

{% set input_class = 'w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition placeholder-slate-300' %}

{% block body %}
<div class="max-w-7xl mx-auto pb-10">

{# ===== EN-TÊTE ===== #}
<div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-6 md:p-8 mb-8 text-white relative overflow-hidden">
    <div class="absolute -top-14 -right-14 w-52 h-52 rounded-full bg-white/5 pointer-events-none"></div>
    <div class="absolute -bottom-16 left-1/3 w-64 h-64 rounded-full bg-white/[0.04] pointer-events-none"></div>

    <div class="relative z-10 flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-white/15 backdrop-blur border border-white/20 flex items-center justify-center text-2xl shrink-0">
            <i class="fas {{ is_edit ? 'fa-user-edit' : 'fa-user-plus' }}"></i>
        </div>
        <div>
            <h1 class="text-xl md:text-2xl font-bold tracking-tight">
                {{ is_edit ? 'Modifier mon profil' : 'Créer un compte utilisateur' }}
            </h1>
            <p class="text-white/60 text-sm mt-0.5">
                {{ is_edit ? 'Mettez à jour vos informations personnelles' : 'Remplissez vos informations pour créer votre espace personnel' }}
            </p>
        </div>
    </div>
</div>

{% include 'partials/_flash_messages.html.twig' %}

{{ form_start(form, {'attr': {'class': 'space-y-5', 'novalidate': 'novalidate'}}) }}

{# ===== IDENTITÉ ===== #}
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/60 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600">
            <i class="fas fa-user text-sm"></i>
        </div>
        <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Identité</h2>
    </div>
    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                Nom{% if not is_edit %}<span class="text-red-500">*</span>{% endif %}
            </label>
            {{ form_widget(form.nom, {'attr': {'class': input_class ~ ' uppercase', 'placeholder': 'Votre nom de famille'}}) }}
            {{ form_errors(form.nom) }}
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                Prénoms{% if not is_edit %}<span class="text-red-500">*</span>{% endif %}
            </label>
            {{ form_widget(form.prenoms, {'attr': {'class': input_class, 'placeholder': 'Vos prénoms'}}) }}
            {{ form_errors(form.prenoms) }}
        </div>
        {% if form.role is defined %}
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Rôle</label>
            {{ form_widget(form.role, {'attr': {'class': input_class ~ ' bg-white'}}) }}
            {{ form_errors(form.role) }}
        </div>
        {% endif %}
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Nom de jeune fille</label>
            {{ form_widget(form.nomjeunefille, {'attr': {'class': input_class, 'placeholder': 'Si applicable'}}) }}
            {{ form_errors(form.nomjeunefille) }}
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                Sexe{% if not is_edit %}<span class="text-red-500">*</span>{% endif %}
            </label>
            {{ form_widget(form.sexe, {'attr': {'class': input_class ~ ' bg-white'}}) }}
            {{ form_errors(form.sexe) }}
        </div>
        <div class="md:col-span-2">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                Email{% if not is_edit %}<span class="text-red-500">*</span>{% endif %}
            </label>
            {{ form_widget(form.email, {'attr': {'class': is_edit ? input_class ~ ' bg-slate-50' : input_class, 'placeholder': 'exemple@email.com'}}) }}
            {{ form_errors(form.email) }}
        </div>
    </div>
</div>

{# ===== NAISSANCE & NATIONALITÉ ===== #}
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/60 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600">
            <i class="fas fa-calendar-alt text-sm"></i>
        </div>
        <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Naissance & Nationalité</h2>
    </div>
    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                Date de naissance{% if not is_edit %}<span class="text-red-500">*</span>{% endif %}
            </label>
            {{ form_widget(form.datenaissance, {'attr': {'class': input_class}}) }}
            {{ form_errors(form.datenaissance) }}
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                Lieu de naissance{% if not is_edit %}<span class="text-red-500">*</span>{% endif %}
            </label>
            {{ form_widget(form.lieunaissance, {'attr': {'class': input_class, 'placeholder': 'Ville de naissance'}}) }}
            {{ form_errors(form.lieunaissance) }}
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                Nationalité{% if not is_edit %}<span class="text-red-500">*</span>{% endif %}
            </label>
            {{ form_widget(form.nationalite, {'attr': {'class': input_class, 'placeholder': 'Ex: Ivoirienne'}}) }}
            {{ form_errors(form.nationalite) }}
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">N° extrait de naissance</label>
            {{ form_widget(form.numextrait, {'attr': {'class': input_class, 'placeholder': 'Numéro d\'extrait'}}) }}
            {{ form_errors(form.numextrait) }}
        </div>
    </div>
</div>

{# ===== RÉSIDENCE & CONTACT ===== #}
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/60 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600">
            <i class="fas fa-map-marker-alt text-sm"></i>
        </div>
        <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Résidence & Contact</h2>
    </div>
    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                Lieu de résidence{% if not is_edit %}<span class="text-red-500">*</span>{% endif %}
            </label>
            {{ form_widget(form.residence, {'attr': {'class': input_class, 'placeholder': 'Votre ville de résidence'}}) }}
            {{ form_errors(form.residence) }}
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                Contact{% if not is_edit %}<span class="text-red-500">*</span>{% endif %}
            </label>
            {{ form_widget(form.contact, {'attr': {'class': input_class ~ ' font-mono', 'placeholder': '0708091011', 'pattern': '[0-9]{10}', 'maxlength': '10'}}) }}
            {{ form_errors(form.contact) }}
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Situation matrimoniale</label>
            {{ form_widget(form.situationmat, {'attr': {'class': input_class ~ ' bg-white'}}) }}
            {{ form_errors(form.situationmat) }}
        </div>
    </div>
</div>

{# ===== PARENTS ===== #}
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/60 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center text-amber-600">
            <i class="fas fa-users text-sm"></i>
        </div>
        <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Informations sur les parents</h2>
    </div>
    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Nom du père</label>
            {{ form_widget(form.nompere, {'attr': {'class': input_class, 'placeholder': 'Nom complet du père'}}) }}
            {{ form_errors(form.nompere) }}
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Nom de la mère</label>
            {{ form_widget(form.nommere, {'attr': {'class': input_class, 'placeholder': 'Nom complet de la mère'}}) }}
            {{ form_errors(form.nommere) }}
        </div>
    </div>
</div>

{# ===== IDENTIFIANTS (création uniquement) ===== #}
{% if not is_edit %}
<div class="bg-white rounded-2xl shadow-sm border border-indigo-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-indigo-100 bg-indigo-50/60 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600">
            <i class="fas fa-lock text-sm"></i>
        </div>
        <h2 class="text-sm font-semibold text-indigo-700 uppercase tracking-wider">Identifiants de connexion</h2>
    </div>
    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="md:col-span-2">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Email <span class="text-red-500">*</span></label>
            {{ form_widget(form.email, {'attr': {'class': input_class}}) }}
            {{ form_errors(form.email) }}
        </div>
        {% if is_register is defined and is_register %}
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Mot de passe <span class="text-red-500">*</span></label>
            {{ form_widget(form.password.first, {'attr': {'class': input_class}}) }}
            {{ form_errors(form.password.first) }}
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Confirmer <span class="text-red-500">*</span></label>
            {{ form_widget(form.password.second, {'attr': {'class': input_class}}) }}
            {{ form_errors(form.password.second) }}
        </div>
        {% endif %}
    </div>
</div>

{# Engagement #}
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="p-6">
        <label class="flex items-start gap-3 cursor-pointer group">
            <div class="relative mt-0.5 shrink-0">
                <input type="checkbox" id="accept" required class="peer sr-only">
                <div class="w-5 h-5 rounded-md border-2 border-slate-300 bg-white group-hover:border-indigo-400 peer-checked:bg-indigo-600 peer-checked:border-indigo-600 transition-all flex items-center justify-center">
                    <i class="fas fa-check text-white text-[9px]"></i>
                </div>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
                J'accepte que les informations fournies soient utilisées dans le cadre de ma candidature
                et j'atteste sur l'honneur leur exactitude.
            </p>
        </label>
    </div>
</div>
{% endif %}

{# ===== BOUTONS ===== #}
<div class="flex flex-col sm:flex-row items-center justify-between gap-3 py-2">
    <div class="flex flex-wrap gap-2 w-full sm:w-auto">
        <a href="{{ path('app_user_change_password') }}"
           class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-amber-200 bg-amber-50 text-amber-700 text-sm font-medium hover:bg-amber-100 transition">
            <i class="fas fa-key text-xs"></i> Changer le mot de passe
        </a>
        {% if is_edit %}
        <a href="{{ path('app_candidature_index') }}"
           class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-500 text-sm font-medium hover:bg-slate-50 transition">
            <i class="fas fa-arrow-left text-xs"></i> Annuler
        </a>
        {% endif %}
    </div>
    <button type="submit"
            class="inline-flex items-center gap-2 px-8 py-2.5 bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-bold rounded-xl shadow-md shadow-indigo-200/60 hover:from-indigo-700 hover:to-purple-700 hover:-translate-y-0.5 transition-all w-full sm:w-auto justify-center">
        <i class="fas {{ is_edit ? 'fa-save' : 'fa-user-plus' }}"></i>
        {{ is_edit ? 'Mettre à jour' : 'Créer mon compte' }}
    </button>
</div>

{{ form_end(form) }}

{% if not is_edit %}
<div class="text-center mt-4">
    <p class="text-sm text-slate-500">
        Déjà inscrit ?
        <a href="{{ path('app_login') }}" class="text-indigo-600 hover:text-indigo-800 font-semibold ml-1">
            Connectez-vous <i class="fas fa-arrow-right text-xs"></i>
        </a>
    </p>
</div>
{% endif %}

</div>
{% endblock %}
