<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="PACTE - Tableau de bord">
    <title>{% block title %}PACTE - Tableau de bord{% endblock %}</title>
    
    <!-- Preconnect pour accélérer les CDN -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- CSS Principal Webpack Encore (Tailwind CSS compilé) -->
    {{ encore_entry_link_tags('app') }}
    

    
    <style>
    .bg-gradient-to-r {
        transition: all 0.3s ease;
    }
    .bg-gradient-to-r:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
    }
    select:required, input:required {
        border-left-width: 3px;
        border-left-color: #4f46e5;
    }
    input:disabled, select:disabled {
        background-color: #f8fafc;
        cursor: not-allowed;
    }
    optgroup {
        font-weight: 600;
        color: #4f46e5;
    }
    [x-cloak] { display: none !important; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .sidebar-transition {
        transition: width 0.3s ease-in-out;
    }
    .sidebar-transition * {
        transition: opacity 0.2s ease-in-out;
    }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; }
    .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.4); }
    .scrollbar-thin { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.2) transparent; }
    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.2), 0 10px 10px -5px rgba(79, 70, 229, 0.1);
    }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50">
    <div class="flex h-screen overflow-hidden" x-data="{ sidebarOpen: false }">
        {% block sidebar %}
            {% include 'sidebar.html.twig' %}
        {% endblock %}
        
        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Navbar -->
            <header class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-40">
                <div class="px-4 lg:px-6 py-3 flex justify-between items-center gap-4">
                    <!-- Bouton hamburger mobile -->
                    <button @click="sidebarOpen = true" class="lg:hidden p-2 -ml-1 rounded-lg hover:bg-gray-100 text-gray-600 transition">
                        <i class="fas fa-bars text-lg"></i>
                    </button>
                    <!-- Message de bienvenue -->
                    <div class="flex items-center gap-2">
                        <span class="text-sm text-gray-600">Bienvenue,</span>
                        <span class="text-sm font-semibold text-gray-800">{{ app.user.nom }}</span>
                        <span class="hidden sm:inline text-sm text-gray-500">({{ app.user.prenoms }})</span>
                    </div>
                    
                    <!-- Espace vide -->
                    <div class="hidden lg:block flex-1"></div>
                    
                    <!-- Profil utilisateur -->
                    <div class="flex items-center gap-3">
                        {% if app.user %}
                        <div class="relative" x-data="{ open: false }">
                            <button @click="open = !open" class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-gray-100 transition focus:outline-none focus:ring-2 focus:ring-primary-500" :class="{ 'bg-gray-100': open }">
                                <!-- Avatar -->
                                <div class="w-9 h-9 rounded-full bg-gradient-to-br from-primary-500 to-secondary-600 flex items-center justify-center text-white font-semibold text-sm">
                                    {{ app.user.nom|first|upper }}{{ app.user.prenoms|first|upper }}
                                </div>
                                
                                <!-- Info - caché sur mobile -->
                                <div class="hidden xl:flex flex-col items-start">
                                    <span class="text-sm font-medium text-gray-800 leading-tight">{{ app.user.nom }}</span>
                                    <span class="text-xs text-gray-500">{% if is_granted('ROLE_ADMIN') %}Administrateur{% elseif is_granted('ROLE_AGENT') %}Agent DAIP{% elseif is_granted('ROLE_ETABLISSEMENT') or is_granted('ROLE_ENT') %}Établissement{% elseif is_granted('ROLE_JURY') %}Jury{% else %}Candidat{% endif %}</span>
                                </div>
                                
                                <i class="fas fa-chevron-down text-xs text-gray-400 transition-transform" :class="{ 'rotate-180': open }"></i>
                            </button>
                            
                            <!-- Dropdown menu -->
                            <div x-show="open" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95" @click.outside="open = false" class="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden">
                                <!-- En-tête -->
                                <div class="px-4 py-3 bg-gradient-to-r from-primary-50 to-secondary-50 border-b border-gray-100">
                                    <p class="text-sm font-semibold text-gray-800">{{ app.user.nom }} {{ app.user.prenoms }}</p>
                                    <p class="text-xs text-gray-500 mt-0.5">{{ app.user.email }}</p>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium mt-2
                                        {% if is_granted('ROLE_ADMIN') %}bg-red-100 text-red-700
                                        {% elseif is_granted('ROLE_AGENT') %}bg-indigo-100 text-indigo-700
                                        {% elseif is_granted('ROLE_ETABLISSEMENT') or is_granted('ROLE_ENT') %}bg-amber-100 text-amber-700
                                        {% elseif is_granted('ROLE_JURY') %}bg-blue-100 text-blue-700
                                        {% else %}bg-green-100 text-green-700{% endif %}">
                                        {% if is_granted('ROLE_ADMIN') %}Administrateur{% elseif is_granted('ROLE_AGENT') %}Agent DAIP{% elseif is_granted('ROLE_ETABLISSEMENT') or is_granted('ROLE_ENT') %}Établissement{% elseif is_granted('ROLE_JURY') %}Jury{% else %}Candidat{% endif %}
                                    </span>
                                </div>
                                
                                <!-- Links -->
                                <a href="{{ path('app_user_edit', {'id': app.user.id}) }}" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-600 transition">
                                    <i class="fas fa-user-circle w-4 text-gray-400"></i>Mon profil
                                </a>
                                <a href="{{ path('app_user_change_password') }}" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-600 transition">
                                    <i class="fas fa-key w-4 text-gray-400"></i>Changer le mot de passe
                                </a>
                                <div class="border-t border-gray-100 my-1"></div>
                                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition">
                                    <i class="fas fa-sign-out-alt w-4"></i>Déconnexion
                                </a>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </header>
            
            <!-- Page Content -->
            <main class="flex-1 overflow-y-auto p-4 lg:p-8 bg-gray-50">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash-message mb-6 p-4 rounded-xl relative animate-fade-in {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif label == 'error' %}bg-red-50 text-red-800 border border-red-200{% elseif label == 'warning' %}bg-amber-50 text-amber-800 border border-amber-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}" data-autodismiss="{{ label == 'success' ? '3000' : '5000' }}">
                            <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 p-1 text-{% if label == 'success' %}green{% elseif label == 'error' %}red{% elseif label == 'warning' %}amber{% else %}blue{% endif %}-500 hover:text-{% if label == 'success' %}green{% elseif label == 'error' %}red{% elseif label == 'warning' %}amber{% else %}blue{% endif %}-700 transition-colors" onclick="this.parentElement.remove()">
                                <i class="fas fa-times"></i>
                            </button>
                            <div class="flex items-center pr-8">
                                <i class="fas {% if label == 'success' %}fa-check-circle text-green-500{% elseif label == 'error' %}fa-exclamation-circle text-red-500{% elseif label == 'warning' %}fa-exclamation-triangle text-amber-500{% else %}fa-info-circle text-blue-500{% endif %} mr-3 text-lg"></i>
                                {{ message|raw }}
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
                
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
    
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    {# jQuery / DataTables — chargés uniquement si nécessaire #}
    {% block datatables_js %}{% endblock %}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.querySelector('aside');
            
            // Gestion du responsive
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 1024) {
                    // Desktop : always visible
                    if (sidebar && sidebar._x_) {
                        sidebar._x_.$data.mobileOpen = false;
                    }
                }
            });
        });
    </script>
    

    
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.flash-message[data-autodismiss]').forEach(function(message) {
            var delay = parseInt(message.dataset.autodismiss, 10);
            setTimeout(function() {
                message.style.animation = 'fadeOut 0.3s ease-out forwards';
                setTimeout(function() {
                    message.remove();
                }, 300);
            }, delay);
        });
    });
    </script>
    
    <style>
    @keyframes fadeOut {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(-10px);
        }
    }
    </style>
    
    {% block javascripts %}{% endblock %}
</body>
</html>
