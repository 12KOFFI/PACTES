{% extends 'base_dashboard.html.twig' %}

{% block title %}Programmation des entretiens | PACTE{% endblock %}

{% block body %}

{% include 'partials/_flash_messages.html.twig' %}

{# ===== En-tête ===== #}
<div class="relative overflow-hidden bg-gradient-to-r from-indigo-600 to-purple-600 p-8 mb-8 text-white rounded-2xl">
    <div class="absolute -right-10 -top-10 w-56 h-56 rounded-full bg-white/10"></div>
    <div class="absolute -right-24 -bottom-24 w-72 h-72 rounded-full bg-white/5"></div>
    <div class="relative flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
        <div class="w-14 h-14 shrink-0 bg-white/20 rounded-2xl flex items-center justify-center shadow-inner">
            <i class="fas fa-calendar-check text-2xl"></i>
        </div>
        <div class="flex-1">
            <h1 class="text-2xl font-bold">Programmation des entretiens</h1>
            <p class="text-white/80 mt-1 max-w-2xl">Importez la liste des candidats éligibles et répartissez-les automatiquement entre jurys, créneaux et dates d'entretien.</p>
        </div>
        <div class="hidden md:flex items-center gap-2 text-xs font-medium text-white/90">
            <span class="flex items-center gap-1.5 bg-white/15 rounded-full px-3 py-1.5">
                <span class="w-5 h-5 rounded-full bg-white/25 flex items-center justify-center text-[0.65rem]">1</span> Importer
            </span>
            <i class="fas fa-chevron-right text-white/50 text-[0.6rem]"></i>
            <span class="flex items-center gap-1.5 bg-white/15 rounded-full px-3 py-1.5">
                <span class="w-5 h-5 rounded-full bg-white/25 flex items-center justify-center text-[0.65rem]">2</span> Paramétrer
            </span>
            <i class="fas fa-chevron-right text-white/50 text-[0.6rem]"></i>
            <span class="flex items-center gap-1.5 bg-white/15 rounded-full px-3 py-1.5">
                <span class="w-5 h-5 rounded-full bg-white/25 flex items-center justify-center text-[0.65rem]">3</span> Répartir
            </span>
        </div>
    </div>
</div>

<div class="max-w-5xl mx-auto px-4 pb-16 space-y-8">

    {# ===== Formulaire d'import ===== #}
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="p-6 md:p-8">
            <h3 class="text-lg font-semibold text-indigo-800 flex items-center border-b border-slate-100 pb-4 mb-6">
                <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center mr-3">
                    <i class="fas fa-file-excel text-indigo-600"></i>
                </div>
                Import et paramètres de répartition
            </h3>

            <form method="post" action="{{ path('app_programmation_entretien') }}" enctype="multipart/form-data" class="space-y-8">
                <input type="hidden" name="_token" value="{{ csrf_token('programmation_entretiens') }}">

                {# --- Fichier --- #}
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-3">Fichier source</p>
                    <label for="fichier_excel" id="drop-zone"
                           class="group flex items-center gap-4 rounded-xl border-2 border-dashed border-slate-300 hover:border-indigo-400 bg-slate-50 hover:bg-indigo-50/50 transition cursor-pointer p-5">
                        <div id="file-icon-container" class="w-11 h-11 shrink-0 rounded-full bg-white border border-slate-200 group-hover:border-indigo-300 flex items-center justify-center">
                            <i id="file-icon" class="fas fa-file-arrow-up text-slate-400 group-hover:text-indigo-500 transition"></i>
                        </div>
                        <div class="flex-1">
                            <span id="file-name" class="block text-sm font-medium text-slate-700">
                                Fichier Excel des candidats éligibles <span class="text-red-500">*</span>
                            </span>
                            <span id="file-status" class="block text-xs text-slate-400 mt-0.5">Formats acceptés : .xlsx, .xls, .csv</span>
                        </div>
                        <span id="file-btn-text" class="hidden sm:inline-flex items-center px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-xs font-semibold text-slate-600 group-hover:border-indigo-300 group-hover:text-indigo-600 transition">
                            Parcourir
                        </span>
                    </label>
                    <input id="fichier_excel" type="file" name="fichier_excel" accept=".xlsx,.xls,.csv" required class="sr-only">
                </div>

                {# --- Établissement & Métier --- #}
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-3">Contexte de la session</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        
                        {# Lieu des entretiens / Établissement #}
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Lieu de l'entretien (Établissement) <span class="text-red-500">*</span>
                            </label>
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_JURY') %}
                                <div class="flex items-center gap-2.5 w-full border border-slate-300 rounded-lg px-3.5 py-2.5 bg-white focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-indigo-500 transition">
                                    <i class="fas fa-school text-slate-400"></i>
                                    <select id="select-etablissement" name="etablissement_id" required class="w-full border-0 p-0 bg-transparent focus:ring-0 focus:outline-none text-slate-700">
                                        <option value="">Sélectionnez un établissement</option>
                                        {% if etablissements is defined %}
                                            {% for etablissement in etablissements %}
                                                <option value="{{ etablissement.id }}">{{ etablissement.nom }}</option>
                                            {% endfor %}
                                        {% endif %}
                                    </select>
                                </div>
                            {% elseif is_granted('ROLE_ENT') %}
                                <div class="flex items-center gap-2.5 w-full border border-slate-200 bg-slate-100 rounded-lg px-3.5 py-2.5 text-slate-600 cursor-not-allowed">
                                    <i class="fas fa-building text-slate-400"></i>
                                    <input type="text" value="{{ etablissementConnecte ? etablissementConnecte.nom : 'Aucun établissement rattaché' }}" readonly class="w-full border-0 p-0 bg-transparent focus:ring-0 focus:outline-none cursor-not-allowed font-medium text-slate-700">
                                    {% if etablissementConnecte %}
                                        <input type="hidden" name="etablissement_id" value="{{ etablissementConnecte.id }}">
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>

                        {# Champ Sélection du Métier #}
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Métier / Spécialité <span class="text-red-500">*</span>
                            </label>
                            <div class="flex items-center gap-2.5 w-full border border-slate-300 rounded-lg px-3.5 py-2.5 bg-white focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-indigo-500 transition">
                                <i class="fas fa-briefcase text-slate-400"></i>
                                <select id="select-metier" name="metier_id" required class="w-full border-0 p-0 bg-transparent focus:ring-0 focus:outline-none text-slate-700">
                                    <option value="">Sélectionnez un métier</option>
                                    {% if metiers is defined %}
                                        {% for metier in metiers %}
                                            <option value="{{ metier.id }}">{{ metier.nom }}</option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                            </div>
                        </div>

                    </div>
                </div>

                {# --- Effectifs & Jurys --- #}
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-3">Répartition des jurys</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Nombre de jurys <span class="text-red-500">*</span>
                            </label>
                            <div class="flex items-center gap-2.5 w-full border border-slate-300 rounded-lg px-3.5 py-2.5 bg-white focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-indigo-500 transition">
                                <i class="fas fa-users text-slate-400"></i>
                                <input type="number" name="nb_jury" min="1" required placeholder="Ex: 3"
                                       class="w-full border-0 p-0 bg-transparent focus:ring-0 focus:outline-none">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Capacité par jury et par jour <span class="text-red-500">*</span>
                            </label>
                            <div class="flex items-center gap-2.5 w-full border border-slate-300 rounded-lg px-3.5 py-2.5 bg-white focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-indigo-500 transition">
                                <i class="fas fa-gauge-high text-slate-400"></i>
                                <input type="number" name="capacite_jury_jour" min="1" required placeholder="Ex: 40"
                                       class="w-full border-0 p-0 bg-transparent focus:ring-0 focus:outline-none">
                            </div>
                        </div>
                    </div>
                    {#
                    <div class="mt-3 rounded-lg border border-indigo-100 bg-indigo-50 p-3 text-xs text-indigo-700">
                        <i class="fas fa-info-circle mr-1"></i>
                        La capacité saisie est répartie automatiquement entre Créneau 1 (matin) et Créneau 2 (après-midi)
                        selon un ratio fixé par défaut (62,5% pour le mation et 37,5% pour l'après-midi — ex: 40 → 25 le matin, 15 l'après-midi).
                    </div>
                    #}
                </div>

                {# --- Période --- #}
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-3">Période des entretiens</p>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Date de début <span class="text-red-500">*</span>
                            </label>
                            <div class="flex items-center gap-2.5 w-full border border-slate-300 rounded-lg px-3.5 py-2.5 bg-white focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-indigo-500 transition">
                                <i class="fas fa-calendar-day text-slate-400"></i>
                                <input type="date" name="date_debut" required
                                       class="w-full border-0 p-0 bg-transparent focus:ring-0 focus:outline-none">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Date de fin <span class="text-red-500">*</span>
                            </label>
                            <div class="flex items-center gap-2.5 w-full border border-slate-300 rounded-lg px-3.5 py-2.5 bg-white focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-indigo-500 transition">
                                <i class="fas fa-calendar-check text-slate-400"></i>
                                <input type="date" name="date_fin" required
                                       class="w-full border-0 p-0 bg-transparent focus:ring-0 focus:outline-none">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-2 border-t border-slate-100">
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-8 py-2.5 bg-indigo-600 text-white font-semibold rounded-lg shadow-sm hover:bg-indigo-700 hover:shadow-md active:scale-[0.98] transition">
                        <i class="fas fa-shuffle"></i>
                        Lancer la répartition
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# ===== Résultats de la programmation ===== #}
    {% if resultats is defined and resultats is not null %}
    <div class="space-y-6">

        <div class="flex items-center justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-3 flex-1 min-w-[200px]">
                <div class="h-px flex-1 bg-slate-200"></div>
                <span class="text-xs font-semibold uppercase tracking-wide text-slate-400 whitespace-nowrap">Résultat de la répartition</span>
                <div class="h-px flex-1 bg-slate-200"></div>
            </div>
            <a href="{{ path('app_programmation_entretien_export', {
                    lieu: resultats.lieu,
                    date_debut: resultats.date_debut,
                    date_fin: resultats.date_fin,
                    metier_id: resultats.metier_id,
                    etablissement_id: resultats.etablissement_id
                }) }}"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-green-600 text-white text-sm font-semibold shadow-sm hover:bg-green-700 hover:shadow-md active:scale-[0.98] transition">
                <i class="fas fa-file-excel"></i>
                Exporter le planning par jury (Excel)
            </a>
        </div>

        {# Récapitulatif de la capacité calculée automatiquement #}
        <div class="rounded-xl border border-indigo-100 bg-indigo-50 p-4 flex flex-wrap gap-x-8 gap-y-2 text-sm text-indigo-800">
            <span><i class="fas fa-calendar-days mr-1.5"></i> <strong>{{ resultats.nb_jours }}</strong> jour(s) programmé(s)</span>
            <span><i class="fas fa-gauge-high mr-1.5"></i> <strong>{{ resultats.capacite_jury_jour }}</strong> candidats / jury / jour</span>
            <span><i class="fas fa-sun mr-1.5"></i> Créneau 1 (08h-12h) : <strong>{{ resultats.capacite_creneau1 }}</strong></span>
            <span><i class="fas fa-cloud-sun mr-1.5"></i> Créneau 2 (13h-15h) : <strong>{{ resultats.capacite_creneau2 }}</strong></span>
        </div>

        {# Cartes de statistiques #}
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 text-center hover:shadow-md transition">
                <div class="w-9 h-9 mx-auto mb-2 rounded-full bg-slate-100 flex items-center justify-center">
                    <i class="fas fa-file-import text-slate-500 text-sm"></i>
                </div>
                <p class="text-2xl font-bold text-slate-800">{{ resultats.total_excel }}</p>
                <p class="text-xs text-slate-500 mt-1">Dans le fichier</p>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-green-200 p-4 text-center hover:shadow-md transition">
                <div class="w-9 h-9 mx-auto mb-2 rounded-full bg-green-100 flex items-center justify-center">
                    <i class="fas fa-user-plus text-green-600 text-sm"></i>
                </div>
                <p class="text-2xl font-bold text-green-700">{{ resultats.nb_nouveaux }}</p>
                <p class="text-xs text-green-700 mt-1">Nouveaux</p>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-blue-200 p-4 text-center hover:shadow-md transition">
                <div class="w-9 h-9 mx-auto mb-2 rounded-full bg-blue-100 flex items-center justify-center">
                    <i class="fas fa-rotate text-blue-600 text-sm"></i>
                </div>
                <p class="text-2xl font-bold text-blue-700">{{ resultats.nb_reprogrammes }}</p>
                <p class="text-xs text-blue-700 mt-1">Reprogrammés</p>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-red-200 p-4 text-center hover:shadow-md transition">
                <div class="w-9 h-9 mx-auto mb-2 rounded-full bg-red-100 flex items-center justify-center">
                    <i class="fas fa-circle-question text-red-600 text-sm"></i>
                </div>
                <p class="text-2xl font-bold text-red-700">{{ resultats.introuvables|length }}</p>
                <p class="text-xs text-red-700 mt-1">Introuvables</p>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-amber-200 p-4 text-center hover:shadow-md transition">
                <div class="w-9 h-9 mx-auto mb-2 rounded-full bg-amber-100 flex items-center justify-center">
                    <i class="fas fa-ban text-amber-600 text-sm"></i>
                </div>
                <p class="text-2xl font-bold text-amber-700">{{ resultats.non_admissibles|length }}</p>
                <p class="text-xs text-amber-700 mt-1">Non admissibles</p>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 text-center hover:shadow-md transition">
                <div class="w-9 h-9 mx-auto mb-2 rounded-full bg-slate-100 flex items-center justify-center">
                    <i class="fas fa-hourglass-half text-slate-500 text-sm"></i>
                </div>
                <p class="text-2xl font-bold text-slate-700">{{ resultats.sans_creneau|length }}</p>
                <p class="text-xs text-slate-600 mt-1">Sans créneau</p>
            </div>
        </div>

        {% if resultats.sans_creneau|length > 0 %}
        <div class="flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            <div class="w-8 h-8 shrink-0 rounded-full bg-red-100 flex items-center justify-center">
                <i class="fas fa-exclamation-triangle text-red-600"></i>
            </div>
            <p class="pt-1">
                {{ resultats.sans_creneau|length }} candidat(s) n'ont pas pu être programmés faute de créneaux disponibles
                ({{ resultats.creneaux_disponibles }} créneaux générés pour cette période). Élargissez la période, augmentez le nombre de jurys
                ou la capacité par jour, puis relancez l'import avec les numéros restants.
            </p>
        </div>
        {% endif %}

        {# Tableau des candidats programmés #}
        {% if resultats.planifies|length > 0 %}
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
            <div class="p-6 md:p-8">
                <h3 class="text-lg font-semibold text-slate-800 flex items-center border-b border-slate-100 pb-4 mb-5">
                    <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center mr-3">
                        <i class="fas fa-check text-green-600"></i>
                    </div>
                    Candidats programmés
                    <span class="ml-auto text-sm font-normal text-slate-400">
                        <i class="fas fa-location-dot mr-1"></i>{{ resultats.lieu }}
                    </span>
                </h3>
                <div class="overflow-x-auto -mx-2">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs uppercase text-slate-400 border-b border-slate-100">
                                <th class="py-2.5 px-2">N° Candidature</th>
                                <th class="py-2.5 px-2">Candidat</th>
                                <th class="py-2.5 px-2">Date</th>
                                <th class="py-2.5 px-2">Créneau</th>
                                <th class="py-2.5 px-2">Jury</th>
                                <th class="py-2.5 px-2 text-right">Convocation</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {% for item in resultats.planifies %}
                            <tr class="hover:bg-slate-50 transition">
                                <td class="py-2.5 px-2 font-medium text-slate-700 whitespace-nowrap">
                                    {{ item.candidature.numero }}
                                    {% if item.reprogramme %}
                                    <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-[0.65rem] font-semibold bg-blue-100 text-blue-700">Reprogrammé</span>
                                    {% endif %}
                                </td>
                                <td class="py-2.5 px-2">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 shrink-0 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-[0.65rem] font-bold uppercase">
                                            {{ item.candidature.user ? item.candidature.user.nom|slice(0, 1) ~ item.candidature.user.prenoms|slice(0, 1) : '?' }}
                                        </div>
                                        <span class="text-slate-700">
                                            {{ item.candidature.user ? (item.candidature.user.nom ~ ' ' ~ item.candidature.user.prenoms)|trim : '-' }}
                                        </span>
                                    </div>
                                </td>
                                <td class="py-2.5 px-2 text-slate-600 whitespace-nowrap">{{ item.date|date('d/m/Y') }}</td>
                                <td class="py-2.5 px-2 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-100">
                                        Créneau {{ item.creneau }} · {{ item.creneau == 1 ? '08h-12h' : '13h-15h' }}
                                    </span>
                                </td>
                                <td class="py-2.5 px-2 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                                        Jury {{ item.jury }}
                                    </span>
                                </td>
                                <td class="py-2.5 px-2 text-right">
                                    <a href="{{ path('app_candidature_imprimer_convocation', {'id': item.candidature.id}) }}" target="_blank"
                                       class="inline-flex items-center px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition">
                                        <i class="fas fa-print mr-1.5"></i> Imprimer
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% endif %}

        {# Détail des candidats non traités #}
        {% if resultats.introuvables|length > 0 or resultats.non_admissibles|length > 0 or resultats.sans_creneau|length > 0 %}
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
            <div class="p-6 md:p-8">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400 mb-5">Candidats non traités</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {% if resultats.introuvables|length > 0 %}
                    <div class="rounded-xl border border-red-100 bg-red-50/50 p-4">
                        <p class="text-sm font-semibold text-red-700 mb-3 flex items-center justify-between">
                            <span><i class="fas fa-times-circle mr-1.5"></i> Introuvables</span>
                            <span class="text-xs font-bold bg-red-100 text-red-700 rounded-full px-2 py-0.5">{{ resultats.introuvables|length }}</span>
                        </p>
                        <ul class="text-xs text-slate-600 space-y-1.5 max-h-40 overflow-y-auto pr-1">
                            {% for numero in resultats.introuvables %}
                            <li class="font-mono bg-white/70 rounded px-2 py-1 border border-red-100">{{ numero }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                    {% if resultats.non_admissibles|length > 0 %}
                    <div class="rounded-xl border border-amber-100 bg-amber-50/50 p-4">
                        <p class="text-sm font-semibold text-amber-700 mb-3 flex items-center justify-between">
                            <span><i class="fas fa-ban mr-1.5"></i> Non admissibles</span>
                            <span class="text-xs font-bold bg-amber-100 text-amber-700 rounded-full px-2 py-0.5">{{ resultats.non_admissibles|length }}</span>
                        </p>
                        <ul class="text-xs text-slate-600 space-y-1.5 max-h-40 overflow-y-auto pr-1">
                            {% for numero in resultats.non_admissibles %}
                            <li class="font-mono bg-white/70 rounded px-2 py-1 border border-amber-100">{{ numero }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                    {% if resultats.sans_creneau|length > 0 %}
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                        <p class="text-sm font-semibold text-slate-700 mb-3 flex items-center justify-between">
                            <span><i class="fas fa-hourglass-half mr-1.5"></i> Sans créneau</span>
                            <span class="text-xs font-bold bg-slate-200 text-slate-700 rounded-full px-2 py-0.5">{{ resultats.sans_creneau|length }}</span>
                        </p>
                        <ul class="text-xs text-slate-600 space-y-1.5 max-h-40 overflow-y-auto pr-1">
                            {% for numero in resultats.sans_creneau %}
                            <li class="font-mono bg-white rounded px-2 py-1 border border-slate-200">{{ numero }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}

    </div>
    {% endif %}

</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // --- Dynamisme du champ de fichier Excel ---
            const fileInput = document.getElementById('fichier_excel');
            const fileNameSpan = document.getElementById('file-name');
            const fileStatusSpan = document.getElementById('file-status');
            const fileIconContainer = document.getElementById('file-icon-container');
            const fileIcon = document.getElementById('file-icon');
            const dropZone = document.getElementById('drop-zone');
            const fileBtnText = document.getElementById('file-btn-text');

            if (fileInput) {
                fileInput.addEventListener('change', function (e) {
                    const file = e.target.files[0];

                    if (file) {
                        const fileSize = (file.size / (1024 * 1024)).toFixed(2);
                        fileNameSpan.textContent = file.name;
                        fileNameSpan.classList.add('text-indigo-700', 'font-semibold');

                        fileStatusSpan.textContent = `Fichier sélectionné (${fileSize} Mo)`;
                        fileStatusSpan.classList.remove('text-slate-400');
                        fileStatusSpan.classList.add('text-green-600', 'font-medium');

                        fileIcon.className = 'fas fa-file-excel text-green-600 text-xl';
                        fileIconContainer.className = 'w-11 h-11 shrink-0 rounded-full bg-green-50 border border-green-200 flex items-center justify-center';
                        dropZone.className = 'group flex items-center gap-4 rounded-xl border-2 border-solid border-green-400 bg-green-50/30 transition cursor-pointer p-5';
                        
                        if (fileBtnText) {
                            fileBtnText.textContent = 'Changer';
                            fileBtnText.className = 'hidden sm:inline-flex items-center px-3 py-1.5 rounded-lg bg-green-100 border border-green-300 text-xs font-semibold text-green-700 transition';
                        }
                    } else {
                        fileNameSpan.innerHTML = 'Fichier Excel des candidats éligibles <span class="text-red-500">*</span>';
                        fileNameSpan.classList.remove('text-indigo-700', 'font-semibold');

                        fileStatusSpan.textContent = 'Formats acceptés : .xlsx, .xls, .csv';
                        fileStatusSpan.classList.remove('text-green-600', 'font-medium');
                        fileStatusSpan.classList.add('text-slate-400');

                        fileIcon.className = 'fas fa-file-arrow-up text-slate-400 group-hover:text-indigo-500 transition';
                        fileIconContainer.className = 'w-11 h-11 shrink-0 rounded-full bg-white border border-slate-200 group-hover:border-indigo-300 flex items-center justify-center';
                        dropZone.className = 'group flex items-center gap-4 rounded-xl border-2 border-dashed border-slate-300 hover:border-indigo-400 bg-slate-50 hover:bg-indigo-50/50 transition cursor-pointer p-5';

                        if (fileBtnText) {
                            fileBtnText.textContent = 'Parcourir';
                            fileBtnText.className = 'hidden sm:inline-flex items-center px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-xs font-semibold text-slate-600 group-hover:border-indigo-300 group-hover:text-indigo-600 transition';
                        }
                    }
                });
            }

            // --- Chargement dynamique des métiers selon l'établissement ---
            const selectEtablissement = document.getElementById('select-etablissement');
            const selectMetier = document.getElementById('select-metier');

            if (selectEtablissement && selectMetier) {
                selectEtablissement.addEventListener('change', function () {
                    const etablissementId = this.value;
                    selectMetier.innerHTML = '<option value="">Chargement des métiers...</option>';

                    if (!etablissementId) {
                        selectMetier.innerHTML = '<option value="">Sélectionnez d\'abord un établissement</option>';
                        return;
                    }

                    fetch(`/api/etablissements/${etablissementId}/metiers`)
                        .then(response => response.json())
                        .then(data => {
                            selectMetier.innerHTML = '<option value="">Sélectionnez un métier</option>';
                            data.forEach(metier => {
                                const option = document.createElement('option');
                                option.value = metier.id;
                                option.textContent = metier.nom || 'Métier non défini';
                                selectMetier.appendChild(option);
                            });
                        })
                        .catch(() => {
                            selectMetier.innerHTML = '<option value="">Erreur lors du chargement des métiers</option>';
                        });
                });
            }
        });
    </script>
{% endblock %}