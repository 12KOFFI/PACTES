{% extends 'base.html.twig' %}

{% block title %}PACTE - Recrutement 2026{% endblock %}

{% block meta %}
{{ parent() }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
<meta name="keywords" content="PACTE, solaire, photovoltaique, electricite, recrutement, apprentissage, CQP, 2026, Cote d'Ivoire">
<meta name="description" content="Projet PACTE - Recrutement de jeunes pour la formation par apprentissage au métier d'installateur de systèmes solaires photovoltaïques au titre de l'année 2026.">
{% endblock %}

{% block body %}


<!-- ==================== HERO SECTION ==================== -->
<section class="hero relative min-h-[600px] flex items-center justify-center text-white py-16" style="background: linear-gradient(135deg, #0A3D91 0%, #0052CC 60%, #1D4ED8 100%);">
    
    <!-- Éléments décoratifs sobres -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-0 left-0 w-72 h-72 rounded-full bg-blue-300 filter blur-3xl opacity-15 animate-pulse-glow"></div>
        <div class="absolute bottom-0 right-0 w-72 h-72 rounded-full bg-sky-300 filter blur-3xl opacity-15 animate-pulse-glow animation-delay-2000"></div>
        <div class="absolute bg-blue-400 rounded-full -bottom-40 -left-40 w-80 h-80 mix-blend-screen filter blur-3xl opacity-20"></div>
    </div>
    
    <div class="container relative z-10 w-full max-w-full px-4 mx-auto">
        <div class="max-w-4xl mx-auto text-center">
           
            
            <!-- Titre avec la police sobre et accents clairs -->
            <h1 class="hero-title text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight break-words">
                Recrutement de 250 jeunes 
                <span class="text-sky-200">
                    pour la formation au métier d’installateur de systèmes solaires photovoltaïques.
                </span>
            </h1>

            <!-- Actions principales (Hero CTA) -->
            <div class="hero-cta-group flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-10">
                <a href="#etablissements" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-bold text-sm text-white shadow-lg transition-all duration-300 hover:opacity-90 hover:-translate-y-0.5 active:scale-95" style="background-color: #EE9137;">
                    <i class="fas fa-paper-plane"></i>
                    <span>Choisir un établissement & Postuler</span>
                </a>
                <a href="#presentation" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-bold text-sm text-white bg-white/10 hover:bg-white/20 border border-white/25 backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5 active:scale-95">
                    <i class="fas fa-info-circle"></i>
                    <span>Conditions et déroulement</span>
                </a>
            </div>

            <!-- Stats rapides avec compteurs dynamiques GSAP -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-5 max-w-3xl mx-auto mb-10">
                <div class="stat-card p-3 sm:p-4 border bg-white/10 backdrop-blur-md rounded-2xl border-white/20 transition-transform hover:-translate-y-1 shadow-sm">
                    <div class="text-xl sm:text-3xl font-extrabold text-white">
                        <span class="stat-counter" data-target="{{ stats.metiers }}">{{ stats.metiers }}</span>
                    </div>
                    <div class="text-xs sm:text-sm font-medium text-blue-100 mt-1">Métier(s)</div>
                </div>
                <div class="stat-card p-3 sm:p-4 border bg-white/10 backdrop-blur-md rounded-2xl border-white/20 transition-transform hover:-translate-y-1 shadow-sm">
                    <div class="text-xl sm:text-3xl font-extrabold text-white">
                        <span class="stat-counter" data-target="{{ stats.etablissements }}">{{ stats.etablissements }}</span>
                    </div>
                    <div class="text-xs sm:text-sm font-medium text-blue-100 mt-1">Établissements</div>
                </div>
                <div class="stat-card p-3 sm:p-4 border bg-white/10 backdrop-blur-md rounded-2xl border-white/20 transition-transform hover:-translate-y-1 shadow-sm">
                    <div class="text-xl sm:text-3xl font-extrabold text-white">
                        <span class="stat-counter" data-target="{{ stats.places }}">{{ stats.places }}</span>
                    </div>
                    <div class="text-xs sm:text-sm font-medium text-blue-100 mt-1">Postes ouverts</div>
                </div>
                <div class="stat-card p-3 sm:p-4 border bg-white/10 backdrop-blur-md rounded-2xl border-white/20 transition-transform hover:-translate-y-1 shadow-sm">
                    <div class="text-xl sm:text-3xl font-extrabold text-white">
                        <span class="stat-counter" data-target="{{ stats.candidatures }}">{{ stats.candidatures }}</span>
                    </div>
                    <div class="text-xs sm:text-sm font-medium text-blue-100 mt-1">Candidatures</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll indicator -->
    <a href="#presentation" class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
        <div class="w-6 h-10 rounded-full border-2 border-white/30 flex justify-center">
            <div class="w-1 h-3 bg-white/60 rounded-full mt-2 animate-pulse"></div>
        </div>
    </a>
</section>

<!-- ==================== PRÉSENTATION SECTION ==================== -->
<section id="presentation" class="relative py-12 sm:py-20 bg-white w-full overflow-hidden">
    <!-- Conteneur de graffitis animés -->
    <div id="graffiti-container" class="absolute inset-0 overflow-hidden pointer-events-none"></div>
    
    <div class="container mx-auto px-4 relative z-10 w-full max-w-full">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
            <!-- Colonne gauche : Texte -->
            <div class="gsap-text-col space-y-5 text-slate-700 leading-relaxed">
                <!-- Eyebrow & Titre de section européen sobre -->
                <div>
                    <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-blue-900 mb-3.5 shadow-2xs">
                        <i class="fas fa-solar-panel text-blue-700"></i>
                        <span>RECRUTEMENT & FORMATION CQP 2026</span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
                        Formation au métier d'installateur de systèmes solaires photovoltaïques
                    </h2>
                </div>

                <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
                    Il est ouvert, au titre de l'année 2026, un recrutement de 
                    <span class="relative inline-block px-2">
                        <span class="absolute inset-0 bg-blue-100/80 rounded-lg -rotate-1"></span>
                        <strong class="relative text-blue-950 font-bold">deux cent cinquante (250) jeunes</strong>
                    </span>
                    pour la formation au métier d'<strong>installateur de systèmes solaires photovoltaïques</strong>. 
                </p>
                
                <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                    La formation, dispensée selon la modalité de l’<strong>Apprentissage</strong>, durera <strong>six (06) mois</strong> et sera sanctionnée d’un <strong>Certificat de Qualification Professionnelle (CQP)</strong>. 
                    Les formations théoriques se dérouleront au sein des lycées professionnels partenaires et les formations pratiques en immersion directe dans les entreprises partenaires.
                </p>

                <!-- 3 atouts clés du programme -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-2">
                    <div class="p-3.5 sm:p-4 bg-slate-50 border border-slate-200/90 rounded-2xl flex items-center gap-3 shadow-xs">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center flex-shrink-0 text-base">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div>
                            <p class="text-sm sm:text-base font-extrabold text-slate-900">06 mois</p>
                            <p class="text-xs sm:text-sm font-medium text-slate-600 mt-0.5">en Apprentissage</p>
                        </div>
                    </div>
                    <div class="p-3.5 sm:p-4 bg-slate-50 border border-slate-200/90 rounded-2xl flex items-center gap-3 shadow-xs">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center flex-shrink-0 text-base">
                            <i class="fas fa-award"></i>
                        </div>
                        <div>
                            <p class="text-sm sm:text-base font-extrabold text-slate-900">Diplôme CQP</p>
                            <p class="text-xs sm:text-sm font-medium text-slate-600 mt-0.5">Reconnu par l'État</p>
                        </div>
                    </div>
                    <div class="p-3.5 sm:p-4 bg-slate-50 border border-slate-200/90 rounded-2xl flex items-center gap-3 shadow-xs">
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0 text-base">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div>
                            <p class="text-sm sm:text-base font-extrabold text-slate-900">100% Gratuit</p>
                            <p class="text-xs sm:text-sm font-medium text-slate-600 mt-0.5">Formation prise en charge</p>
                        </div>
                    </div>
                </div>

                <!-- Bouton d'accès direct aux critères d'éligibilité -->
                <div class="pt-3">
                    <a href="#eligibilite" class="inline-flex items-center gap-2.5 px-5 py-3.5 bg-blue-50 border border-blue-200 text-blue-900 font-bold rounded-xl text-sm sm:text-base hover:bg-blue-100 hover:border-blue-300 transition-all duration-200 shadow-xs">
                        <i class="fas fa-user-check text-sm text-blue-700"></i>
                        <span>Consulter les conditions d'éligibilité</span>
                    </a>
                </div>
            </div>
            
            <!-- Colonne droite : Illustration -->
            <div class="gsap-image-col relative flex items-center justify-center mt-6 lg:mt-0">
                <!-- Illustration principale circulaire avec motif de pointillés -->
                <div class="relative w-full max-w-[480px] lg:max-w-[540px] flex items-center justify-center">
                    <picture>
                        <source srcset="{{ asset('image/recrutement_solaire_cqp.webp') }}" type="image/webp">
                        <img src="{{ asset('image/recrutement_solaire_cqp.png') }}" 
                             alt="Recrutement formation installateur de systèmes solaires photovoltaïques" 
                             class="w-full h-auto object-contain select-none transition-transform duration-500 hover:scale-[1.02] drop-shadow-sm"
                             loading="lazy">
                    </picture>
                    
                    <!-- Badge flottant avec statistique -->
                    <div class="gsap-float absolute -bottom-2 right-2 sm:bottom-2 sm:right-4 bg-white/95 backdrop-blur-md rounded-2xl shadow-xl p-3 sm:p-3.5 border border-slate-100 flex items-center gap-3">
                        <div class="w-10 h-10 sm:w-11 sm:h-11 bg-blue-50 border border-blue-100 rounded-xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-graduation-cap text-[#0B1C76] text-lg"></i>
                        </div>
                        <div>
                            <p class="text-xl sm:text-2xl font-extrabold text-[#0B1C76] leading-none">{{ stats.places|default(250) }}</p>
                            <p class="text-xs sm:text-sm font-semibold text-slate-700 mt-1">jeunes formés</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== SECTION PROMOTION DU GENRE & INCLUSION ==================== -->
<section id="genre" class="py-12 bg-slate-50 border-t border-slate-200">
    <div class="container mx-auto px-4 w-full max-w-6xl">
        <div class="p-6 sm:p-8 md:p-10 bg-white border border-slate-200/90 rounded-2xl shadow-sm hover:shadow-md transition-all duration-200">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-10">
                <!-- Texte & Détails -->
                <div class="flex-1 text-left">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-extrabold bg-blue-50 border border-blue-200/80 text-[#0B1C76] uppercase tracking-wider mb-3">
                        <i class="fas fa-venus text-blue-700"></i>
                        <span>Promotion du genre & Inclusion</span>
                    </div>

                    <h3 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug mb-4">
                        Les femmes aussi ont toute leur place dans l’énergie solaire !
                    </h3>

                    <div class="space-y-3.5">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-blue-100 text-[#0B1C76] flex items-center justify-center font-black text-sm flex-shrink-0 mt-0.5">
                                <i class="fas fa-bullseye"></i>
                            </div>
                            <p class="text-base sm:text-lg text-slate-800 leading-snug">
                                <strong>Notre ambition :</strong> au moins <strong>40 %</strong> de femmes parmi les participants.
                            </p>
                        </div>
                        
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-900 flex items-center justify-center text-sm flex-shrink-0 mt-0.5">
                                <i class="fas fa-check-double text-amber-700"></i>
                            </div>
                            <p class="text-base sm:text-lg font-bold text-slate-900 leading-snug">
                                Les candidatures féminines sont vivement encouragées !
                            </p>
                        </div>
                    </div>

                    <div class="mt-5 pt-4 border-t border-slate-100 text-xs sm:text-sm text-slate-600 flex items-center gap-2">
                        <i class="fas fa-check-circle text-emerald-600 flex-shrink-0"></i>
                        <span><strong>Formation 100 % gratuite</strong> : inscription, cours et immersion pratique pris en charge pour tous les apprenants retenus.</span>
                    </div>
                </div>

                <!-- Image Circulaire Professionnelle Extraite du Document Officiel -->
                <div class="flex-shrink-0 flex items-center justify-center">
                    <picture>
                        <source srcset="{{ asset('image/promotion_femmes_solaire.webp') }}" type="image/webp">
                        <img src="{{ asset('image/promotion_femmes_solaire.png') }}" 
                             alt="Les femmes aussi ont toute leur place dans l’énergie solaire !" 
                             class="w-44 h-44 sm:w-52 sm:h-52 md:w-60 md:h-60 object-contain drop-shadow-md select-none transition-transform duration-500 hover:scale-105"
                             loading="lazy">
                    </picture>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== SECTION ÉTABLISSEMENTS : UNE CARTE PAR ÉTABLISSEMENT ==================== -->
<section id="etablissements" class="py-12 bg-slate-100 sm:py-20 border-t border-slate-200">
    <div class="container w-full max-w-6xl px-4 mx-auto">
        <div class="mb-10 text-center">
            <div class="inline-flex items-center rounded-full border border-blue-200 bg-white px-3 sm:px-4 py-1.5 text-xs sm:text-sm font-semibold text-blue-900 mb-4 shadow-sm">
                <i class="mr-2 fas fa-school text-blue-700"></i>
                STRUCTURES DE FORMATION
            </div>
            <h2 class="text-2xl font-bold sm:text-3xl md:text-4xl text-slate-900">
                Choisissez votre établissement
            </h2>
            <p class="max-w-2xl mx-auto mt-2 text-sm sm:text-base text-slate-600">
                Chaque établissement dispose de ses propres postes. Vous déposez votre candidature dans <strong>un seul établissement</strong> : celui que vous sélectionnez ci-dessous.
            </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for etablissement in etablissements %}
                <article class="gsap-card-etablissement group flex flex-col overflow-hidden bg-white border border-slate-200 rounded-2xl shadow-sm transition-all duration-300 ease-out hover:-translate-y-2 hover:shadow-xl">
                    <header class="p-6 text-white" style="background: linear-gradient(135deg, #0A3D91 0%, #0052CC 100%);">
                        <div class="flex items-center justify-between gap-3 mb-3">
                            <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-white/15 backdrop-blur-sm group-hover:scale-110 transition-transform duration-300">
                                <i class="text-xl fas fa-university"></i>
                            </div>
                            <!-- Badge Localité bien mis en valeur -->
                           
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold leading-snug">{{ etablissement.nom }}</h3>
                        <p class="mt-2 text-xs sm:text-sm text-blue-100 font-medium flex items-center gap-1.5">
                            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-black tracking-wide uppercase shadow-md" style="background-color: #ffffff; color: #0A3D91 !important; border: 1px solid #ffffff;">
                                <i class="fas fa-map-marker-alt" style="color: #EE9137;"></i>
                                <span style="color: #0A3D91 !important; font-weight: 900;"> Lieu de formation: {{ etablissement.localite ? etablissement.localite.nom : (etablissement.id == 1 ? 'Yopougon' : 'Localité non définie') }}</span>
                            </span>
                        </p>
                    </header>

                    <div class="flex flex-col flex-1 p-6">
                        {% for em in etablissement.etablissementMetiers %}
                            <div class="{{ not loop.first ? 'mt-5 pt-5 border-t border-slate-100' : '' }}">
                                <p class="text-xs sm:text-sm font-bold tracking-wider uppercase text-slate-600">Métier proposé</p>
                                <p class="mt-1 text-base sm:text-lg font-extrabold text-slate-900 leading-snug">{{ em.metier.nom }}</p>

                                <dl class="grid grid-cols-2 gap-3 mt-4 text-sm">
                                    <div class="p-3 sm:p-3.5 rounded-xl bg-blue-50/80 border border-blue-100/70">
                                        <dt class="text-xs sm:text-sm font-semibold text-slate-600">Postes ouverts</dt>
                                        <dd class="text-xl sm:text-2xl font-black text-[#0052CC] mt-0.5">{{ em.nbrplace ?? '—' }}</dd>
                                    </div>
                                    <div class="p-3 sm:p-3.5 rounded-xl bg-slate-50 border border-slate-200/70">
                                        <dt class="text-xs sm:text-sm font-semibold text-slate-600">Durée formation</dt>
                                        <dd class="text-base sm:text-lg font-bold text-slate-800 mt-0.5">{{ em.dureeFormation ?: '—' }}</dd>
                                    </div>
                                </dl>

                                <div class="mt-4">
                                    {% set cible = path('app_candidature_new', {'etablissement': etablissement.id, 'metier': em.metier.id}) %}
                                    <a href="{{ app.user ? cible : path('app_register') ~ '?redirect=' ~ cible|url_encode }}"
                                       class="inline-flex items-center justify-center w-full gap-2 px-4 py-3.5 text-sm sm:text-base font-bold text-white transition-all shadow-md rounded-xl hover:opacity-95 active:scale-[0.99]"
                                       style="background-color: #EE9137; color: #ffffff; background-image: none;">
                                        <i class="fas fa-paper-plane text-white"></i>
                                        <span class="text-white">Candidater ici</span>
                                    </a>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-sm text-slate-500">Aucun métier ouvert pour le moment.</p>
                        {% endfor %}
                    </div>
                </article>
            {% else %}
                <div class="p-8 text-center bg-white border col-span-full border-slate-200 rounded-2xl text-slate-500">
                    Aucune structure de formation configurée pour le moment.
                </div>
            {% endfor %}
        </div>
    </div>
</section>
<!-- ==================== CONDITIONS D'ÉLIGIBILITÉ SECTION ==================== -->
<section id="eligibilite" class="py-14 sm:py-20 scroll-mt-24 bg-white border-t border-slate-200">
    <div class="container w-full max-w-5xl px-4 mx-auto">
        <div class="mb-10 text-center">
            <div class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-blue-900 mb-3 shadow-sm">
                <i class="mr-2 fas fa-user-check text-blue-700"></i>
                CRITÈRES D'ADMISSIBILITÉ
            </div>
            <h2 class="text-2xl font-extrabold sm:text-3xl md:text-4xl text-slate-900 tracking-tight">
                Conditions d'éligibilité
            </h2>
            <p class="max-w-2xl mx-auto mt-2 text-sm sm:text-base text-slate-600">
                Peut faire acte de candidature, toute personne remplissant obligatoirement les critères suivants :
            </p>
        </div>

        <!-- Critères d'admissibilité (Liste des conditions dans le même style) -->
        <div class="space-y-6">
            <!-- Grille des Critères Généraux 1 & 2 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- Critère 1 : Nationalité -->
                <div class="flex flex-col justify-between p-6 sm:p-7 bg-slate-50 border border-slate-200/90 rounded-2xl shadow-sm hover:shadow-md hover:border-slate-300 transition-all duration-200">
                    <div>
                        <div class="flex items-center justify-center w-12 h-12 bg-blue-100 text-[#0B1C76] rounded-xl mb-4">
                            <i class="fas fa-flag text-lg"></i>
                        </div>
                        <span class="text-xs sm:text-sm font-extrabold text-[#0B1C76] uppercase tracking-wider">Critère n°1</span>
                        <h3 class="font-bold text-lg sm:text-xl text-slate-900 mt-1.5 mb-2">Nationalité ivoirienne</h3>
                        <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
                            Être obligatoirement de nationalité ivoirienne (justifiée par une pièce d'identité officielle en cours de validité).
                        </p>
                    </div>
                </div>

                <!-- Critère 2 : Tranche d'âge -->
                <div class="flex flex-col justify-between p-6 sm:p-7 bg-slate-50 border border-slate-200/90 rounded-2xl shadow-sm hover:shadow-md hover:border-slate-300 transition-all duration-200">
                    <div>
                        <div class="flex items-center justify-center w-12 h-12 bg-amber-100 text-amber-800 rounded-xl mb-4">
                            <i class="fas fa-birthday-cake text-lg"></i>
                        </div>
                        <span class="text-xs sm:text-sm font-extrabold text-amber-800 uppercase tracking-wider">Critère n°2</span>
                        <h3 class="font-bold text-lg sm:text-xl text-slate-900 mt-1.5 mb-2">Tranche d'âge requise</h3>
                        <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
                            Être âgé(e) de <strong>18 à 35 ans inclus</strong> au 31 décembre 2026.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Critère 3 : Niveau scolaire et profil requis (Intégré comme critère à part entière, même style) -->
            <div id="niveau-scolaire" class="p-6 sm:p-8 bg-slate-50 border border-slate-200/90 rounded-2xl shadow-sm hover:shadow-md hover:border-slate-300 transition-all duration-200">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pb-5 border-b border-slate-200/80 mb-6">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center justify-center w-12 h-12 bg-teal-100 text-teal-700 rounded-xl flex-shrink-0">
                            <i class="fas fa-graduation-cap text-xl"></i>
                        </div>
                        <div>
                            <span class="text-xs sm:text-sm font-extrabold text-teal-600 uppercase tracking-wider">Critère n°3</span>
                            <h3 class="font-bold text-lg sm:text-xl md:text-2xl text-slate-900 mt-0.5">Niveau scolaire et profil requis</h3>
                        </div>
                    </div>
                </div>

                <p class="text-base sm:text-lg text-slate-700 mb-6 leading-relaxed font-normal">
