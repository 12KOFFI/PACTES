                            @click="nextSlide; $el.blur()" 
                            class="absolute -right-2 sm:-right-3 md:-right-4 top-1/2 transform -translate-y-1/2 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white shadow-md hover:shadow-xl border border-slate-200 text-slate-700 hover:text-slate-900 hover:bg-slate-50 hover:scale-105 active:scale-95 transition-all duration-200 flex items-center justify-center z-20 focus:outline-none focus:ring-2 focus:ring-amber-500"
