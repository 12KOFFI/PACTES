{# ===== MODAL : VÉRIFICATION STATUT ===== #}
{% if admissions_disponibles is defined and admissions_disponibles %}
<div id="statutModal"
     class="fixed inset-0 z-50 flex items-center justify-center hidden bg-black/60 backdrop-blur-sm"
     role="dialog" aria-modal="true">
    <div class="relative w-full max-w-md p-6 mx-4 bg-white shadow-2xl rounded-2xl sm:p-8">

        {# Icône #}
        <div class="flex items-center justify-center w-16 h-16 mx-auto mb-5 rounded-full bg-gradient-to-br from-green-100 to-emerald-100">
            <i class="text-3xl text-green-600 fas fa-award"></i>
        </div>

        {# Titre #}
        <h3 class="mb-3 text-xl font-bold text-center text-slate-800 sm:text-2xl">
            Résultats disponibles !
        </h3>

        {# Message #}
        <p class="mb-6 text-sm leading-relaxed text-center text-slate-600 sm:text-base">
            Les résultats d'admission <strong>définitive à la formation</strong> sont désormais disponibles.
            Vérifiez dès maintenant votre statut de candidature.
        </p>

        {# Actions #}
        <div class="flex flex-col gap-3">
            <a href="{{ path('app_verifier_statut') }}"
               class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white font-semibold rounded-xl hover:from-green-700 hover:to-emerald-700 transition transform hover:scale-[1.02] shadow-lg">
                <i class="fas fa-user-check"></i>
                Vérifier mon statut
            </a>
            <button type="button"
                    id="closeStatutModal"
                    class="w-full px-6 py-3 font-medium transition bg-slate-100 text-slate-600 rounded-xl hover:bg-slate-200">
                Plus tard
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('statutModal');
    const closeBtn = document.getElementById('closeStatutModal');

    if (!modal) return;

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    function closeModal() {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }

    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
            closeModal();
        }
    });
});
</script>
{% endif %}

{% endblock %}