<script>
// ==================== CARROUSEL PARTENAIRES ====================
(function() {
    const totalCount = {{ partenaires|length }};

    function initCarousel() {
        return {
            totalItems: totalCount,
            currentSlide: 0,
            slidesPerView: 3,
            autoplayInterval: null,
            _eventListenersAdded: false,

            init() {
                if (this.totalItems === 0) return;
                this.updateSlidesPerView();
                if (!this._eventListenersAdded) {
                    this._eventListenersAdded = true;
                    window.addEventListener('resize', () => this.updateSlidesPerView());
                }
                this.startAutoplay();
            },

            updateSlidesPerView() {
                const width = window.innerWidth;
                let newValue;
                if (width < 640) {
                    newValue = 1; // Mobile : 1 card bien aérée et centrée
                } else if (width < 1024) {
                    newValue = 2; // Tablette : 2 cards lisibles
                } else {
                    newValue = 3; // Desktop : 3 cards simultanément
                }
                this.slidesPerView = Math.max(1, Math.min(newValue, this.totalItems));
                if (this.currentSlide > this.maxSlide) {
                    this.currentSlide = this.maxSlide;
                }
            },

            get maxSlide() {
                if (this.totalItems === 0) return 0;
                return Math.max(0, this.totalItems - this.slidesPerView);
            },

            get dots() {
                return Array.from({ length: this.maxSlide + 1 }, (_, i) => i);
            },

            startAutoplay() {
                this.stopAutoplay();
                if (this.maxSlide > 0) {
                    this.autoplayInterval = setInterval(() => this.nextSlide(), 4500);
                }
            },

            stopAutoplay() {
                if (this.autoplayInterval) {
                    clearInterval(this.autoplayInterval);
                    this.autoplayInterval = null;
                }
            },

            nextSlide() {
                if (this.maxSlide <= 0) return;
                this.currentSlide = (this.currentSlide >= this.maxSlide) ? 0 : this.currentSlide + 1;
            },

            prevSlide() {
                if (this.maxSlide <= 0) return;
                this.currentSlide = (this.currentSlide <= 0) ? this.maxSlide : this.currentSlide - 1;
            },

            goToSlide(index) {
                this.currentSlide = Math.max(0, Math.min(index, this.maxSlide));
            }
        };
    }

    window.partenairesCarousel = initCarousel;
    document.addEventListener('alpine:init', function() {
        if (typeof Alpine !== 'undefined') {
            Alpine.data('partenairesCarousel', initCarousel);
        }
    });
})();
</script>

