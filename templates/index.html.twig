{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/gsap.min.js') }}"></script>
    <script src="{{ asset('js/ScrollTrigger.min.js') }}"></script>
    <!-- Lenis : défilement doux (même bibliothèque que pactecotedivoire.com) -->
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
    <script>
        (function() {
            function initAnimations() {
                if (typeof gsap === 'undefined') return;
                var hasST = typeof ScrollTrigger !== 'undefined';
                if (hasST) {
                    gsap.registerPlugin(ScrollTrigger);
                }

                // Respect du paramètre d'accessibilité prefers-reduced-motion : aucun mouvement, contenu visible.
                var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (prefersReducedMotion) {
                    return;
                }

                // 1. Défilement doux Lenis, synchronisé avec GSAP / ScrollTrigger
                if (typeof Lenis !== 'undefined') {
                    var lenis = new Lenis({
                        duration: 1.2,
                        easing: function(t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
                        smoothWheel: true
                    });
                    if (hasST) {
                        lenis.on('scroll', ScrollTrigger.update);
                    }
                    gsap.ticker.add(function(time) { lenis.raf(time * 1000); });
                    gsap.ticker.lagSmoothing(0);

                    // Ancres internes : défilement doux en tenant compte de l'en-tête fixe
                    document.querySelectorAll('a[href^="#"]').forEach(function(link) {
                        link.addEventListener('click', function(event) {
                            var hash = link.getAttribute('href');
                            if (!hash || hash.length < 2) return;
                            var target = document.querySelector(hash);
                            if (!target) return;
                            event.preventDefault();
                            var header = document.querySelector('.pa-header');
                            lenis.scrollTo(target, { offset: -((header ? header.offsetHeight : 0) + 8) });
                            if (history.pushState) history.pushState(null, '', hash);
                        });
                    });
                }

                // 2. Séquence d'entrée du Hero (on load)
                var heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });
                heroTl.from('.hero-title', { y: 32, opacity: 0, duration: 1 })
                      .from('.hero-date', { y: 20, opacity: 0, duration: 0.7 }, '-=0.6')
                      .from('.hero-cta-group', { y: 20, opacity: 0, duration: 0.7 }, '-=0.5')
                      .from('.stat-card', { y: 24, opacity: 0, stagger: 0.08, duration: 0.7, onComplete: initCounters }, '-=0.4')
                      .from('.hero-media', { y: 40, opacity: 0, scale: 0.96, duration: 1.2 }, 0.2);

                // 3. Compteurs de statistiques animés (Count-up)
                function initCounters() {
                    document.querySelectorAll('.stat-counter').forEach(function(counter) {
                        var target = parseInt(counter.getAttribute('data-target'), 10) || 0;
                        if (target > 0) {
                            var obj = { val: 0 };
                            gsap.to(obj, {
                                val: target,
                                duration: 1.8,
                                ease: 'power2.out',
                                onUpdate: function() { counter.textContent = Math.floor(obj.val); }
                            });
                        }
                    });
                }

                // 4. Flottement subtil des badges
                gsap.to('.gsap-float', { y: -8, duration: 3, repeat: -1, yoyo: true, ease: 'sine.inOut' });

                if (!hasST) return;

                // 5. Révélations au défilement, comme sur pactecotedivoire.com
                //    (montée + fondu, 1,3 s, courbe cubic-bezier(0.33, 1, 0.68, 1) ≈ power2.out)
                var items = gsap.utils.toArray('[data-reveal]');
                gsap.set(items, { y: 32, opacity: 0 });
                ScrollTrigger.batch(items, {
                    start: 'top 88%',
                    once: true,
                    onEnter: function(batch) {
                        gsap.to(batch, { y: 0, opacity: 1, duration: 1.3, ease: 'power2.out', stagger: 0.08, overwrite: true, clearProps: 'transform' });
                    }
                });

                // 6. Titres : dévoilement par masque (clip-path)
                gsap.utils.toArray('[data-reveal-title]').forEach(function(title) {
                    gsap.fromTo(title,
                        { clipPath: 'inset(0 0 100% 0)', y: 24 },
                        { clipPath: 'inset(0 0 0% 0)', y: 0, duration: 1.3, ease: 'power2.out', clearProps: 'clipPath,transform',
                          scrollTrigger: { trigger: title, start: 'top 88%', once: true } }
                    );
                });

                // 7. Chronogramme (défilement progressif de la timeline)
                gsap.from('.gsap-timeline-item', {
                    scrollTrigger: { trigger: '#calendrier', start: 'top 80%', once: true },
                    x: 25,
                    opacity: 0,
                    stagger: 0.14,
                    duration: 0.9,
                    ease: 'power2.out'
                });

                // Recalcule les positions des déclencheurs une fois images/polices chargées
                window.addEventListener('load', function() { ScrollTrigger.refresh(); });
            }

            // Fallback CDN si GSAP local indisponible
            if (typeof gsap === 'undefined') {
                var s1 = document.createElement('script');
                s1.src = 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js';
                s1.onload = function() {
                    var s2 = document.createElement('script');
                    s2.src = 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js';
                    s2.onload = initAnimations;
                    document.head.appendChild(s2);
                };
                document.head.appendChild(s1);
            } else if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initAnimations);
            } else {
                initAnimations();
            }
        })();
    </script>
{% endblock %}
