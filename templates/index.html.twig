                    </button>
                </div>

                <!-- Indicateurs de slide (dots) -->
                <div x-show="maxSlide > 0" class="flex justify-center items-center mt-6 sm:mt-8 space-x-2.5">
                    <template x-for="dotIndex in dots" :key="dotIndex">
