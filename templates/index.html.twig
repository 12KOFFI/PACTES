{% extends 'base.html.twig' %}

{% block title %}PACTE - Recrutement 2026{% endblock %}

{% block meta %}
{{ parent() }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
<meta name="keywords" content="PACTE, solaire, photovoltaique, electricite, recrutement, apprentissage, CQP, 2026, Cote d'Ivoire">
<meta name="description" content="Projet PACTE - Recrutement de jeunes pour la formation par apprentissage au métier d'installateur de systèmes solaires photovoltaïques au titre de l'année 2026.">
{% endblock %}

{% block body %}
<div class="pa-page">

<!-- ==================== HERO ==================== -->
<section class="pa-hero hero">
    <div class="pa-hero__inner">
        <div class="pa-hero__text">
            <h1 class="pa-hero__title hero-title">
                Recrutement de 250 jeunes
                <span>pour la formation au métier d’installateur de systèmes solaires photovoltaïques.</span>
            </h1>

            <!-- Période de dépôt des dossiers -->
            <div class="pa-date hero-date">
                <span class="pa-date__cal" aria-hidden="true">
                    <span class="pa-date__month">NOV</span>
                    <span class="pa-date__day">22</span>
                </span>
                <span class="pa-date__text">
                    <span class="pa-date__label">Dépôt des dossiers</span>
                    <strong class="pa-date__value">du 13 au 22 novembre 2026</strong>
                </span>
            </div>

            <!-- Actions principales (Hero CTA) -->
            <div class="hero-cta-group flex flex-col sm:flex-row items-center gap-3 sm:gap-4">
                <a href="#etablissements" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-bold text-sm text-white shadow-lg transition-all duration-300 hover:opacity-90 hover:-translate-y-0.5 active:scale-95" style="background-color: #EE9137;">
                    <i class="fas fa-paper-plane"></i>
                    <span>Choisir un établissement & Postuler</span>
                </a>
                <a href="#presentation" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-bold text-sm text-white bg-white/10 hover:bg-white/20 border border-white/25 backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5 active:scale-95">
                    <i class="fas fa-info-circle"></i>
                    <span>Conditions et déroulement</span>
                </a>
            </div>

            <!-- Stats rapides avec compteurs dynamiques GSAP -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-5 max-w-3xl text-center">
                <div class="stat-card p-3 sm:p-4 border bg-white/10 backdrop-blur-md rounded-2xl border-white/20 transition-transform hover:-translate-y-1 shadow-sm">
                    <div class="text-xl sm:text-3xl font-extrabold text-white">
                        <span class="stat-counter" data-target="{{ stats.metiers }}">{{ stats.metiers }}</span>
                    </div>
                    <div class="text-xs sm:text-sm font-medium text-blue-100 mt-1">Métier(s)</div>
                </div>
                <div class="stat-card p-3 sm:p-4 border bg-white/10 backdrop-blur-md rounded-2xl border-white/20 transition-transform hover:-translate-y-1 shadow-sm">
                    <div class="text-xl sm:text-3xl font-extrabold text-white">
                        <span class="stat-counter" data-target="{{ stats.etablissements }}">{{ stats.etablissements }}</span>
                    </div>
                    <div class="text-xs sm:text-sm font-medium text-blue-100 mt-1">Établissements</div>
                </div>
                <div class="stat-card p-3 sm:p-4 border bg-white/10 backdrop-blur-md rounded-2xl border-white/20 transition-transform hover:-translate-y-1 shadow-sm">
                    <div class="text-xl sm:text-3xl font-extrabold text-white">
                        <span class="stat-counter" data-target="{{ stats.places }}">{{ stats.places }}</span>
                    </div>
                    <div class="text-xs sm:text-sm font-medium text-blue-100 mt-1">Postes ouverts</div>
                </div>
                <div class="stat-card p-3 sm:p-4 border bg-white/10 backdrop-blur-md rounded-2xl border-white/20 transition-transform hover:-translate-y-1 shadow-sm">
                    <div class="text-xl sm:text-3xl font-extrabold text-white">
                        <span class="stat-counter" data-target="{{ stats.candidatures }}">{{ stats.candidatures }}</span>
                    </div>
                    <div class="text-xs sm:text-sm font-medium text-blue-100 mt-1">Candidatures</div>
                </div>
            </div>
        </div>

        <!-- Illustration dans son cadre blanc -->
        <div class="pa-hero__media hero-media">
            <figure class="pa-hero__figure">
                <span class="pa-hero__plate" aria-hidden="true"></span>
                <div class="pa-hero__frame">
                    <picture>
                        <source srcset="{{ asset('image/recrutement_solaire_cqp.webp') }}" type="image/webp">
                        <img src="{{ asset('image/recrutement_solaire_cqp.png') }}" alt="Deux techniciens en équipement de sécurité devant des panneaux solaires" width="1155" height="1400">
                    </picture>
                </div>
                <figcaption class="pa-hero__badge gsap-float">
                    <span class="pa-hero__badge-icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C2620F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M8.5 14 7 22l5-3 5 3-1.5-8"/></svg>
                    </span>
                    <span class="pa-hero__badge-text">
                        <strong>Diplôme CQP</strong>
                        <span>6 mois en apprentissage</span>
                    </span>
                </figcaption>
            </figure>
        </div>
    </div>
</section>

<!-- ==================== PRÉSENTATION + PROMOTION DU GENRE ==================== -->
<section id="presentation" class="pa-section scroll-mt-24" style="background: #FFFFFF;">
    <div class="pa-container pa-pres">
        <div class="pa-pres__text">
            <h2 class="pa-pres__title" data-reveal-title>Formation au métier d'installateur de systèmes solaires photovoltaïques</h2>
            <p class="pa-pres__p1" data-reveal>
                Il est ouvert, au titre de l'année 2026, un recrutement de <strong class="pa-blue">deux cent cinquante (250) jeunes</strong>
                pour la formation au métier d'<strong>installateur de systèmes solaires photovoltaïques</strong>.
            </p>
            <p class="pa-pres__p2" data-reveal>
                La formation, dispensée selon la modalité de l’<strong>Apprentissage</strong>, durera <strong>six (06) mois</strong> et sera sanctionnée d’un <strong>Certificat de Qualification Professionnelle (CQP)</strong>.
                Les formations théoriques se dérouleront au sein des lycées professionnels partenaires et les formations pratiques en immersion directe dans les entreprises partenaires.
            </p>

            <dl class="pa-facts" data-reveal>
                <div class="pa-fact pa-fact--blue">
                    <dt><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0052CC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>en Apprentissage</dt>
                    <dd>06 mois</dd>
                </div>
                <div class="pa-fact pa-fact--sky">
                    <dt><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FE6800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M8.5 14 7 22l5-3 5 3-1.5-8"/></svg>Reconnu par l'État</dt>
                    <dd>Diplôme CQP</dd>
                </div>
                <div class="pa-fact pa-fact--green">
                    <dt><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3F8F1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="m8.5 12.3 2.4 2.4 4.6-5"/></svg>Formation prise en charge</dt>
                    <dd>100 % sponsorisée</dd>
                </div>
            </dl>

            <a href="#eligibilite" class="pa-link-arrow" data-reveal>
                Consulter les conditions d'éligibilité
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
        </div>

        <!-- Promotion du genre & inclusion -->
        <aside class="pa-genre" aria-labelledby="genre-titre" data-reveal>
            <div class="pa-genre__band">
                <svg aria-hidden="true" viewBox="0 0 480 104" preserveAspectRatio="none"><path d="M0 82 C 120 62, 360 62, 480 82 L480 104 L0 104 Z" fill="#FFFFFF"/></svg>
                <picture>
                    <source srcset="{{ asset('image/promotion_femmes_solaire.webp') }}" type="image/webp">
                    <img src="{{ asset('image/promotion_femmes_solaire.png') }}" class="pa-genre__photo" alt="Femmes techniciennes inspectant un panneau solaire" width="168" height="168" loading="lazy">
                </picture>
            </div>
            <div class="pa-genre__body">
                <h3 id="genre-titre" class="pa-genre__title">Les femmes aussi ont toute leur place dans l’énergie solaire !</h3>
                <div class="pa-genre__goal">
                    <p>
                        <span><strong>Notre ambition :</strong> au moins</span>
                        <span class="pa-genre__pct">40 %</span>
                        <span>de femmes parmi les participants.</span>
                    </p>
                </div>
                <p class="pa-genre__cheer">
                    <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FE6800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7.5-4.6-9.2-9.4C1.7 8.3 3.8 5 7.2 5c2 0 3.6 1.1 4.8 2.8C13.2 6.1 14.8 5 16.8 5c3.4 0 5.5 3.3 4.4 6.6C19.5 16.4 12 21 12 21z"/></svg>
                    <span>Les candidatures féminines sont vivement encouragées !</span>
                </p>
            </div>
        </aside>
    </div>
</section>

<!-- ==================== ÉTABLISSEMENTS : UNE CARTE PAR ÉTABLISSEMENT ==================== -->
<section id="etablissements" class="pa-section pa-section--tint scroll-mt-24">
    <div class="pa-container">
        <div class="pa-head">
            <div>
                <p class="pa-eyebrow">Structures de formation</p>
                <h2 class="pa-h2" data-reveal-title>Choisissez votre établissement</h2>
            </div>
            <div style="max-width: 500px;" data-reveal>
                <p class="pa-lead">Chaque établissement dispose de ses propres postes. Comparez les {{ stats.etablissements }} lieux de formation, puis candidatez dans celui qui vous convient.</p>
                <p class="pa-notice">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0052CC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.6v.4"/></svg>
                    <span>Une candidature dans <strong>un seul établissement</strong> par personne.</span>
                </p>
            </div>
        </div>

        <div class="pa-etabs">
            {% for etablissement in etablissements %}
                {% set locNom = etablissement.localite ? etablissement.localite.nom : (etablissement.id == 1 ? 'Yopougon' : null) %}
                <article class="pa-etab" data-reveal>
                    <header class="pa-etab__head">
                        <div class="pa-etab__top">
                            <span class="pa-etab__icon" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 4l9 5.5M5 10v8M9.7 10v8M14.3 10v8M19 10v8M3 20.5h18"/></svg>
                            </span>
                            {% if locNom %}
                                <span class="pa-etab__place">
                                    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="#EE9137"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                                    <span class="sr-only">Lieu de formation : </span>{{ locNom }}
                                </span>
                            {% endif %}
                        </div>
                        <div class="pa-etab__name">
                            <p>Établissement</p>
                            <h3>{{ etablissement.nom }}</h3>
                        </div>
                    </header>

                    <div class="pa-etab__body">
                        {% for em in etablissement.etablissementMetiers %}
                            {% set duree = em.dureeFormation ?: '—' %}
                            {% set dureeParts = duree|split(' ', 2) %}
                            <div class="pa-etab__offer">
                                <div class="pa-metier">
                                    <span class="pa-metier__icon" aria-hidden="true">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0A3D91" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 5h15l2 9h-19z"/><path d="M9.5 5 9 14M14.5 5l.5 9M3.4 9.5h17.2M12 14v4M8 20h8"/></svg>
                                    </span>
                                    <div class="pa-metier__text">
                                        <p class="pa-metier__label">Métier proposé</p>
                                        <p class="pa-metier__name">{{ em.metier.nom }}</p>
                                    </div>
                                </div>

                                <dl class="pa-kpis">
                                    <div class="pa-kpi pa-kpi--blue">
                                        <dt><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0052CC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 19.5c.8-3.2 3.1-5 6-5s5.2 1.8 6 5M15.5 5.2a3.2 3.2 0 0 1 0 5.6M17.5 14.8c1.8.7 3 2.3 3.5 4.7"/></svg>Postes ouverts</dt>
                                        <dd>{{ em.nbrplace ?? '—' }}</dd>
                                    </div>
                                    <div class="pa-kpi pa-kpi--green">
                                        <dt><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C2620F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>De formation</dt>
                                        <dd>{{ dureeParts[0] }}{% if dureeParts|length > 1 %} <small>{{ dureeParts[1] }}</small>{% endif %}</dd>
                                    </div>
                                </dl>

                                {% set cible = path('app_candidature_new', {'etablissement': etablissement.id, 'metier': em.metier.id}) %}
                                <a href="{{ app.user ? cible : path('app_register') ~ '?redirect=' ~ cible|url_encode }}" class="pa-etab__cta">
                                    <span>Candidater ici</span>
                                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                                </a>
                            </div>
                        {% else %}
                            <p style="margin: 0; color: #475569;">Aucun métier ouvert pour le moment.</p>
                        {% endfor %}
                    </div>
                </article>
            {% else %}
                <p class="pa-empty">Aucune structure de formation configurée pour le moment.</p>
            {% endfor %}
        </div>
    </div>
</section>

<!-- ==================== CONDITIONS D'ÉLIGIBILITÉ ==================== -->
<section id="eligibilite" class="pa-section pa-section--white scroll-mt-24">
    <div class="pa-container pa-el">
        <div class="pa-head">
            <h2 class="pa-h2" data-reveal-title>Conditions d'éligibilité</h2>
            <p class="pa-lead" data-reveal>Peut faire acte de candidature, toute personne remplissant obligatoirement les critères suivants :</p>
        </div>

        <!-- Critères 1 ET 2 -->
        <div class="pa-el-row">
            <article class="pa-crit" data-reveal>
                <div class="pa-crit__top">
                    <span class="pa-num" aria-hidden="true">1</span>
                    <svg aria-hidden="true" width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="#0052CC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="12" width="44" height="32" rx="5"/><circle cx="19" cy="26" r="5"/><path d="M11 38c1.6-4 4.4-6 8-6s6.4 2 8 6M32 23h12M32 29h12M32 35h7"/></svg>
                </div>
                <h3><span class="sr-only">Critère n°1 : </span>Nationalité ivoirienne</h3>
                <p>Être obligatoirement de nationalité ivoirienne (justifiée par une pièce d'identité officielle en cours de validité).</p>
            </article>

            <div class="pa-and" aria-hidden="true"><span>ET</span></div>

            <article class="pa-crit" data-reveal>
                <div class="pa-crit__top">
                    <span class="pa-num" aria-hidden="true">2</span>
                    <p class="pa-crit__age" aria-hidden="true">18–35 <small>ans</small></p>
                </div>
                <h3><span class="sr-only">Critère n°2 : </span>Tranche d'âge requise</h3>
                <p>Être âgé(e) de <strong>18 à 35 ans inclus</strong> au 31 décembre 2026.</p>
                <figure class="pa-years">
                    <div class="pa-years__track" aria-hidden="true"><span></span></div>
                    <div class="pa-years__ends" aria-hidden="true"><span>1991</span><span>2008</span></div>
                    <figcaption>Soit une naissance entre le 1<sup>er</sup> janvier 1991 et le 31 décembre 2008.</figcaption>
                </figure>
            </article>
        </div>

        <div class="pa-and pa-and--h" aria-hidden="true"><span>ET</span></div>

        <!-- Critère 3 : l'une des trois voies -->
        <article id="niveau-scolaire" class="pa-crit3" data-reveal>
            <div class="pa-crit3__head">
                <span class="pa-num" aria-hidden="true">3</span>
                <div>
                    <h3><span class="sr-only">Critère n°3 : </span>Niveau scolaire et profil requis</h3>
                    <p>Pour faire acte de candidature, vous devez justifier de <strong>l’une des trois (03) conditions</strong> de profil scolaire ou professionnel suivantes :</p>
                </div>
            </div>

            <!-- Voie 1 -->
            <div class="pa-voie pa-voie--1">
                <div class="pa-voie__intro">
                    <h4><span>Voie 1</span> · Titulaire d'un diplôme requis</h4>
                    <p>Être titulaire de l'un des diplômes homologués ci-dessous :</p>
                </div>
                <div class="pa-diplomes">
                    <div class="pa-diplome">
                        <div class="pa-diplome__head"><p>CAP</p><p>2 spécialités</p></div>
                        <ul class="pa-checklist">
                            <li>Électricité d’Équipement</li>
                            <li>Électricité Bâtiment</li>
                        </ul>
                    </div>
                    <div class="pa-diplome">
                        <div class="pa-diplome__head"><p>BT</p><p>4 spécialités</p></div>
                        <ul class="pa-checklist">
                            <li>Électrotechnique</li>
                            <li>Électromécanique</li>
                            <li>Électronique</li>
                            <li>Maintenance des Équipements Électriques et Électroniques (MEEE)</li>
                        </ul>
                    </div>
                    <div class="pa-diplome">
                        <div class="pa-diplome__head"><p>BTS</p><p>4 spécialités</p></div>
                        <ul class="pa-checklist">
                            <li>Électrotechnique</li>
                            <li>Génie Énergétique et Environnement (GEE)</li>
                            <li>Maintenance des Systèmes de Production (MSP)</li>
                            <li>Systèmes Électroniques et Informatiques (SEI)</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="pa-or pa-or--h" aria-hidden="true"><span>OU</span></div>

            <!-- Voies 2 OU 3 -->
            <div class="pa-el-row">
                <div class="pa-voie">
                    <h4><span>Voie 2</span> · Parcours de formation sans diplôme obtenu</h4>
                    <p>Avoir suivi un parcours de formation de niveau <strong>CAP, BT ou BTS en Génie Électrique</strong>, sans avoir obtenu le diplôme correspondant et le <strong>justifier par la présentation des relevés de notes délivrés par l’établissement de formation</strong>.</p>
                </div>
                <div class="pa-or" aria-hidden="true"><span>OU</span></div>
                <div class="pa-voie">
                    <h4><span>Voie 3</span> · Compétences professionnelles (VAE)</h4>
                    <p>Justifier de compétences professionnelles dans les domaines concernés, attestées par une <strong>Validation des Acquis de l’Expérience (VAE)</strong> ou par tout autre document justifiant des compétences acquises dans l’exercice d’une activité professionnelle.</p>
                </div>
            </div>
        </article>
    </div>
</section>

<!-- ==================== PIÈCES À FOURNIR ==================== -->
<section id="pieces" class="pa-section pa-section--tint scroll-mt-24">
    <div class="pa-container pa-pieces">
        <div class="pa-pieces__intro" data-reveal>
            <h2 class="pa-h2">Les trois (03) pièces demandées</h2>
            <p class="pa-lead">Le dossier de candidature en ligne devra comporter impérativement les pièces suivantes :</p>
            <dl class="pa-pieces__facts">
                <div><dt>Formats acceptés</dt><dd>JPG, PNG ou PDF</dd></div>
                <div><dt>Taille maximale</dt><dd class="pa-tabular">5 Mo par fichier</dd></div>
                <div><dt>Pièces obligatoires</dt><dd>Les trois</dd></div>
            </dl>
        </div>

        <ol class="pa-pieces__list">
            <li class="pa-piece" data-reveal>
                <div class="pa-piece__sheet" aria-hidden="true">
                    <span class="pa-piece__num">1</span>
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#0A3D91" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><circle cx="8.5" cy="11" r="2.2"/><path d="M5 16c.7-1.6 2-2.4 3.5-2.4S11.3 14.4 12 16M14.5 10h4.5M14.5 13.5h3"/></svg>
                </div>
                <div class="pa-piece__text">
                    <h3><span class="sr-only">Pièce n°1 : </span>Pièce d'identité</h3>
                    <p>Une copie de la Carte Nationale d’Identité (CNI) ou l’attestation d’identité ou le passeport.</p>
                </div>
            </li>
            <li class="pa-piece" data-reveal>
                <div class="pa-piece__sheet" aria-hidden="true">
                    <span class="pa-piece__num">2</span>
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#0A3D91" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 2 9l10 5 10-5z"/><path d="M6 11v4.5c1.7 1.5 3.7 2.2 6 2.2s4.3-.7 6-2.2V11M22 9v5"/></svg>
                </div>
                <div class="pa-piece__text">
                    <h3><span class="sr-only">Pièce n°2 : </span>Justificatif de niveau / compétence</h3>
                    <p>Une copie du diplôme requis, de l’attestation de réussite, du relevé de notes ou tout autre document prouvant l’exercice d’une activité professionnelle liée au métier.</p>
                </div>
            </li>
            <li class="pa-piece" data-reveal>
                <div class="pa-piece__sheet" aria-hidden="true">
                    <span class="pa-piece__num">3</span>
