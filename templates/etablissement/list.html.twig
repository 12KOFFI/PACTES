{% extends 'base.html.twig' %}

{% block title %}Tous les établissements | PACTE{% endblock %}

{% block body %}
<section class="min-h-screen py-12 bg-gradient-to-br from-indigo-700 via-purple-700 to-blue-700 sm:py-20">
    <div class="container w-full max-w-full px-4 mx-auto">
        {#<a href="{{ path('app_home') }}" class="inline-flex items-center text-sm transition text-white/70 hover:text-white">#}
               {# <i class="mr-2 fas fa-arrow-left"></i> Retour à l'accueil#}
        {#</a>#}
        {# En-tête #}
        <div class="mb-8 text-center sm:mb-12">
            
            <div class="inline-flex items-center rounded-full border border-white bg-white px-3 sm:px-4 py-1.5 text-xs sm:text-sm font-semibold text-purple-500 mb-4 shadow-lg">
                <i class="mr-2 fas fa-building"></i>
                ÉTABLISSEMENTS DE FORMATION
            </div>
            <h1 class="mb-4 text-2xl font-bold text-white sm:text-3xl md:text-4xl">
                {{ total }} établissements disponibles
            </h1>
        </div>

        {# Filtres #}
        <div class="max-w-4xl px-2 mx-auto mb-8">
            <div class="flex flex-col gap-3 sm:flex-row sm:gap-4">
                <div class="flex-1">
                    <div class="relative">
                        <i class="absolute transform -translate-y-1/2 fas fa-search left-3 top-1/2 text-slate-400"></i>
                        <input type="text" 
                               id="recherche-input"
                               placeholder="Rechercher un établissement..." 
                               value="{{ recherche }}"
                               class="w-full py-2 pl-10 pr-4 text-sm text-white border rounded-lg sm:py-3 border-white/30 bg-white/10 backdrop-blur-sm placeholder-white/70 sm:text-base focus:outline-none focus:ring-2 focus:ring-white">
                    </div>
                </div>
                <div class="sm:w-64">
                    <select id="localite-filter" class="w-full px-4 py-2 text-sm text-white border rounded-lg sm:py-3 border-white/30 bg-white/10 backdrop-blur-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-white">
                        <option value="">Toutes les localités</option>
                        {% for localite in localites %}
                            <option value="{{ localite.id }}" {{ localiteSelectionnee == localite.id ? 'selected' : '' }}>
                                {{ localite.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>

        {# Grille #}
        <div id="etablissements-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6">
            {% include 'partials/_etablissements_cards.html.twig' with {'etablissements': etablissements} %}
        </div>

        {# Chargement #}
        <div id="loading" class="hidden py-8 text-center">
            <div class="inline-block w-8 h-8 border-4 rounded-full border-white/30 border-t-white animate-spin"></div>
        </div>

    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const recherche = document.getElementById('recherche-input');
    const localite = document.getElementById('localite-filter');
    
    function recharger() {
        const url = new URL(window.location.href);
        url.searchParams.set('page', '1');
        url.searchParams.set('recherche', recherche.value);
        url.searchParams.set('localite', localite.value);
        window.location.href = url.toString();
    }
    
    let timer;
    recherche.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(recharger, 500);
    });
    
    localite.addEventListener('change', recharger);
});
</script>
{% endblock %}