<!DOCTYPE html>
<html lang='fr'>
<head>
    <meta charset='UTF-8'>
    <title>PACTE - FICHE D'INSCRIPTION CANDIDAT PROJET PACTE</title>
    <style>
        @page {
            size: A4 portrait;
            /* Marge à 0 : le générateur PDF ignore/écrase la marge @page.
               Les marges réelles de la feuille sont donc créées par le padding du body. */
            margin: 0;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            /* Marges A4 standard : 2 cm (56.7pt) haut / gauche / droite,
               marge basse agrandie pour laisser la place au pied de page. */
            padding: 56.7pt 56.7pt 100pt 56.7pt;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-size: 11.2pt;
            color: #000000;
            line-height: 1.4;
            background: #ffffff;
        }

        /* ===== En-tête ===== */
        .header-section {
            text-align: center;
            margin-bottom: 8pt;
        }
        .header-section img {
            width: 100%;
            max-width: 550pt;
            height: auto;
            max-height: 52pt;
            display: block;
            margin: 0 auto;
        }

        .title-box {
            border: 0.75pt solid #000000;
            border-radius: 5pt;
            height: 27pt;
            line-height: 27pt;
            text-align: center;
            font-weight: bold;
            font-size: 13.5pt;
            letter-spacing: 0.3pt;
            text-transform: uppercase;
            color: #000000;
            background: #ffffff;
            margin-bottom: 22pt;
        }

        /* ===== Sections ===== */
        .section-block {
            margin-bottom: 18pt;
            position: relative;
        }
        .section-title {
            font-weight: bold;
            color: #0055a4;
            font-size: 11.7pt;
            text-transform: uppercase;
            margin-bottom: 8pt;
            letter-spacing: 0.2pt;
        }
        .section-content {
            margin-left: 11.25pt;
        }

        /* ===== Tableau Clé / Valeur ===== */
        .info-table {
            width: 100%;
            border-collapse: collapse;
        }
        .info-table td {
            padding: 3.5pt 0;
            vertical-align: middle;
        }
        .info-table td.lbl {
            width: 114.75pt;
            font-size: 9.8pt;
            font-weight: bold;
            color: #444444;
            white-space: nowrap;
        }
        .info-table td.val {
            font-size: 11.2pt;
            color: #000000;
        }
        .info-table td.val-bold {
            font-size: 11.2pt;
            font-weight: bold;
            color: #000000;
        }

        /* ===== QR Code encadré ===== */
        .qr-code-box {
            position: absolute;
            top: 0;
            right: 0;
            text-align: center;
            width: 60pt;
        }
        .qr-card {
            border: 0.75pt solid #dddddd;
            background: #ffffff;
            padding: 3pt;
            width: 53pt;
            height: 53pt;
            margin: 0 auto;
        }
        .qr-card img {
            width: 47pt;
            height: 47pt;
            display: block;
            margin: 0 auto;
        }
        .qr-label {
            font-size: 5.5pt;
            color: #666666;
            margin-top: 3pt;
            text-align: center;
            white-space: nowrap;
        }

        /* ===== Pied de page ===== */
        .footer-wrap {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 28pt;
            text-align: center;
        }
        .footer-logo {
            display: block;
            width: auto;
            max-width: 110pt;
            max-height: 28pt;
            margin: 0 auto 5pt auto;
        }
        .footer-text {
            color: #000000;
            font-size: 8.2pt;
            line-height: 1.35;
        }
    </style>
</head>
<body>

    <!-- En-tête officiel -->
    <div class="header-section">
        {% if image.entete %}
            <img src='{{ image.entete }}' alt='En-tête'>
        {% else %}
            <div style='text-align:center;font-size:20pt;font-weight:bold;'>PACTE</div>
        {% endif %}
    </div>

    <!-- Boîte Titre -->
    <div class="title-box">FICHE D'INSCRIPTION CANDIDAT PROJET PACTE</div>

    {% set user = candidature.user %}
    {% set etablissement = candidature.etablissement %}
    {% set localite = etablissement ? etablissement.localite : null %}
    {% set metier = candidature.metier %}
    {% set etablissementMetier = (etablissement and metier) ? etablissement.etablissementMetiers|filter(em => em.metier and em.metier.id == metier.id)|first : null %}

    <!-- 1. CANDIDAT -->
    <div class="section-block">
        <div class="section-title">1. CANDIDAT</div>

        <div class="qr-code-box">
            <div class="qr-card">
                <img src='https://api.qrserver.com/v1/create-qr-code/?size=70x70&data={{ candidature.numero }}' alt='QR Code'>
            </div>
            <div class="qr-label">Scan pour vérifier</div>
        </div>

        <div class="section-content" style="padding-right: 70pt;">
            <table class="info-table">
                <tr>
                    <td class="lbl">Numéro :</td>
                    <td class="val-bold">{{ candidature.numero }}</td>
                </tr>
                <tr>
                    <td class="lbl">Nom & Prénoms :</td>
                    <td class="val-bold">
                        {% set civilite = (user and user.sexe == 'FEMININ') ? 'Mme' : 'M.' %}
                        {{ civilite }} {{ user ? user.nom|upper : '' }} {{ user ? user.prenoms|title : '' }}
                        {% if user and user.nomjeunefille %}
                            <span style="font-weight: normal; color: #444444;"> (née {{ user.nomjeunefille|upper }})</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td class="lbl">Né(e) le :</td>
                    <td class="val">{{ user and user.datenaissance ? user.datenaissance|date('d/m/Y') : '-' }} à {{ user and user.lieunaissance ? user.lieunaissance|upper : '-' }}</td>
                </tr>
                <tr>
                    <td class="lbl">Contact :</td>
                    <td class="val">{{ user ? user.contact : '-' }}</td>
                </tr>
                <tr>
                    <td class="lbl">Date d'inscription :</td>
                    <td class="val">{{ candidature.creation|date('d/m/Y à H:i', 'Africa/Abidjan') }}</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- 2. CENTRE DE FORMATION -->
    <div class="section-block">
        <div class="section-title">2. CENTRE DE FORMATION</div>
        <div class="section-content">
            <table class="info-table">
                <tr>
                    <td class="lbl">Établissement :</td>
                    <td class="val-bold">{{ etablissement ? etablissement.nom : '-' }}</td>
                </tr>
                <tr>
                    <td class="lbl">Localité :</td>
                    <td class="val">
                        {% if localite %}
                            {{ localite.nom|title }}{% if localite.parent %} - DR {{ localite.parent.nom|upper }}{% endif %}
                        {% elseif etablissement and etablissement.definition %}
                            {{ etablissement.definition }}
                        {% elseif etablissement and etablissement.id == 1 %}
                            Abidjan
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <!-- 3. MÉTIER ET FORMATION -->
    <div class="section-block">
        <div class="section-title">3. MÉTIER ET FORMATION</div>
        <div class="section-content">
            <table class="info-table">
                <tr>
                    <td class="lbl">Métier :</td>
                    <td class="val-bold">{{ metier ? metier.nom : '-' }}</td>
                </tr>
                <tr>
                    <td class="lbl">Diplôme :</td>
                    <td class="val-bold">{{ candidature.diplome ?: '-' }}</td>
                </tr>
                <tr>
                    <td class="lbl">Secteur :</td>
                    <td class="val">Énergie Renouvelable</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- Pied de page officiel avec Logo PACTE -->
    <div class="footer-wrap">
        {% if image.logo is defined and image.logo %}
            <img src="{{ image.logo }}" alt="Logo PACTE" class="footer-logo">
        {% endif %}
        <div class="footer-text">
            <div>Généré le {{ now|default("now")|date('d/m/Y à H:i', 'Africa/Abidjan') }}</div>
            <div>© {{ "now"|date('Y') }} METFPA/DAIP</div>
        </div>
    </div>

</body>
</html>