{% extends 'base.html.twig' %}

{% block title %}Candidature soumise avec succès | PACTE{% endblock %}

{% block body %}
<div class="min-h-screen py-12 bg-gray-50">
    <div class="max-w-3xl px-4 mx-auto">
        <!-- Message de succès -->
        <div class="mb-6 overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
            <div class="px-6 py-8 text-center bg-gradient-to-r from-green-500 to-emerald-600">
                <div class="flex items-center justify-center w-20 h-20 mx-auto mb-4 rounded-full bg-white/20">
                    <i class="text-4xl text-white fas fa-check-circle"></i>
                </div>
                <h1 class="mb-2 text-3xl font-bold text-white">Félicitations !</h1>
                <p class="text-lg text-white/90">Votre candidature a été enregistrée avec succès</p>
            </div>
            
            <div class="p-8">
                <!-- Numéro de candidature -->
                <div class="mb-8 text-center">
                    <p class="mb-2 text-sm text-slate-500">Votre numéro d'inscription</p>
                    <div class="inline-block px-6 py-3 border border-indigo-200 rounded-lg bg-indigo-50">
                        <span class="font-mono text-2xl font-bold text-indigo-700">{{ candidature.numero }}</span>
                    </div>
                    <p class="mt-2 text-xs text-slate-500">Conservez précieusement ce numéro</p>
                </div>
                
                <!-- Actions -->
                <div class="grid grid-cols-1 gap-4 mb-8 md:grid-cols-2">
                    <a href="{{ path('app_candidature_imprimer', {'id': candidature.id}) }}"
                       target="_blank"
                       class="flex items-center justify-center gap-3 p-4 transition border border-indigo-200 bg-indigo-50 rounded-xl hover:bg-indigo-100 group">
                        <div class="flex items-center justify-center w-10 h-10 bg-indigo-100 rounded-full group-hover:bg-indigo-200">
                            <i class="text-indigo-600 fas fa-file-pdf"></i>
                        </div>
                        <div class="text-left">
                            <p class="font-semibold text-indigo-700">Télécharger ma fiche</p>
                            <p class="text-xs text-indigo-500">Fiche d'inscription PDF</p>
                        </div>
                    </a>
                    
                    <a href="{{ path('app_candidature_index') }}" 
                       class="flex items-center justify-center gap-3 p-4 transition border bg-slate-50 rounded-xl border-slate-200 hover:bg-slate-100 group">
                        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 group-hover:bg-slate-200">
                            <i class="fas fa-list text-slate-600"></i>
                        </div>
                        <div class="text-left">
                            <p class="font-semibold text-slate-700">Mes candidatures</p>
                            <p class="text-xs text-slate-500">Voir toutes mes candidatures</p>
                        </div>
                    </a>
                </div>
                
                <!-- Informations supplémentaires -->
                <div class="p-5 mb-6 border bg-amber-50 rounded-xl border-amber-200">
                    <div class="flex items-start gap-3">
                        <i class="mt-1 fas fa-info-circle text-amber-600"></i>
                        <div>
                            <p class="mb-1 text-sm font-medium text-amber-800">Prochaines étapes</p>
                            <ul class="space-y-1 text-xs list-disc list-inside text-amber-700">
                                <li>Votre dossier sera examiné par nos équipes</li>
                                <li>Vous serez informé(e) de la date de votre entretien</li>
                                <li>Préparez les documents originaux pour l'entretien</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- QR Code (optionnel) -->
        <div class="max-w-xs p-4 mx-auto text-center bg-white border shadow-lg rounded-xl border-slate-200">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data={{ candidature.numero }}" 
                 alt="QR Code" 
                 class="w-24 h-24 mx-auto mb-2">
            <p class="text-xs text-slate-500">Scannez pour accéder à votre fiche</p>
        </div>
    </div>
</div>
{% endblock %}