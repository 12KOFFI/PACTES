<!-- JavaScript pour la gestion dynamique établissement/métier -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const etablissementSelect = document.getElementById('candidature_etablissement');
    const metierSelect = document.getElementById('candidature_metier');
    const metierInfo = document.getElementById('metier-info');
    const metierNiveau = document.getElementById('metier-niveau');
    const metierNbrPlace = document.getElementById('metier-nbrplace');
    const metierDuree = document.getElementById('metier-duree');
    const etablissementLoading = document.getElementById('etablissement-loading');
    const metierLoading = document.getElementById('metier-loading');
    
    const currentMetierValue = metierSelect.value;

    function loadMetiers(etablissementId, callback) {
        if (!etablissementId) {
            metierSelect.innerHTML = '<option value="">-- Choisissez d\'abord un établissement --</option>';
            metierSelect.disabled = true;
            metierInfo.classList.add('hidden');
            if (callback) callback();
            return;
        }

        metierLoading.classList.remove('hidden');
        metierSelect.disabled = true;

        const url = "{{ path('app_candidature_etablissement_metiers', {'id': 'PLACEHOLDER'}) }}".replace('PLACEHOLDER', etablissementId);
        fetch(url)
            .then(response => response.json())
            .then(data => {
                metierSelect.innerHTML = '<option value="">-- Sélectionnez un métier --</option>';
                
                // Tri par nom de métier
                data.sort((a, b) => a.nom.localeCompare(b.nom));

                data.forEach(metier => {
                    const option = document.createElement('option');
                    option.value = metier.id;
                    option.dataset.niveau = metier.niveau || 'CAP - BT - BTS';
                    option.dataset.duree = metier.duree || '';
                    option.dataset.nbrplace = metier.nbrplace || '';
                    
                    let label = metier.nom;
                    if (metier.nbrplace) {
                        label += ' (' + metier.nbrplace + ' places)';
                    }
                    option.textContent = label;
                    metierSelect.appendChild(option);
                });
                
                const metierToSelect = currentMetierValue || '{{ app.request.get('metier')|default('') }}';
                
                if (metierToSelect) {
                    const options = metierSelect.options;
                    for (let i = 0; i < options.length; i++) {
                        if (options[i].value == metierToSelect) {
                            options[i].selected = true;
                            updateMetierInfo(options[i]);
                            break;
                        }
                    }
                }
                
                metierSelect.disabled = false;
                metierLoading.classList.add('hidden');
                
                if (callback) callback();
            })
            .catch(error => {
                console.error('Erreur:', error);
                metierSelect.disabled = false;
                metierLoading.classList.add('hidden');
                if (callback) callback();
            });
    }

    function updateMetierInfo(selectedOption) {
        if (!selectedOption || !selectedOption.value) {
            metierInfo.classList.add('hidden');
            return;
        }
        
        metierNiveau.textContent = selectedOption.dataset.niveau || 'CAP - BT - BTS';
        metierDuree.textContent = selectedOption.dataset.duree || 'Non spécifié';
        metierNbrPlace.textContent = selectedOption.dataset.nbrplace || 'Non spécifié';
        metierInfo.classList.remove('hidden');
    }

    {% if app.request.get('etablissement') %}
        const etablissementId = '{{ app.request.get('etablissement') }}';
        if (etablissementId) {
            setTimeout(function() {
                const options = etablissementSelect.options;
                for (let i = 0; i < options.length; i++) {
                    if (options[i].value == etablissementId) {
                        options[i].selected = true;
                        break;
                    }
                }
                loadMetiers(etablissementId);
            }, 100);
        }
    {% else %}
        if (etablissementSelect.value) {
            loadMetiers(etablissementSelect.value);
        } else {
            metierSelect.innerHTML = '<option value="">-- Choisissez d\'abord un établissement --</option>';
            metierSelect.disabled = true;
        }
    {% endif %}

    etablissementSelect.addEventListener('change', function() {
        loadMetiers(this.value);
        metierInfo.classList.add('hidden');
    });

    metierSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        updateMetierInfo(selectedOption);
    });

    const form = document.getElementById('candidature-form');
    {# En mode édition, la validation est gérée côté serveur (étapes indépendantes) #}
    if (form && {{ is_edit_page ? 'false' : 'true' }}) {
        form.addEventListener('submit', function(e) {
            {% if not app.user %}
            e.preventDefault();
            alert('Vous devez être connecté pour soumettre une candidature.');
            const redirectUrl = '/candidature/new?etablissement=' + etablissementSelect.value + '&metier=' + metierSelect.value;
            window.location.href = '/login?redirect=' + encodeURIComponent(redirectUrl);
            return false;
            {% endif %}

            {% if app.user and app.user.datenaissance %}
                {% set age = date().diff(date(app.user.datenaissance)).y %}
                {% if age < 16 or age > 40 %}
                    e.preventDefault();
                    alert('Vous ne remplissez pas les conditions d\'âge pour candidater (16 à 40 ans).');
                    return false;
                {% endif %}
            {% endif %}

            if (!etablissementSelect.value) {
                e.preventDefault();
                alert('Veuillez sélectionner un établissement.');
                return false;
            }
            
            if (!metierSelect.value) {
                e.preventDefault();
                alert('Veuillez sélectionner un métier.');
                return false;
            }

            const diplomeSelect = document.getElementById('candidature_diplome');
            if (diplomeSelect && !diplomeSelect.value) {
                e.preventDefault();
                alert('Veuillez sélectionner un diplôme.');
                return false;
            }
        });
    }
});
</script>

<!-- Javascript : calcul du total et de la moyenne (affichage uniquement) -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const noteInputs = document.querySelectorAll('.note-input');
    const totalDisplay = document.getElementById('total-display');
    const moyenneDisplay = document.getElementById('moyenne-display');

    function calculerNotes() {
        let total = 0;

        noteInputs.forEach(input => {
            const val = parseFloat(input.value) || 0;
            total += val;
        });

        const totalMax = 40;
        const moyenne = (total / totalMax) * 4;

        if (totalDisplay) totalDisplay.textContent = total.toFixed(2).replace(/\.00$/, '') + ' / ' + totalMax;
        if (moyenneDisplay) moyenneDisplay.textContent = moyenne.toFixed(2).replace(/\.00$/, '') + ' / 4';
    }

    noteInputs.forEach(input => {
        input.addEventListener('input', calculerNotes);
        input.addEventListener('change', calculerNotes);
    });

    if (noteInputs.length > 0) {
        calculerNotes();
    }
});
</script>

{# Bouton d'action flottant : remonte vers le menu d'accès rapide #}
{% if is_edit_page and candidature is defined and candidature.id and (is_granted('ROLE_ADMIN') or is_granted('ROLE_ENT') or is_granted('ROLE_JURY')) %}
<button id="scrollTopBtn"
        type="button"
        aria-label="Remonter vers le menu d'accès rapide"
        title="Remonter vers le menu d'accès rapide"
        class="hidden fixed bottom-6 right-6 z-50 w-12 h-12 bg-indigo-700 hover:bg-indigo-800 text-white rounded-full shadow-xl transition items-center justify-center focus:outline-none focus:ring-4 focus:ring-indigo-300">
    <i class="fas fa-arrow-up text-base" aria-hidden="true"></i>
</button>

<style>
    .step-tab[aria-selected="true"] { background-color: #eef2ff; border-color: #4338ca; box-shadow: inset 0 -3px 0 #4338ca; color: #312e81; }
    .step-tab[aria-selected="true"] .step-num { background-color: #4338ca; color: #fff; }
    @media (prefers-reduced-motion: reduce) { #wizard-progress { transition: none; } }
</style>

<script>
(function () {
    var wizard = document.getElementById('wizard');
    if (!wizard) { return; }

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var scrollBehavior = reduceMotion ? 'auto' : 'smooth';
    var panels = Array.prototype.slice.call(wizard.querySelectorAll('[data-step-panel]'));
    var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-step-target]'));
    var counter = document.getElementById('wizard-counter');
    var progress = document.getElementById('wizard-progress');
    var progressBar = progress ? progress.parentNode : null;
    var status = document.getElementById('wizard-status');
    var form = document.getElementById('candidature-form');
    var current = -1;

    function ids() { return panels.map(function (p) { return p.getAttribute('data-step-panel'); }); }

    function show(index, opts) {
        opts = opts || {};
        if (index < 0 || index >= panels.length) { return; }
        current = index;
        panels.forEach(function (panel, i) { panel.hidden = (i !== index); });
        tabs.forEach(function (tab) {
            var active = tab.getAttribute('data-step-target') === panels[index].getAttribute('data-step-panel');
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
            tab.tabIndex = active ? 0 : -1;
            if (active) { tab.setAttribute('aria-current', 'step'); } else { tab.removeAttribute('aria-current'); }
        });
        panels.forEach(function (panel, i) {
            var prev = panel.querySelector('[data-step-prev]');
            var next = panel.querySelector('[data-step-next]');
            if (prev) { prev.classList.toggle('hidden', i === 0); prev.classList.toggle('inline-flex', i !== 0); }
            if (next) { next.classList.toggle('hidden', i === panels.length - 1); next.classList.toggle('inline-flex', i !== panels.length - 1); }
        });
        var label = 'Étape ' + (index + 1) + ' sur ' + panels.length;
        if (counter) { counter.textContent = label; }
        if (progress) { progress.style.width = (((index + 1) / panels.length) * 100) + '%'; }
        if (progressBar) { progressBar.setAttribute('aria-valuenow', String(index + 1)); }
        if (status) {
            var title = panels[index].querySelector('h3');
            status.textContent = label + ' : ' + (title ? title.textContent.trim() : '');
        }
        try {
            var url = new URL(window.location.href);
            url.searchParams.set('step', panels[index].getAttribute('data-step-panel'));
            window.history.replaceState(null, '', url.toString());
        } catch (e) { /* ignore */ }
        if (opts.scroll) {
            var title2 = panels[index].querySelector('h3');
            wizard.scrollIntoView({ behavior: scrollBehavior, block: 'start' });
            if (title2) { title2.focus({ preventScroll: true }); }
        }
    }

    function indexOfId(id) { return ids().indexOf(id); }

    tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
            var idx = indexOfId(tab.getAttribute('data-step-target'));
            if (idx >= 0) { show(idx, { scroll: true }); }
        });
        tab.addEventListener('keydown', function (e) {
            var dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : (e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0);
            if (!dir) { return; }
            e.preventDefault();
            var n = tabs[(i + dir + tabs.length) % tabs.length];
            n.focus();
            n.click();
        });
    });

    wizard.addEventListener('click', function (e) {
        var prev = e.target.closest('[data-step-prev]');
        var next = e.target.closest('[data-step-next]');
        if (prev) { show(current - 1, { scroll: true }); }
        if (next) { show(current + 1, { scroll: true }); }
    });

    // Entrée dans un champ : valide l'étape en cours (et non la première du formulaire)
    wizard.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'BUTTON' || e.target.tagName === 'A') { return; }
        var panel = e.target.closest('[data-step-panel]');
        var btn = panel ? panel.querySelector('[data-save-btn]') : null;
        if (btn) { e.preventDefault(); btn.click(); }
    });

    // État de chargement lors de l'enregistrement
    if (form) {
        form.addEventListener('submit', function (e) {
            var submitter = e.submitter || form.querySelector('[data-save-btn]');
            if (submitter && submitter.value && !form.querySelector('input[type="hidden"][name="section"]')) {
                var hidden = document.createElement('input');
                hidden.type = 'hidden'; hidden.name = 'section'; hidden.value = submitter.value;
                form.appendChild(hidden);
            }
            form.setAttribute('aria-busy', 'true');
            if (status) { status.textContent = 'Enregistrement en cours…'; }
            window.setTimeout(function () {
                form.querySelectorAll('[data-save-btn]').forEach(function (btn) {
                    btn.disabled = true;
                    var icon = btn.querySelector('[data-save-icon]');
                    if (icon) { icon.className = 'fas fa-spinner fa-spin mr-2'; }
                    if (btn === submitter) {
                        var lbl = btn.querySelector('[data-save-label]');
                        if (lbl) { lbl.textContent = 'Enregistrement…'; }
                    }
                });
            }, 0);
        });
        // Retour arrière du navigateur (bfcache) : on réactive les boutons
        window.addEventListener('pageshow', function (ev) {
            if (!ev.persisted) { return; }
            form.removeAttribute('aria-busy');
            form.querySelectorAll('[data-save-btn]').forEach(function (btn) {
                btn.disabled = false;
                var icon = btn.querySelector('[data-save-icon]');
                if (icon) { icon.className = 'fas fa-save mr-2'; }
                var lbl = btn.querySelector('[data-save-label]');
                if (lbl) { lbl.textContent = btn.getAttribute('data-label'); }
            });
        });
    }

    // Étape initiale : paramètre ?step=, sinon première étape
    var start = indexOfId(wizard.getAttribute('data-active-step') || '');
    show(start >= 0 ? start : 0);

    // Bouton flottant : remonte vers le menu d'accès rapide
    var fab = document.getElementById('scrollTopBtn');
    var menu = document.getElementById('quick-access-anchor');
    if (fab) {
        function toggleFab() {
            var visible = window.scrollY > 400;
            fab.classList.toggle('hidden', !visible);
            fab.classList.toggle('flex', visible);
        }
        window.addEventListener('scroll', toggleFab, { passive: true });
        toggleFab();
        fab.addEventListener('click', function () {
            var top = menu ? menu.getBoundingClientRect().top + window.scrollY - 16 : 0;
            window.scrollTo({ top: Math.max(top, 0), behavior: scrollBehavior });
            var active = document.querySelector('.step-tab[aria-selected="true"]');
            if (active) { active.focus({ preventScroll: true }); }
        });
    }
})();
</script>
{% endif %}
{% endblock %}