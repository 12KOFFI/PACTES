{% block javascripts %}
      {{ parent() }}
      {% if is_granted('ROLE_ADMIN') %}
  <script>
         document.addEventListener('DOMContentLoaded', function() {
             const metiersUrlTemplate = "{{ path('app_candidature_etablissement_metiers', {'id': '__ID__'}) }}";
               /**
                * Initialise le chargement dynamique des métiers pour un couple établissement/métier
               */
              function initDynamicMetiers(etablissementId, metierId, preselectedMetierValue) {
                  const etablissementSelect = document.getElementById(etablissementId);
                  const metierSelect = document.getElementById(metierId);
                  if (!etablissementSelect || !metierSelect) {
                      return;
                  }
                const resetMetiers = function() {
                    metierSelect.innerHTML = '';
                    const option = document.createElement('option');
                    option.value = 'TOUS';
                    option.textContent = 'Tous les métiers';
                    option.selected = true;
                    metierSelect.appendChild(option);
                    metierSelect.disabled = true;
                };
                const loadMetiers = function(etablissementIdValue, preselectedMetier) {
                    if (!etablissementIdValue || etablissementIdValue === 'TOUS') {
                        resetMetiers();
                        return;
                    }
                    metierSelect.disabled = true;
                    const url = metiersUrlTemplate.replace('__ID__', encodeURIComponent(
                        etablissementIdValue));
                    fetch(url)
                        .then(function(response) {
                            return response.ok ? response.json() : [];
                        })
                        .then(function(data) {
                            metierSelect.innerHTML = '';
                            const allOption = document.createElement('option');
                            allOption.value = 'TOUS';
                            allOption.textContent = 'Tous les métiers';
                            metierSelect.appendChild(allOption);
                            data.forEach(function(metier) {
                                const option = document.createElement('option');
                                option.value = String(metier.id);
                                option.textContent = metier.nom;
                                if (String(preselectedMetier) === String(metier.id)) {
                                    option.selected = true;
                                }
                                metierSelect.appendChild(option);
                            });
                            if (String(preselectedMetier) === 'TOUS' || String(preselectedMetier) ===
                                '') {
                                allOption.selected = true;
                            }
                            metierSelect.disabled = false;
                        })
                        .catch(function() {
                            resetMetiers();
                        });
                };
                etablissementSelect.addEventListener('change', function() {
                    loadMetiers(this.value, 'TOUS');
                });
                if (etablissementSelect.value) {
                    loadMetiers(etablissementSelect.value, preselectedMetierValue);
                } else {
                    resetMetiers();
                }
            }
            // Liste des candidatures enregistrées
            initDynamicMetiers(
                'export-liste-etablissement',
                'export-liste-metier',
                '{{ app.request.request.get('metier_liste ')|default('TOUS ') }}'
            );
            // Liste des candidats éligibles
            initDynamicMetiers(
                'export-eligible-etablissement',
                'export-eligible-metier',
                '{{ app.request.request.get('metier_eligible')|default('TOUS') }}'
            );
            // Liste des candidats admissibles pour la visite médicale
            initDynamicMetiers(
                'export-admissible-visite-etablissement',
                'export-admissible-visite-metier',
                '{{ app.request.request.get('metier_admissible_visite')|default('TOUS') }}'
            );
            // Liste des candidats admis
            initDynamicMetiers(
                'export-admis-etablissement',
                'export-admis-metier',
                '{{ app.request.request.get('metier_admis ')|default('TOUS ') }}'
            );
            // Liste des candidats admis définitifs
            initDynamicMetiers(
                'export-admis-def-etablissement',
                'export-admis-def-metier',
                '{{ app.request.request.get('metier_admis_def ')|default('TOUS ') }}'
            );
        });
    </script>
    {% endif %}
    {% endblock %}