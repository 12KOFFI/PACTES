                        {% if is_granted('ROLE_ADMIN') %}disabled{% endif %}>
                        <option value="TOUS"
                            {% if selectedMetierEvalue is empty or selectedMetierEvalue == 'TOUS' %}selected{% endif %}>Tous
                            les métiers</option>
                        {% if not is_granted('ROLE_ADMIN') %}
                        {% for metier in metiers %}
