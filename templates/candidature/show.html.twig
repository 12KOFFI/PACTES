{% extends 'base.html.twig' %}

{% block title %}Candidature {{ candidature.numero }} | PACTE{% endblock %}

{% block body %}

{% include 'partials/_flash_messages.html.twig' %}

<div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-8 mb-8 text-white">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center">
                <i class="fas fa-id-card text-3xl"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold">Candidature {{ candidature.numero|default('Non attribué') }}</h1>
                <p class="text-white/80">
                    {{ candidature.user ? (candidature.user.nom ~ ' ' ~ candidature.user.prenoms)|trim : 'Candidat inconnu' }}
                </p>
            </div>
        </div>

        {# Badge de statut (mêmes règles que la liste des candidatures) #}
        <div>
            {% if candidature.resultat == 2 %}
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-green-50 text-green-700 border border-green-200">
                    <span class="w-2 h-2 rounded-full bg-green-500"></span> Admis
                </span>
            {% elseif candidature.resultat == 1 %}
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-red-50 text-red-700 border border-red-200">
                    <span class="w-2 h-2 rounded-full bg-red-500"></span> Rejeté
                </span>
            {% elseif candidature.entstatut == 2 %}
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                    <span class="w-2 h-2 rounded-full bg-blue-500"></span> Admissible
                </span>
            {% elseif candidature.etustatut == 2 %}
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span> Dossier OK
                </span>
            {% elseif candidature.etustatut == 1 %}
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-red-50 text-red-700 border border-red-200">
                    <span class="w-2 h-2 rounded-full bg-red-500"></span> Dossier rejeté
                </span>
            {% else %}
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                    <span class="w-2 h-2 rounded-full bg-slate-400"></span> En attente
                </span>
            {% endif %}
        </div>
    </div>
</div>

<div class="max-w-5xl mx-auto px-4 pb-16 space-y-8">

    {# ===== Informations du candidat ===== #}
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="p-6 md:p-8">
            <h3 class="text-lg font-semibold text-indigo-800 flex items-center border-b pb-3 mb-5">
                <div class="w-8 h-8 bg-indigo-200 rounded-lg flex items-center justify-center mr-3">
                    <i class="fas fa-user text-indigo-700"></i>
                </div>
                Informations du candidat
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Nom</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.nom|default('-') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Prénom(s)</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.prenoms|default('-') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Email</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.email|default('-') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Contact</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.contact|default('-') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Sexe</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.sexe|default('-') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Date de naissance</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user and candidature.user.datenaissance ? candidature.user.datenaissance|date('d/m/Y') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Lieu de naissance</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.lieunaissance|default('-') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Nationalité</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.nationalite|default('-') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Résidence</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.residence|default('-') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Situation matrimoniale</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.situationmat|default('-') : '-' }}</p>
                </div>
                {% if is_staff %}
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Nom du père</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.nompere|default('-') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Nom de la mère</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.user ? candidature.user.nommere|default('-') : '-' }}</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# ===== Formation souhaitée ===== #}
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="p-6 md:p-8">
            <h3 class="text-lg font-semibold text-purple-800 flex items-center border-b pb-3 mb-5">
                <div class="w-8 h-8 bg-purple-200 rounded-lg flex items-center justify-center mr-3">
                    <i class="fas fa-graduation-cap text-purple-700"></i>
                </div>
                Formation souhaitée
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Établissement</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.etablissement ? candidature.etablissement.nom : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Métier</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.metier ? candidature.metier.nom : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Niveau</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.niveau|default('-') }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Date de dépôt</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.submittedAt ? candidature.submittedAt|date('d/m/Y à H:i') : (candidature.creation ? candidature.creation|date('d/m/Y à H:i') : '-') }}</p>
                </div>
            </div>
        </div>
    </div>

    {# ===== Documents ===== #}
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="p-6 md:p-8">
            <h3 class="text-lg font-semibold text-slate-800 flex items-center border-b pb-3 mb-5">
                <div class="w-8 h-8 bg-slate-200 rounded-lg flex items-center justify-center mr-3">
                    <i class="fas fa-folder-open text-slate-700"></i>
                </div>
                Documents déposés
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {% for field, config in document_labels %}
                    {% set fileName = attribute(candidature, field) %}
                    {% set fileExists = fileName is not null and fileName != '' %}
                    {% set fileUrl = asset('media/' ~ candidature.numero ~ '/' ~ fileName) %}
                    <div class="flex items-center justify-between p-4 rounded-xl border border-slate-200 {{ fileExists ? 'bg-slate-50' : 'bg-slate-50/50' }}">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg flex items-center justify-center {{ fileExists ? 'bg-indigo-100 text-indigo-600' : 'bg-slate-200 text-slate-400' }}">
                                <i class="fas fa-{{ config.icon }}"></i>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-slate-700">{{ config.text }}</p>
                                <p class="text-xs text-slate-400">{{ fileExists ? 'Déposé' : 'Non déposé' }}</p>
                            </div>
                        </div>
                        {% if fileExists %}
                            <a href="{{ fileUrl }}" target="_blank"
                               class="inline-flex items-center justify-center px-3 py-2 rounded-lg bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition">
                                <i class="fas fa-eye mr-1.5"></i> Voir
                            </a>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ===== Étude du dossier / Évaluation (réservé au staff) ===== #}
    {% if is_staff %}
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="p-6 md:p-8">
            <h3 class="text-lg font-semibold text-amber-800 flex items-center border-b pb-3 mb-5">
                <div class="w-8 h-8 bg-amber-200 rounded-lg flex items-center justify-center mr-3">
                    <i class="fas fa-clipboard-list text-amber-700"></i>
                </div>
                Étude du dossier et évaluation
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4 mb-6">
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Décision étude de dossier</p>
                    <p class="text-sm font-medium text-slate-800">
                        {% if candidature.etustatut == 2 %}Admissible
                        {% elseif candidature.etustatut == 1 %}Non admissible
                        {% else %}En attente{% endif %}
                    </p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Commentaire dossier</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.etucom|default('-') }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Date d'entretien</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.entdate ? candidature.entdate|date('d/m/Y H:i') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Lieu d'entretien</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.entlieu|default('-') }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Jury</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.jury|default('-') }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Commentaire entretien</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.entcom|default('-') }}</p>
                </div>
            </div>

            {# Notes #}
            <div class="grid grid-cols-3 md:grid-cols-9 gap-2 mb-6">
                {% for i in 1..9 %}
                    {% set note = attribute(candidature, 'note' ~ i) %}
                    <div class="text-center p-2 rounded-lg border border-slate-200 bg-slate-50">
                        <p class="text-[0.65rem] uppercase text-slate-400">Note {{ i }}</p>
                        <p class="text-sm font-semibold text-slate-700">{{ note is not null ? note : '-' }}</p>
                    </div>
                {% endfor %}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Date visite médicale</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.visdate ? candidature.visdate|date('d/m/Y H:i') : '-' }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Lieu visite médicale</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.vislieu|default('-') }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Statut visite médicale</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.visstatut|default('-') }}</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-400">Commentaire visite médicale</p>
                    <p class="text-sm font-medium text-slate-800">{{ candidature.viscom|default('-') }}</p>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="flex justify-center">
        <a href="{{ path('app_candidature_index') }}"
           class="inline-flex items-center px-6 py-2.5 rounded-lg bg-slate-100 text-slate-700 text-sm font-semibold hover:bg-slate-200 transition">
            <i class="fas fa-arrow-left mr-2"></i> Retour à la liste
        </a>
    </div>

</div>

{% endblock %}
