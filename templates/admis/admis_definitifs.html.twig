{% extends 'base_dashboard.html.twig' %}

{% block title %}Liste des Candidats Inscrits{% endblock %}

{% block body %}
<div class="max-w-8xl mx-auto pb-10">

{# ===== EN-TÊTE ===== #}
<div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-6 md:p-8 mb-8 text-white relative overflow-hidden">
    <div class="absolute -top-14 -right-14 w-52 h-52 rounded-full bg-white/5 pointer-events-none"></div>
    <div class="absolute -bottom-16 left-1/3 w-64 h-64 rounded-full bg-white/[0.04] pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-white/15 backdrop-blur border border-white/20 flex items-center justify-center text-2xl shrink-0">
                <i class="fas fa-user-graduate"></i>
            </div>
            <div>
                <h1 class="text-xl md:text-2xl font-bold tracking-tight">Candidats admis définitivement</h1>
                <p class="text-white/60 text-sm mt-0.5">{{ etablissement.nom }}</p>
            </div>
        </div>
        <a href="{{ path('app_dashboard') }}"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-sm font-medium transition-all hover:-translate-y-0.5 w-full md:w-auto justify-center">
            <i class="fas fa-arrow-left text-xs"></i> Tableau de bord
        </a>
    </div>

    {# Stats résumé - 3 Cartes Modernes #}
    {% set total_inscrits = admis.getTotalItemCount %}
    {% set total_hommes_count = total_hommes|default(0) %}
    {% set total_femmes_count = total_femmes|default(0) %}
    {% set pct_hommes = total_inscrits > 0 ? ((total_hommes_count / total_inscrits) * 100)|round(1) : 0 %}
    {% set pct_femmes = total_inscrits > 0 ? ((total_femmes_count / total_inscrits) * 100)|round(1) : 0 %}

    {% set total_non_inscrits = total_admis_non_inscrits|default(0) %}
    {% set total_provisoires_pool = total_inscrits + total_non_inscrits %}
    {% set pct_non_inscrits = total_provisoires_pool > 0 ? ((total_non_inscrits / total_provisoires_pool) * 100)|round(1) : 0 %}

    <div class="relative z-10 mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        {# Carte 1: INSCRITS DÉFINITIFS #}
        <div class="bg-white/15 backdrop-blur-md rounded-2xl p-5 border border-white/20 flex flex-col justify-between shadow-sm hover:bg-white/20 transition-all">
            <div class="flex items-center justify-between gap-3 mb-3">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-emerald-400/20 text-emerald-200 border border-emerald-300/30 flex items-center justify-center text-xl shrink-0">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <div>
                        <p class="text-white/70 text-xs uppercase tracking-wider font-semibold">Inscrits Définitifs</p>
                        <p class="text-2xl lg:text-3xl font-extrabold tracking-tight leading-none text-white mt-0.5">{{ total_inscrits }}</p>
                    </div>
                </div>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-200 border border-emerald-400/30">
                    <i class="fas fa-check-circle text-[10px]"></i> Validés
                </span>
            </div>
            {# Répartition par Genre #}
            <div class="pt-3 border-t border-white/10 flex items-center justify-between gap-2 text-xs">
                <div class="flex items-center gap-1.5 bg-sky-500/20 text-sky-100 px-2.5 py-1 rounded-lg border border-sky-400/30">
                    <i class="fas fa-mars text-sky-200"></i>
                    <span class="font-bold">{{ total_hommes_count }}</span>
                    <span class="text-sky-200/90 text-[11px]">({{ pct_hommes }}%)</span>
                </div>
                <div class="flex items-center gap-1.5 bg-pink-500/20 text-pink-100 px-2.5 py-1 rounded-lg border border-pink-400/30">
                    <i class="fas fa-venus text-pink-200"></i>
                    <span class="font-bold">{{ total_femmes_count }}</span>
                    <span class="text-pink-200/90 text-[11px]">({{ pct_femmes }}%)</span>
                </div>
            </div>
        </div>

        {# Carte 2: ADMIS PROVISOIRES NON INSCRITS #}
        <div class="bg-white/15 backdrop-blur-md rounded-2xl p-5 border border-white/20 flex flex-col justify-between shadow-sm hover:bg-white/20 transition-all">
            <div class="flex items-center justify-between gap-3 mb-3">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-amber-400/20 text-amber-200 border border-amber-300/30 flex items-center justify-center text-xl shrink-0">
                        <i class="fas fa-user-clock"></i>
                    </div>
                    <div>
                        <p class="text-white/70 text-xs uppercase tracking-wider font-semibold">Admis Provisoires Non Inscrits</p>
                        <p class="text-2xl lg:text-3xl font-extrabold tracking-tight leading-none text-white mt-0.5">{{ total_non_inscrits }}</p>
                    </div>
                </div>
                {% if total_non_inscrits > 0 %}
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-200 border border-amber-400/30">
                    <i class="fas fa-hourglass-half text-[10px]"></i> En attente
                </span>
                {% endif %}
            </div>
            <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs text-amber-100/90">
                <span>Reste à inscrire :</span>
                <span class="font-bold text-amber-200 bg-amber-500/20 px-2 py-0.5 rounded border border-amber-400/30">
                    {{ pct_non_inscrits }}% des admis prov.
                </span>
            </div>
        </div>

        {# Carte 3: ABANDONS SIGNALÉS #}
        <div class="bg-white/15 backdrop-blur-md rounded-2xl p-5 border border-white/20 flex flex-col justify-between shadow-sm hover:bg-white/20 transition-all">
            <div class="flex items-center justify-between gap-3 mb-3">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-rose-400/20 text-rose-200 border border-rose-300/30 flex items-center justify-center text-xl shrink-0">
                        <i class="fas fa-user-slash"></i>
                    </div>
                    <div>
                        <p class="text-white/70 text-xs uppercase tracking-wider font-semibold">Abandons Signalés</p>
                        <p class="text-2xl lg:text-3xl font-extrabold tracking-tight leading-none text-white mt-0.5">{{ total_abandons|default(0) }}</p>
                    </div>
                </div>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-200 border border-rose-400/30">
                    <i class="fas fa-info-circle text-[10px]"></i> Retirés
                </span>
            </div>
            <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs text-rose-100/90">
                <span>Statut :</span>
                <span class="font-medium text-rose-200">Exclus des effectifs actifs</span>
            </div>
        </div>
    </div>
</div>

{# ===== FLASH MESSAGES ===== #}
{% for type, messages in app.flashes %}
    {% for message in messages %}
        {% set bg  = type == 'success' ? 'bg-green-50 border-green-200 text-green-700' : (type in ['error','danger'] ? 'bg-red-50 border-red-200 text-red-700' : 'bg-blue-50 border-blue-200 text-blue-700') %}
        {% set ico = type == 'success' ? 'check-circle' : (type in ['error','danger'] ? 'exclamation-circle' : 'info-circle') %}
        <div class="flex items-center gap-3 px-5 py-3.5 rounded-xl border mb-5 text-sm font-medium {{ bg }}">
            <i class="fas fa-{{ ico }}"></i> {{ message|raw }}
        </div>
    {% endfor %}
{% endfor %}

{# ===== TABLEAU ===== #}
<div id="admis-definitifs-container">

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">

    {# Toolbar #}
    <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/60">
        <form method="get" id="filterForm" class="flex flex-wrap items-center w-full justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2 text-sm text-slate-500 font-medium">
                    <span>Afficher</span>
                    <select name="limit" id="pageSizeSelect" onchange="document.getElementById('filterForm').submit();"
                            class="border border-slate-200 rounded-lg px-2 py-1 text-sm text-slate-700 bg-white cursor-pointer outline-none focus:border-indigo-400 font-medium">
                        <option value="10" {% if limit == 10 %}selected{% endif %}>10</option>
                        <option value="25" {% if limit == 25 %}selected{% endif %}>25</option>
                        <option value="50" {% if limit == 50 %}selected{% endif %}>50</option>
                        <option value="100" {% if limit == 100 %}selected{% endif %}>100</option>
                    </select>
                    <span>éléments</span>
                </div>
            </div>
            <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-3 py-2 focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100 transition-all">
                <i class="fas fa-search text-slate-400 text-xs"></i>
                <input type="text" name="q" value="{{ searchTerm }}" placeholder="Rechercher..."
                       class="outline-none text-sm text-slate-700 placeholder-slate-300 w-44 bg-transparent">
            </div>
            {% for key, val in app.request.query.all %}
                {% if key != 'limit' and key != 'q' and key != 'page' %}
                    <input type="hidden" name="{{ key }}" value="{{ val }}">
                {% endif %}
            {% endfor %}
        </form>
    </div>

{% if admis.getTotalItemCount > 0 %}

    {# Table #}
    <div class="overflow-x-auto">
        <table class="w-full min-w-[750px]">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">N°</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">N° Inscription</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Candidat</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Contact</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Métier</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Date inscription</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Contrat</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Livret</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Statut</th>
                    <th class="px-5 py-3 text-center text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Actions</th>
                </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-slate-50">
                {% for item in admis %}
                <tr class="hover:bg-slate-50/70 transition-colors duration-100">
                    <td class="px-5 py-4 text-sm text-slate-400 font-medium">{{ (admis.currentPageNumber - 1) * admis.itemNumberPerPage + loop.index }}</td>
                    <td class="px-5 py-4">
                        <span class="font-mono text-xs bg-indigo-50 text-indigo-600 border border-indigo-500 px-2.5 py-1 rounded-lg font-medium">
                            {{ item.numeroInscription }}
                        </span>
                    </td>
                    <td class="px-5 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center shrink-0">
                                <i class="fas fa-user text-emerald-600 text-xs"></i>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-slate-800">{{ item.user.nom|upper }} {{ item.user.prenoms }}</p>
                                <p class="text-xs text-slate-400 mt-0.5">{{ item.user.email }}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-5 py-4 text-sm font-mono text-slate-500">
                        {% if item.user.contact %}
                            {% set contact = item.user.contact|replace({' ': ''}) %}
                            {% if contact|length == 8 %}
                                {{ contact|slice(0, 2) }} {{ contact|slice(2, 2) }} {{ contact|slice(4, 2) }} {{ contact|slice(6, 2) }}
                            {% elseif contact|length == 10 %}
                                {{ contact|slice(0, 2) }} {{ contact|slice(2, 2) }} {{ contact|slice(4, 2) }} {{ contact|slice(6, 2) }} {{ contact|slice(8, 2) }}
                            {% else %}
                                {{ item.user.contact }}
                            {% endif %}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td class="px-5 py-4">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[0.68rem] font-semibold bg-blue-50 text-blue-700 border border-blue-400">
                            {{ item.metier.nom }}
                        </span>
                    </td>
                    <td class="px-5 py-4 text-xs text-slate-400 font-mono">
                        {{ item.dateInscription|date('d/m/Y') }}
                        <span class="block text-slate-300">{{ item.dateInscription|date('H:i') }}</span>
                    </td>
                    <td class="px-5 py-4">
                        {% if item.fichierContrat %}
                            <div class="flex flex-col gap-1 items-start">
                                <a href="{{ asset('uploads/contrats/' ~ item.fichierContrat) }}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.7rem] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-500 hover:bg-emerald-100 transition" title="Voir le document">
                                    <i class="fas fa-file-pdf"></i> Contrat signé
                                </a>
                                {% if item.entreprisePartenaire %}
                                    <span class="text-[0.65rem] text-slate-500 font-medium"><i class="fas fa-building mr-1"></i>{{ item.entreprisePartenaire.nomStructure }}</span>
                                {% endif %}
                            </div>
                        {% else %}
                            <a href="{{ path('app_admis_edit', {'id': item.id}) }}#contrat" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition" title="Renseigner l'entreprise et joindre le PDF">
                                <i class="fas fa-file-signature"></i> Joindre PDF
                            </a>
                        {% endif %}
                    </td>
                    <td class="px-5 py-4">
                        {% if item.fichierLivret %}
                            <a href="{{ asset('uploads/livrets/' ~ item.fichierLivret) }}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.7rem] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-500 hover:bg-emerald-100 transition" title="Voir le livret">
                                <i class="fas fa-book-reader"></i> Livret soumis
                            </a>
                        {% else %}
                            <a href="{{ path('app_admis_edit', {'id': item.id}) }}#livret" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition" title="Joindre le livret apprenti">
                                <i class="fas fa-book-reader"></i> Joindre Livret
                            </a>
                        {% endif %}
                    </td>
                    <td class="px-5 py-4">
                        {% if item.confirme %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.7rem] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-500">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>Confirmé
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.7rem] font-semibold bg-amber-50 text-amber-700 border border-amber-500">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>En attente
                            </span>
                        {% endif %}
                    </td>
                    <td class="px-5 py-4 text-center">
                        {% if item.fichierContrat %}
                            <a href="{{ path('app_admis_edit', {'id': item.id}) }}#contrat" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-blue-50 text-blue-600 border border-blue-200 hover:bg-blue-100 transition" title="Modifier le contrat">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50/60">
        <p class="text-xs text-slate-400 font-medium">
            Affichage de <strong class="text-slate-600">{{ admis.itemNumberPerPage * (admis.currentPageNumber - 1) + 1 }}</strong> 
            à <strong class="text-slate-600">{{ min(admis.itemNumberPerPage * admis.currentPageNumber, admis.getTotalItemCount) }}</strong> 
            sur <strong class="text-slate-600">{{ admis.getTotalItemCount }}</strong> élément(s)
        </p>
        <div class="knp-pagination">
            {{ knp_pagination_render(admis) }}
        </div>
    </div>
    </div>

{% else %}

    {# ===== ÉTAT VIDE ===== #}
    <div class="py-16 px-8 text-center">
        <div class="w-16 h-16 rounded-2xl bg-indigo-50 flex items-center justify-center mx-auto mb-5 text-3xl text-indigo-400">
            <i class="fas fa-user-graduate"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-800 mb-2">Aucun candidat trouvé</h3>
        <p class="text-sm text-slate-500">Aucun résultat ne correspond à votre recherche ou il n'y a pas de candidats inscrits.</p>
    </div>

{% endif %}

</div>

</div>

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('admis-definitifs-container');
    if (!container) return;

    let searchTimeout;

    container.addEventListener('submit', (e) => {
        if (e.target.id === 'filterForm') {
            e.preventDefault();
            fetchResults(new URLSearchParams(new FormData(e.target)).toString());
        }
    });

    container.addEventListener('input', (e) => {
        if (e.target.name === 'q') {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                const form = document.getElementById('filterForm');
                if (form) fetchResults(new URLSearchParams(new FormData(form)).toString());
            }, 400);
        }
    });

    container.addEventListener('change', (e) => {
        if (e.target.name === 'limit') {
            const form = document.getElementById('filterForm');
            if (form) fetchResults(new URLSearchParams(new FormData(form)).toString());
        }
    });

    container.addEventListener('click', (e) => {
        const link = e.target.closest('.knp-pagination a');
        if (link) {
            e.preventDefault();
            const url = new URL(link.href);
            fetchResults(url.search);
        }
    });

    function fetchResults(queryString) {
        const url = `${window.location.pathname}?${queryString}`;
        
        window.history.pushState({}, '', url);

        container.style.opacity = '0.5';
        container.style.pointerEvents = 'none';

        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(response => response.text())
        .then(html => {
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const newContainer = doc.getElementById('admis-definitifs-container');
            if (newContainer) {
                container.innerHTML = newContainer.innerHTML;
            }
        })
        .finally(() => {
            container.style.opacity = '1';
            container.style.pointerEvents = 'auto';
            
            const searchInput = document.querySelector('input[name="q"]');
            if (searchInput) {
                const val = searchInput.value;
                searchInput.focus();
                searchInput.setSelectionRange(val.length, val.length);
            }
        });
    }
});
</script>
{% endblock %}

{% endblock %}
