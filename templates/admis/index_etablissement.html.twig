{% extends 'base_dashboard.html.twig' %}

{% block title %}Liste des Candidats Inscrits{% endblock %}

{% block body %}
<div class="max-w-8xl mx-auto pb-10">

{# ===== EN-TÊTE ===== #}
<div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-6 md:p-8 mb-8 text-white relative overflow-hidden">
    <div class="absolute -top-14 -right-14 w-52 h-52 rounded-full bg-white/5 pointer-events-none"></div>
    <div class="absolute -bottom-16 left-1/3 w-64 h-64 rounded-full bg-white/[0.04] pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-white/15 backdrop-blur border border-white/20 flex items-center justify-center text-2xl shrink-0">
                <i class="fas fa-user-graduate"></i>
            </div>
            <div>
                <h1 class="text-xl md:text-2xl font-bold tracking-tight">Candidats admis définitivement</h1>
                <p class="text-white/60 text-sm mt-0.5">{{ etablissement.nom }}</p>
            </div>
        </div>
        <a href="{{ path('app_dashboard') }}"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-sm font-medium transition-all hover:-translate-y-0.5 w-full md:w-auto justify-center">
            <i class="fas fa-arrow-left text-xs"></i> Tableau de bord
        </a>
    </div>

    {# Statistiques résumé dans le header #}
    <div class="relative z-10 mt-5 grid grid-cols-3 gap-3">
        <div class="bg-white/10 backdrop-blur-sm rounded-xl px-4 py-3 border border-white/10 text-center">
            <p class="text-2xl font-bold">{{ admis|length }}</p>
            <p class="text-white/60 text-xs uppercase tracking-wider mt-0.5">Total inscrits</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl px-4 py-3 border border-white/10 text-center">
            <p class="text-2xl font-bold text-emerald-300">{{ admis|filter(a => a.confirme)|length }}</p>
            <p class="text-white/60 text-xs uppercase tracking-wider mt-0.5">Confirmés</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl px-4 py-3 border border-white/10 text-center relative">
            <p class="text-2xl font-bold text-amber-300">
                {{ total_admis_non_inscrits }}{% if total_admis_etablissement > 0 %} / {{ total_admis_etablissement }} Admis{% endif %}
            </p>
            {% if total_admis_etablissement > 0 %}
            <div class="mb-2 text-xs text-amber-200">
                {% set pourcentage = ((total_admis_non_inscrits / total_admis_etablissement) * 100)|round(1) %}
                soit {{ pourcentage }}% des admis
            </div>
            {% endif %}
            <p class="text-white/60 text-xs uppercase tracking-wider mt-0.5">En attente d'inscription</p>
            {% if total_admis_non_inscrits > 0 %}
            <div class="absolute -top-2 -right-2 w-6 h-6 bg-red-500 rounded-full flex items-center justify-center animate-pulse">
                <span class="text-white text-xs font-bold">{{ total_admis_non_inscrits }}</span>
            </div>
            {% endif %}            
        </div>
    </div>
</div>

{# ===== TABLEAU ===== #}
{% if admis|length > 0 %}

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">

    {# Toolbar #}
    <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/60">
        <div class="flex items-center gap-2 text-sm text-slate-500 font-medium">
            <span>Afficher</span>
            <select id="pageSizeSelect"
                    class="border border-slate-200 rounded-lg px-2 py-1 text-sm text-slate-700 bg-white cursor-pointer outline-none focus:border-indigo-400 font-medium">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
            </select>
            <span>éléments</span>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-3 py-2 focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100 transition-all">
            <i class="fas fa-search text-slate-400 text-xs"></i>
            <input id="tableSearch" type="text" placeholder="Rechercher…"
                   class="outline-none text-sm text-slate-700 placeholder-slate-300 w-44 bg-transparent">
        </div>
    </div>

    {# Table #}
    <div class="overflow-x-auto">
        <table class="w-full min-w-[750px]">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">N°</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">N° Inscription</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Candidat</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Contact</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Métier</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Date inscription</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Statut</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Contrat</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Livret</th>
                </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-slate-50">
                {% for item in admis %}
                <tr class="hover:bg-slate-50/70 transition-colors duration-100">
                    <td class="px-5 py-4 text-sm text-slate-400 font-medium">{{ loop.index }}</td>
                    <td class="px-5 py-4">
                        <span class="font-mono text-xs bg-indigo-50 text-indigo-600 border border-indigo-500 px-2.5 py-1 rounded-lg font-medium">
                            {{ item.numeroInscription }}
                        </span>
                    </td>
                    <td class="px-5 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center shrink-0">
                                <i class="fas fa-user text-emerald-600 text-xs"></i>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-slate-800">{{ item.user.nom|upper }} {{ item.user.prenoms }}</p>
                                <p class="text-xs text-slate-400 mt-0.5">{{ item.user.email }}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-5 py-4 text-sm font-mono text-slate-500">
                        {% if item.user.contact %}
                            {% set contact = item.user.contact|replace({' ': ''}) %}
                            {% if contact|length == 8 %}
                                {{ contact|slice(0, 2) }} {{ contact|slice(2, 2) }} {{ contact|slice(4, 2) }} {{ contact|slice(6, 2) }}
                            {% elseif contact|length == 10 %}
                                {{ contact|slice(0, 2) }} {{ contact|slice(2, 2) }} {{ contact|slice(4, 2) }} {{ contact|slice(6, 2) }} {{ contact|slice(8, 2) }}
                            {% else %}
                                {{ item.user.contact }}
                            {% endif %}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td class="px-5 py-4">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[0.68rem] font-semibold bg-blue-50 text-blue-700 border border-blue-400">
                            {{ item.metier.nom }}
                        </span>
                    </td>
                    <td class="px-5 py-4 text-xs text-slate-400 font-mono">
                        {{ item.dateInscription|date('d/m/Y') }}
                        <span class="block text-slate-300">{{ item.dateInscription|date('H:i') }}</span>
                    </td>
                    <td class="px-5 py-4">
                        {% if item.confirme %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.7rem] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-500">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>Confirmé
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.7rem] font-semibold bg-amber-50 text-amber-700 border border-amber-500">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>En attente
                            </span>
                        {% endif %}
                    </td>
                    <td class="px-5 py-4">
                        {% if item.fichierContrat %}
                            <a href="{{ asset('uploads/contrats/' ~ item.fichierContrat) }}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100 transition" title="Voir le contrat">
                                <i class="fas fa-file-pdf text-red-500"></i> Voir Contrat
                            </a>
                        {% else %}
                            <a href="{{ path('app_admis_edit', {'id': item.id}) }}#contrat" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition" title="Ajouter le contrat d'apprentissage">
                                <i class="fas fa-file-signature"></i> Ajouter Contrat
                            </a>
                        {% endif %}
                    </td>
                    <td class="px-5 py-4">
                        {% if item.fichierLivret %}
                            <a href="{{ asset('uploads/livrets/' ~ item.fichierLivret) }}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 transition" title="Voir le livret">
                                <i class="fas fa-book-reader"></i> Voir Livret
                            </a>
                        {% else %}
                            <div x-data="{ open: false }" class="relative">
                                <button type="button" @click="open = !open" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition" title="Ajouter le livret apprenti">
                                    <i class="fas fa-book-reader"></i> Ajouter Livret
                                </button>
                                <div x-show="open" x-cloak x-transition @click.outside="open = false"
                                     class="absolute right-0 top-full mt-2 z-20 bg-white rounded-xl shadow-xl border border-slate-200 p-4 w-72">
                                    <form action="{{ path('app_admis_upload_livret', {id: item.id}) }}" method="post" enctype="multipart/form-data" class="space-y-3">
                                        <input type="file" name="livret_file" required accept=".pdf,.jpg,.jpeg,.png"
                                               class="w-full text-xs file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                                        <button type="submit" class="w-full px-3 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-medium hover:bg-blue-700 transition">
                                            <i class="fas fa-upload mr-1"></i> Uploader
                                        </button>
                                    </form>
                                </div>
                            </div>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50/60">
        <p id="paginationInfo" class="text-xs text-slate-400 font-medium"></p>
        <nav id="paginationNav" class="flex items-center gap-1" aria-label="Pagination"></nav>
    </div>
</div>

{% else %}

{# ===== ÉTAT VIDE ===== #}
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 py-16 px-8 text-center">
    <div class="w-16 h-16 rounded-2xl bg-indigo-50 flex items-center justify-center mx-auto mb-5 text-3xl text-indigo-400">
        <i class="fas fa-user-graduate"></i>
    </div>
    <h3 class="text-lg font-bold text-slate-800 mb-2">Aucun candidat inscrit</h3>
    <p class="text-sm text-slate-500">Les candidats admis n'ont pas encore procédé à leur inscription définitive.</p>
</div>

{% endif %}

</div>

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    const tbody = document.getElementById('tableBody');
    if (!tbody) return;
    const allRows = Array.from(tbody.querySelectorAll('tr'));
    const info = document.getElementById('paginationInfo');
    const nav = document.getElementById('paginationNav');
    const searchInput = document.getElementById('tableSearch');
    const pageSizeSelect = document.getElementById('pageSizeSelect');
    let pageSize = parseInt(pageSizeSelect.value), currentPage = 1, filtered = [...allRows];

    function applyFilter(q) {
        const term = q.toLowerCase().trim();
        filtered = allRows.filter(r => !term || r.textContent.toLowerCase().includes(term));
        currentPage = 1; render();
    }

    function render() {
        const total = filtered.length, pages = Math.max(1, Math.ceil(total / pageSize));
        currentPage = Math.min(currentPage, pages);
        const start = (currentPage - 1) * pageSize, end = Math.min(start + pageSize, total);
        allRows.forEach(r => r.style.display = 'none');
        filtered.slice(start, end).forEach(r => r.style.display = '');
        info.innerHTML = total === 0 ? 'Aucun résultat trouvé'
            : `Affichage de <strong class="text-slate-600">${start+1}</strong> à <strong class="text-slate-600">${end}</strong> sur <strong class="text-slate-600">${total}</strong> élément(s)`;
        buildPagination(pages);
    }

    function buildPagination(pages) {
        nav.innerHTML = '';
        const base = 'inline-flex items-center justify-center min-w-[34px] h-[34px] px-2 rounded-lg text-xs font-semibold border transition-colors duration-150 ';
        const idle = base + 'bg-white border-slate-200 text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 cursor-pointer';
        const active = base + 'bg-indigo-600 border-indigo-600 text-white cursor-default pointer-events-none';
        const disabled = base + 'bg-white border-slate-100 text-slate-300 cursor-not-allowed pointer-events-none opacity-40';
        const makeBtn = (label, page, cls) => {
            const el = document.createElement('button'); el.innerHTML = label; el.className = cls;
            if (cls === idle) el.addEventListener('click', () => { currentPage = page; render(); });
            return el;
        };
        nav.appendChild(makeBtn('<i class="fas fa-chevron-left" style="font-size:0.6rem"></i>', currentPage - 1, currentPage === 1 ? disabled : idle));
        getPageRange(currentPage, pages).forEach(p => {
            if (p === '...') { const el = document.createElement('span'); el.textContent = '···'; el.className = 'inline-flex items-center justify-center w-8 h-[34px] text-xs text-slate-300 font-bold tracking-wider select-none'; nav.appendChild(el); }
            else nav.appendChild(makeBtn(p, p, p === currentPage ? active : idle));
        });
        nav.appendChild(makeBtn('<i class="fas fa-chevron-right" style="font-size:0.6rem"></i>', currentPage + 1, currentPage === pages ? disabled : idle));
    }

    function getPageRange(cur, total) {
        if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
        const set = new Set([1, total, cur, cur-1, cur+1].filter(p => p >= 1 && p <= total));
        const sorted = [...set].sort((a, b) => a - b), result = [];
        sorted.forEach((p, i) => { if (i > 0 && p - sorted[i-1] > 1) result.push('...'); result.push(p); });
        return result;
    }

    searchInput.addEventListener('input', e => applyFilter(e.target.value));
    pageSizeSelect.addEventListener('change', e => { pageSize = parseInt(e.target.value); currentPage = 1; render(); });
    render();
})();
</script>
{% endblock %}

{% endblock %}
