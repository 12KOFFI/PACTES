{# Sidebar - Constantes de style #}
{% set nav_classes = {
    base_link: 'flex items-center p-3 rounded-xl transition-all duration-200 group relative',
    inactive_link: 'text-indigo-100 hover:bg-white/10 hover:text-white',
    active_link: 'bg-white/20 text-white shadow-lg',
    menu_button: 'w-full flex items-center p-3 rounded-xl text-indigo-100 hover:bg-white/10 hover:text-white transition-all duration-200 group',
} %}

{# Sidebar responsive - lg = 1024px breakpoint #}
<aside class="fixed inset-y-0 left-0 z-30 flex-shrink-0 w-64 text-white transition-all duration-300 transform -translate-x-full bg-gradient-to-b from-primary-900 to-secondary-900 sidebar-transition lg:translate-x-0 lg:relative"
       x-data="{ isDesktop: window.innerWidth >= 1024, collapsed: false }"
       @resize.window="isDesktop = window.innerWidth >= 1024; if (isDesktop) sidebarOpen = false"
       :class="[sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0', collapsed ? 'w-20' : 'w-64']">

    <div class="flex flex-col h-full overflow-hidden">

        {# ==================== LOGO ==================== #}
        <div class="flex-shrink-0 p-3 border-b border-white/10">
            <div class="flex items-center justify-between">

                <div class="flex items-center gap-3 sidebar-logo-text"
                     :class="collapsed ? 'hidden' : 'flex'">

                    <a href="{{ path('app_home') }}">
                        <img src="{{ asset('/image/logo.png') }}"
                             class="rounded-lg shadow-lg h-9"
                             alt="PACTE">
                    </a>

                </div>

                <div class="flex items-center gap-1 ml-auto">

                    {# Bouton réduire / agrandir #}
                    <button x-show="isDesktop"
                            @click="collapsed = !collapsed"
                            class="p-2 text-white transition rounded-lg hover:bg-white/10"
                            title="Réduire/Agrandir">

                        <i class="text-lg fas"
                           :class="collapsed ? 'fa-angle-double-right' : 'fa-angle-double-left'">
                        </i>

                    </button>

                    {# Bouton fermer sur mobile #}
                    <button x-show="!isDesktop"
                            @click="sidebarOpen = false"
                            class="p-2 text-white rounded-lg hover:bg-white/10 lg:hidden">

                        <i class="text-lg fas fa-times"></i>

                    </button>

                </div>

            </div>
        </div>


        {# ==================== MENU ==================== #}
        <nav class="flex-1 min-h-0 p-3 space-y-1 overflow-y-auto scrollbar-thin">


            {# ==================== SÉLECTEUR DE VAGUE DE RECRUTEMENT ==================== #}
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENT') or is_granted('ROLE_JURY') %}
                {% set sessions_consultables = session_context.sessions %}
                {% if sessions_consultables|length > 0 %}
                    <form method="get" action="{{ app.request.pathInfo }}" class="px-1 pb-2" :class="collapsed ? 'hidden' : 'block'">
                        <label for="select-session" class="block mb-1 text-xs uppercase tracking-wide text-white/60">Vague de recrutement</label>
                        <select id="select-session" name="session" onchange="this.form.submit()"
                                class="w-full px-2 py-1.5 text-sm text-slate-800 rounded-lg border-0">
                            {% for s in sessions_consultables %}
                                <option value="{{ s.id }}" {{ session_context.currentSession and session_context.currentSession.id == s.id ? 'selected' : '' }}>{{ s.nom }}</option>
                            {% endfor %}
                        </select>
                    </form>
                {% endif %}
            {% endif %}

            {# ==================== TABLEAU DE BORD ==================== #}
            <a href="{{ path('app_dashboard') }}"
               class="{{ nav_classes.base_link }} {{ app.current_route starts with 'app_dashboard' ? nav_classes.active_link : nav_classes.inactive_link }}"
               :class="collapsed ? 'justify-center' : 'gap-3'"
               x-data="{ tooltip: false }"
               @mouseenter="tooltip = true"
               @mouseleave="tooltip = false">

                <div class="flex items-center justify-center flex-shrink-0 w-10 h-10 rounded-xl bg-white/10">
                    <i class="text-lg fas fa-tachometer-alt"></i>
                </div>

                <span class="text-sm font-medium nav-text whitespace-nowrap"
                      :class="collapsed ? 'hidden' : 'block'">
                    Tableau de bord
                </span>

                <div x-show="collapsed && tooltip"
                     x-cloak
                     class="absolute z-50 px-2 py-1 ml-2 text-xs text-white bg-gray-800 rounded left-full whitespace-nowrap">
                    Tableau de bord
                </div>

            </a>


            {# ==================== RECRUTEMENTS ==================== #}
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENT') or is_granted('ROLE_JURY') %}

                <div x-data="{ open: {{ app.current_route starts with 'app_candidature' or app.current_route starts with 'app_admis' ? 'true' : 'false' }}, tooltip: false }">

                    <button @click="open = !open"
                            class="{{ nav_classes.menu_button }} w-full"
                            :class="collapsed ? 'justify-center' : 'gap-3'"
                            @mouseenter="tooltip = true"
                            @mouseleave="tooltip = false">

                        <div class="flex items-center justify-center flex-shrink-0 w-10 h-10 rounded-xl bg-white/10">
                            <i class="text-lg fas fa-users"></i>
                        </div>

                        <span class="text-sm font-medium nav-text whitespace-nowrap"
                              :class="collapsed ? 'hidden' : 'block'">
                            Recrutements
                        </span>

                        <i class="ml-auto text-xs transition-transform duration-200 fas fa-chevron-down"
                           :class="[collapsed ? 'hidden' : 'block', open ? 'rotate-180' : '']"
                           x-show="!collapsed">
                        </i>

                        <div x-show="collapsed && tooltip"
                             x-cloak
                             class="absolute z-50 px-2 py-1 ml-2 text-xs text-white bg-gray-800 rounded left-full whitespace-nowrap">
                            Recrutements
                        </div>

                    </button>


                    <div x-show="open"
                         x-cloak
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 -translate-y-2"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         :class="collapsed ? 'hidden' : 'block'"
                         class="mt-1 space-y-1">

                        {# Candidatures #}
                        <a href="{{ path('app_candidature_index') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route == 'app_candidature_index' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-list"></i>

                            <span class="nav-text">
                                Candidatures
                            </span>

                        </a>


                        {# Indicateurs #}
                        <a href="{{ path('app_candidature_stat') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route == 'app_candidature_stat' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-chart-bar"></i>

                            <span class="nav-text">
                                Indicateurs
                            </span>

                        </a>


                        {# Impressions #}
                        <a href="{{ path('app_candidature_impressions') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route == 'app_candidature_impressions' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-print"></i>

                            <span class="nav-text">
                                Impressions
                            </span>

                        </a>


                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENT') %}

                            {# Listes admis #}
                            <a href="{{ path(is_granted('ROLE_ADMIN') ? 'app_admis_admin_liste' : 'app_admis_liste') }}"
                               class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route in ['app_admis_admin_liste', 'app_admis_liste'] ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                                <i class="w-4 fas fa-user-check"></i>

                                <span class="nav-text">
                                    Listes Admis
                                </span>

                            </a>


                            {# Admis définitifs #}
                            <a href="{{ path(is_granted('ROLE_ADMIN') ? 'app_admis_index' : 'app_admis_etablissement') }}"
                               class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route in ['app_admis_index', 'app_admis_etablissement'] ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                                <i class="w-4 fas fa-medal"></i>

                                <span class="nav-text">
                                    Admis définitifs
                                </span>

                            </a>

                        {% endif %}

                    </div>

                </div>

            {% endif %}


            {# ==================== INSCRIPTION DÉFINITIVE ==================== #}
            {% if is_granted('ROLE_ENT') and not is_granted('ROLE_ADMIN') %}

                <a href="{{ path('app_admis_inscription') }}"
                   class="{{ nav_classes.base_link }} {{ app.current_route == 'app_admis_inscription' ? nav_classes.active_link : nav_classes.inactive_link }}"
                   :class="collapsed ? 'justify-center' : 'gap-3'"
                   x-data="{ tooltip: false }"
                   @mouseenter="tooltip = true"
                   @mouseleave="tooltip = false">

                    <div class="flex items-center justify-center flex-shrink-0 w-10 h-10 rounded-xl bg-red-500/20">
                        <i class="text-lg text-red-300 fas fa-user-plus"></i>
                    </div>

                    <span class="text-sm font-medium nav-text whitespace-nowrap"
                          :class="collapsed ? 'hidden' : 'block'">
                        Inscription définitive
                    </span>

                    <div x-show="collapsed && tooltip"
                         x-cloak
                         class="absolute z-50 px-2 py-1 ml-2 text-xs text-white bg-gray-800 rounded left-full whitespace-nowrap">
                        Inscription définitive
                    </div>

                </a>

            {% endif %}


            {# ==================== ÉTUDE DE DOSSIER ==================== #}
            {% if is_granted('ROLE_ENT') or is_granted('ROLE_JURY') or is_granted('ROLE_ADMIN') %}

                <a href="{{ path('app_candidature_etude_dossier') }}"
                   class="{{ nav_classes.base_link }} {{ app.current_route == 'app_candidature_etude_dossier' ? nav_classes.active_link : nav_classes.inactive_link }}"
                   :class="collapsed ? 'justify-center' : 'gap-3'"
                   x-data="{ tooltip: false }"
                   @mouseenter="tooltip = true"
                   @mouseleave="tooltip = false">

                    <div class="flex items-center justify-center flex-shrink-0 w-10 h-10 rounded-xl bg-white/10">
                        <i class="text-lg fas fa-folder-open"></i>
                    </div>

                    <span class="text-sm font-medium nav-text whitespace-nowrap"
                          :class="collapsed ? 'hidden' : 'block'">
                        Étude de dossier
                    </span>

                    <div x-show="collapsed && tooltip"
                         x-cloak
                         class="absolute z-50 px-2 py-1 ml-2 text-xs text-white bg-gray-800 rounded left-full whitespace-nowrap">
                        Étude de dossier
                    </div>

                </a>


                {# ==================== PROGRAMMATION (MENU DÉROULANT) ==================== #}
                <div x-data="{ open: {{ app.current_route in ['app_programmation_entretien', 'app_programmation_visite'] ? 'true' : 'false' }}, tooltip: false }">

                    <button @click="open = !open"
                            class="{{ nav_classes.menu_button }} w-full"
                            :class="collapsed ? 'justify-center' : 'gap-3'"
                            @mouseenter="tooltip = true"
                            @mouseleave="tooltip = false">

                        <div class="flex items-center justify-center flex-shrink-0 w-10 h-10 rounded-xl bg-white/10">
                            <i class="text-lg fas fa-calendar-check"></i>
                        </div>

                        <span class="text-sm font-medium nav-text whitespace-nowrap"
                              :class="collapsed ? 'hidden' : 'block'">
                            Programmation
                        </span>

                        <i class="ml-auto text-xs transition-transform duration-200 fas fa-chevron-down"
                           :class="[collapsed ? 'hidden' : 'block', open ? 'rotate-180' : '']"
                           x-show="!collapsed">
                        </i>

                        <div x-show="collapsed && tooltip"
                             x-cloak
                             class="absolute z-50 px-2 py-1 ml-2 text-xs text-white bg-gray-800 rounded left-full whitespace-nowrap">
                            Programmation
                        </div>

                    </button>

                    <div x-show="open"
                         x-cloak
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 -translate-y-2"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         :class="collapsed ? 'hidden' : 'block'"
                         class="mt-1 space-y-1">

                        {# Sous-menu : Entretien de sélection #}
                        <a href="{{ path('app_programmation_entretien') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route == 'app_programmation_entretien' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-microphone-alt"></i>

                            <span class="nav-text">
                                Entretien de sélection
                            </span>

                        </a>

                        {# Sous-menu : Visite médicale #}
                        <a href="{{ path('app_programmation_visite') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route == 'app_programmation_visite' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-heartbeat"></i>

                            <span class="nav-text">
                                Visite médicale
                            </span>

                        </a>

                    </div>

                </div>


                {# ==================== SÉLECTION VISITE MÉDICALE ==================== #}

                {#
                <a href="{{ path('app_selection_visite_medicale') }}"
                   class="{{ nav_classes.base_link }} {{ app.current_route == 'app_selection_visite_medicale' ? nav_classes.active_link : nav_classes.inactive_link }}"
                   :class="collapsed ? 'justify-center' : 'gap-3'"
                   x-data="{ tooltip: false }"
                   @mouseenter="tooltip = true"
                   @mouseleave="tooltip = false">

                    <div class="flex items-center justify-center flex-shrink-0 w-10 h-10 rounded-xl bg-white/10">
                        <i class="text-lg fas fa-heartbeat"></i>
                    </div>

                    <span class="text-sm font-medium nav-text whitespace-nowrap"
                          :class="collapsed ? 'hidden' : 'block'">
                        Visite médicale
                    </span>

                    <div x-show="collapsed && tooltip"
                         x-cloak
                         class="absolute z-50 px-2 py-1 ml-2 text-xs text-white bg-gray-800 rounded left-full whitespace-nowrap">
                        Sélection visite médicale
                    </div>

                </a>
                #}

            {% endif %}


            {# ==================== PARAMÈTRES ==================== #}
            {% if is_granted('ROLE_ADMIN') %}

                <div x-data="{ open: {{ app.current_route starts with 'app_user' or app.current_route starts with 'app_localite' or app.current_route starts with 'app_metier' or app.current_route starts with 'app_etablissement' ? 'true' : 'false' }}, tooltip: false }">

                    <button @click="open = !open"
                            class="{{ nav_classes.menu_button }} w-full"
                            :class="collapsed ? 'justify-center' : 'gap-3'"
                            @mouseenter="tooltip = true"
                            @mouseleave="tooltip = false">

                        <div class="flex items-center justify-center flex-shrink-0 w-10 h-10 rounded-xl bg-white/10">
                            <i class="text-lg fas fa-cog"></i>
                        </div>

                        <span class="text-sm font-medium nav-text whitespace-nowrap"
                              :class="collapsed ? 'hidden' : 'block'">
                            Paramètres
                        </span>

                        <i class="ml-auto text-xs transition-transform duration-200 fas fa-chevron-down"
                           :class="[collapsed ? 'hidden' : 'block', open ? 'rotate-180' : '']"
                           x-show="!collapsed">
                        </i>

                        <div x-show="collapsed && tooltip"
                             x-cloak
                             class="absolute z-50 px-2 py-1 ml-2 text-xs text-white bg-gray-800 rounded left-full whitespace-nowrap">
                            Paramètres
                        </div>

                    </button>


                    <div x-show="open"
                         x-cloak
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 -translate-y-2"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         :class="collapsed ? 'hidden' : 'block'"
                         class="mt-1 space-y-1">

                        {# Utilisateurs #}
                        <a href="{{ path('app_user_index') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route starts with 'app_user' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-user"></i>

                            <span class="nav-text">
                                Utilisateurs
                            </span>

                        </a>


                        {# Localités #}
                        <a href="{{ path('app_localite_index') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route starts with 'app_localite' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-map-marker-alt"></i>

                            <span class="nav-text">
                                Localités
                            </span>

                        </a>


                        {# Métiers #}
                        <a href="{{ path('app_metier_index') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route starts with 'app_metier' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-briefcase"></i>

                            <span class="nav-text">
                                Métiers
                            </span>

                        </a>


                        {# Établissements #}
                        <a href="{{ path('app_etablissement_index') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route starts with 'app_etablissement' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-school"></i>

                            <span class="nav-text">
                                Établissements
                            </span>

                        </a>


                        {# Affectations #}
                        <a href="{{ path('app_etablissement_metier_index') }}"
                           class="flex items-center gap-3 p-2 rounded-lg text-sm transition {{ app.current_route starts with 'app_etablissement_metier' ? nav_classes.active_link : nav_classes.inactive_link }} pl-12">

                            <i class="w-4 fas fa-link"></i>

                            <span class="nav-text">
                                Affectations
                            </span>

                        </a>

                    </div>

                </div>

            {% endif %}


            {# ==================== ESPACE CANDIDAT ==================== #}
            {% if is_granted('ROLE_CANDIDAT')
                and not is_granted('ROLE_ADMIN')
                and not is_granted('ROLE_ENT')
                and not is_granted('ROLE_JURY') %}

                <a href="{{ path('app_candidature_index') }}"
                   class="{{ nav_classes.base_link }} {{ app.current_route starts with 'app_candidature' ? nav_classes.active_link : nav_classes.inactive_link }}"
                   :class="collapsed ? 'justify-center' : 'gap-3'">

                    <div class="flex items-center justify-center flex-shrink-0 w-10 h-10 rounded-xl bg-white/10">
                        <i class="text-lg fas fa-file-alt"></i>
                    </div>

                    <span class="text-sm font-medium nav-text whitespace-nowrap"
                          :class="collapsed ? 'hidden' : 'block'">
                        Ma Candidature
                    </span>

                </a>

            {% endif %}

        </nav>


        {# ==================== VERSION ==================== #}
        <div class="flex-shrink-0 p-3 text-center border-t border-white/10">

            <span class="text-xs text-indigo-300 sidebar-logo-text"
                  :class="collapsed ? 'hidden' : 'inline'">
                Version 1.0.0
            </span>

        </div>

    </div>

</aside>


{# ==================== OVERLAY MOBILE ==================== #}
<div x-show="sidebarOpen"
     x-cloak
     @click="sidebarOpen = false"
     class="fixed inset-0 z-20 bg-black/50 lg:hidden"
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-100"
     x-transition:leave="transition ease-in duration-200"
     x-transition:leave-start="opacity-100"
     x-transition:leave-end="opacity-0">
</div>
