{% extends 'base.html.twig' %}

{% block title %}Inscription candidat | PACTE{% endblock %}

{% block meta %}
{{ parent() }}
<meta name="description" content="Créez votre compte candidat pour postuler au projet de formation PACTE.">
{% endblock %}

{# Définition de la classe CSS réutilisable #}
{% set input_class = 'w-full px-4 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition' %}

{% block body %}
<!-- ==================== MESSAGES ==================== -->
<div class="container mx-auto px-4 mb-6 max-w-4xl">
    {% include 'partials/_flash_messages.html.twig' %}
</div>

<!-- ==================== FORMULAIRE D'INSCRIPTION (WIZARD) ==================== -->
<div class="container mx-auto px-4 pb-16">
    <div class="max-w-4xl mx-auto">
        <!-- Barre de progression -->
        <div class="mb-8">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center">
                    <span class="text-sm font-semibold text-indigo-600" id="step-indicator">Étape 1/4</span>
                    <span class="text-sm text-slate-500 ml-2" id="step-name">Identité</span>
                </div>
                <span class="text-sm text-slate-500" id="progress-percent">25%</span>
            </div>
            <div class="w-full bg-slate-200 rounded-full h-2.5">
                <div class="bg-gradient-to-r from-indigo-600 to-purple-600 h-2.5 rounded-full transition-all duration-300" id="progress-bar" style="width: 25%"></div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
            <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-6 py-4">
                <h2 class="text-xl font-semibold text-white flex items-center">
                    <i class="fas fa-user-plus mr-3"></i>
                    Inscription au projet PACTE
                </h2>
                <p class="text-white/80 text-sm mt-1">Tous les champs marqués d'une * sont obligatoires</p>
            </div>
        
            <div class="p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate', 'id': 'register-form'}}) }}
        
                <!-- Champ caché pour la redirection -->
                {% if redirect is defined and redirect %}
                    <input type="hidden" name="redirect" value="{{ redirect }}">
                {% endif %}

                <!-- ÉTAPE 1 : Identité -->
                <div class="step" id="step1">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Nom -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Nom <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.nom, {
                                'attr': {
                                    'class': input_class ~ ' text-uppercase',
                                    'placeholder': 'Votre nom',
                                    'required': true
                                }
                            }) }}
                        </div>
                        
                        <!-- Prénoms -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Prénoms <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.prenoms, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Vos prénoms',
                                    'required': true
                                }
                            }) }}
                        </div>
                        
                        <!-- Nom de jeune fille -->
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Nom de jeune fille
                            </label>
                            {{ form_widget(form.nomjeunefille, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Si applicable'
                                }
                            }) }}
                        </div>
                        
                        <!-- Sexe -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Sexe <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.sexe, {
                                'attr': {
                                    'class': input_class,
                                    'required': true
                                }
                            }) }}
                        </div>
                        
                        <!-- Situation matrimoniale -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Situation matrimoniale
                            </label>
                            {{ form_widget(form.situationmat, {
                                'attr': {
                                    'class': input_class
                                }
                            }) }}
                        </div>
                    </div>
                </div>
        
                <!-- ÉTAPE 2 : Naissance, nationalité et parents -->
                <div class="step hidden" id="step2">
                    <!-- Naissance et nationalité -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <!-- Date de naissance -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Date de naissance <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.datenaissance, {
                                'attr': {
                                    'class': input_class,
                                    'required': true
                                }
                            }) }}
                        </div>
                        
                        <!-- Lieu de naissance -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Lieu de naissance <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.lieunaissance, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Ville de naissance',
                                    'required': true
                                }
                            }) }}
                        </div>
                        
                        <!-- Nationalité -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Nationalité <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.nationalite, {
                                'attr': {
                                    'class': input_class,
                                    'required': true
                                }
                            }) }}
                        </div>
                        
                        <!-- Numéro d'extrait -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Numéro d'extrait
                            </label>
                            {{ form_widget(form.numextrait, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Numéro de l\'extrait'
                                }
                            }) }}
                        </div>
                    </div>
        
                    <!-- Informations sur les parents -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Nom du père -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Nom du père
                            </label>
                            {{ form_widget(form.nompere, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Nom et prénoms du père'
                                }
                            }) }}
                        </div>
                        
                        <!-- Nom de la mère -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Nom de la mère
                            </label>
                            {{ form_widget(form.nommere, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Nom et prénoms de la mère'
                                }
                            }) }}
                        </div>
                    </div>
                </div>
        
                <!-- ÉTAPE 3 : Résidence et contact -->
                <div class="step hidden" id="step3">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Lieu de résidence -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Lieu de résidence <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.residence, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Votre ville de résidence',
                                    'required': true
                                }
                            }) }}
                        </div>
                        
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Contact <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.contact, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Ex: 0708091011',
                                    'required': true,
                                    'pattern': '[0-9]{10}',
                                    'title': 'Le numéro de téléphone doit contenir exactement 10 chiffres',
                                    'maxlength': '10',
                                    'oninput': "this.value = this.value.replace(/[^0-9]/g, '')"
                                }
                            }) }}
                            <div class="text-xs text-slate-500 mt-1">10 chiffres maximum</div>
                        </div>
                    </div>
                </div>
        
                <!-- ÉTAPE 4 : Identifiants de connexion et validation -->
                <div class="step hidden" id="step4">
                    <!-- Identifiants -->
                    <div class="space-y-4 mb-6">
                        <!-- Email (requis) -->
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Email <span class="text-red-500">*</span>
                            </label>
                            {{ form_widget(form.email, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'exemple@email.com',
                                    'required': true
                                }
                            }) }}
                            <div id="email-error" class="text-sm text-red-500 mt-1 hidden"></div>
                        </div>
                        
                        <!-- Mot de passe et confirmation (requis) -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">
                                    Mot de passe <span class="text-red-500">*</span>
                                </label>
                                {{ form_widget(form.password.first, {
                                    'attr': {
                                        'class': input_class,
                                        'placeholder': '••••••••',
                                        'required': true
                                    }
                                }) }}
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">
                                    Confirmation <span class="text-red-500">*</span>
                                </label>
                                {{ form_widget(form.password.second, {
                                    'attr': {
                                        'class': input_class,
                                        'placeholder': '••••••••',
                                        'required': true
                                    }
                                }) }}
                            </div>
                        </div>
                    </div>
                
                    <!-- Case à cocher -->
                    <div class="p-4 bg-slate-50 rounded-lg">
                        <div class="flex items-start">
                            <input type="checkbox" id="accept" class="mt-1 mr-3" required>
                            <label for="accept" class="text-sm text-slate-600">
                                J'accepte que les informations fournies soient utilisées dans le cadre de ma candidature 
                                et j'atteste sur l'honneur leur exactitude. <span class="text-red-500">*</span>
                            </label>
                        </div>
                    </div>
                </div>
        
                <!-- Boutons de navigation -->
                <div class="flex justify-between items-center pt-6 border-t border-slate-200">
                    <button type="button" id="prev-btn" class="px-6 py-2 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-50 transition disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                        <i class="fas fa-arrow-left mr-2"></i>
                        Précédent
                    </button>
                    
                    <div class="flex gap-3">
                        <button type="button" id="next-btn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
                            Suivant
                            <i class="fas fa-arrow-right ml-2"></i>
                        </button>
                        
                        <button type="submit" id="submit-btn" class="px-8 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold rounded-lg hover:from-indigo-700 hover:to-purple-700 transition transform hover:scale-105 shadow-lg hidden">
                            <span class="spinner-border spinner-border-sm hidden mr-2" id="spinner"></span>
                            <i class="fas fa-check-circle mr-2"></i>
                            Finaliser l'inscription
                        </button>
                    </div>
                </div>
        
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- Lien retour accueil et retour page précédente -->
    <div class="text-center mt-4 space-y-2">
        {% if redirect is defined and redirect %}
            <a href="{{ redirect }}" class="text-sm text-slate-500 hover:text-indigo-600 transition inline-flex items-center mr-4">
                <i class="fas fa-arrow-left mr-1"></i>
                Retour à la page précédente
            </a>
        {% endif %}
        <a href="{{ path('app_home') }}" class="text-sm text-slate-500 hover:text-indigo-600 transition inline-flex items-center">
            <i class="fas fa-home mr-1"></i>
            Retour à l'accueil
        </a>
    </div>
</div>

<!-- ==================== JAVASCRIPT ==================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('register-form');
    const steps = document.querySelectorAll('.step');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const submitBtn = document.getElementById('submit-btn');
    const stepIndicator = document.getElementById('step-indicator');
    const stepName = document.getElementById('step-name');
    const progressBar = document.getElementById('progress-bar');
    const progressPercent = document.getElementById('progress-percent');
    const spinner = document.getElementById('spinner');
    const emailInput = document.getElementById('{{ form.email.vars.id }}');
    const emailError = document.getElementById('email-error');
    
    const stepNames = ['Identité', 'Naissance & Parents', 'Contact', 'Connexion'];
    let currentStep = 0;
    const totalSteps = steps.length;

    // Fonction pour mettre à jour l'affichage des étapes
    function updateSteps() {
        steps.forEach((step, index) => {
            if (index === currentStep) {
                step.classList.remove('hidden');
            } else {
                step.classList.add('hidden');
            }
        });

        prevBtn.disabled = currentStep === 0;
        
        if (currentStep === totalSteps - 1) {
            nextBtn.classList.add('hidden');
            submitBtn.classList.remove('hidden');
        } else {
            nextBtn.classList.remove('hidden');
            submitBtn.classList.add('hidden');
        }

        stepIndicator.textContent = `Étape ${currentStep + 1}/${totalSteps}`;
        stepName.textContent = stepNames[currentStep];
        
        const progress = ((currentStep + 1) / totalSteps) * 100;
        progressBar.style.width = `${progress}%`;
        progressPercent.textContent = `${Math.round(progress)}%`;
    }

    // Validation de l'étape courante
    function validateStep(step) {
        const currentStepElement = steps[step];
        const requiredFields = currentStepElement.querySelectorAll('input[required], select[required]');
        let isValid = true;

        requiredFields.forEach(field => {
            if (!field.value.trim()) {
                field.classList.add('border-red-500', 'focus:ring-red-500');
                isValid = false;
            } else {
                field.classList.remove('border-red-500', 'focus:ring-red-500');
            }
        });

        // Validation spécifique pour l'étape 4 (email et mot de passe)
        if (step === 3) { // Dernière étape (index 3)
            const password = document.getElementById('{{ form.password.first.vars.id }}');
            const confirm = document.getElementById('{{ form.password.second.vars.id }}');
            
            if (password.value !== confirm.value) {
                alert('Les mots de passe ne correspondent pas.');
                password.classList.add('border-red-500', 'focus:ring-red-500');
                confirm.classList.add('border-red-500', 'focus:ring-red-500');
                isValid = false;
            }
            
            if (password.value.length < 6) {
                alert('Le mot de passe doit contenir au moins 6 caractères.');
                password.classList.add('border-red-500', 'focus:ring-red-500');
                isValid = false;
            }
        }

        if (!isValid) {
            alert('Veuillez remplir tous les champs obligatoires.');
        }

        return isValid;
    }

    // Navigation suivante - blocked because registration is closed
    nextBtn.addEventListener('click', function() {
        // Show modal instead of proceeding
        document.getElementById('registration-closed-modal').classList.remove('hidden');
    });

    // Navigation précédente
    prevBtn.addEventListener('click', function() {
        if (currentStep > 0) {
            currentStep--;
            updateSteps();
        }
    });

    // Vérification email unique
    if (emailInput) {
        emailInput.addEventListener('blur', function() {
            const email = this.value;
            if (email && email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
                fetch('/user/email/' + encodeURIComponent(email))
                    .then(response => response.json())
                    .then(data => {
                        if (data.exists) {
                            emailError.textContent = 'Cet email est déjà utilisé. Veuillez vous connecter ou utiliser une autre adresse.';
                            emailError.classList.remove('hidden');
                            emailInput.classList.add('border-red-500', 'focus:ring-red-500');
                        } else {
                            emailError.classList.add('hidden');
                            emailInput.classList.remove('border-red-500', 'focus:ring-red-500');
                        }
                    })
                    .catch(error => console.error('Erreur:', error));
            }
        });
    }

    // Animation du spinner au submit
    form.addEventListener('submit', function(e) {
        // Vérification finale avant soumission
        if (!validateStep(currentStep)) {
            e.preventDefault();
            return;
        }
        
        spinner.classList.remove('hidden');
        submitBtn.disabled = true;
    });

    // Animation des champs au focus
    const inputs = document.querySelectorAll('input, select');
    inputs.forEach(input => {
        input.addEventListener('focus', function() {
            this.classList.add('ring-2', 'ring-indigo-300');
        });
        input.addEventListener('blur', function() {
            this.classList.remove('ring-2', 'ring-indigo-300');
        });
    });

    // Initialisation
    updateSteps();
    // Close modal
    document.getElementById('modal-close-btn').addEventListener('click', function() {
        document.getElementById('registration-closed-modal').classList.add('hidden');
    });
    // Close when clicking outside the modal content
    document.getElementById('registration-closed-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.add('hidden');
        }
    });
});
</script>

<style>
/* Style pour le texte en majuscules */
.text-uppercase {
    text-transform: uppercase;
}

/* Animation de pulsation pour le bouton désactivé */
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}
button[type="submit"]:disabled {
    animation: pulse 1.5s infinite;
    cursor: not-allowed;
}

/* Transition fluide */
.step {
    transition: opacity 0.3s ease-in-out;
}
</style>
{# Modal for registration closed #}
<div id="registration-closed-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-gray-600 bg-opacity-50 overflow-x-hidden overflow-y-auto">
  <div class="relative w-full max-w-2xl max-h-full">
    <div class="relative bg-white rounded-lg shadow">
      <div class="flex items-start p-6">
        <div class="flex-shrink-0">
          <i class="fas fa-exclamation-circle text-4xl text-indigo-600"></i>
        </div>
        <div class="ml-4 w-0 flex-1 space-y-2">
          <h3 class="text-lg font-medium text-gray-900">Inscription fermée</h3>
          <p class="text-sm text-gray-500">
            La période d'inscription pour déposer une candidature est terminée. Vous ne pouvez plus créer de compte pour cette session.
          </p>
          <div class="mt-4 flex items-center justify-end">
            <button type="button" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" id="modal-close-btn">
              Fermer
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}