{% extends 'base.html.twig' %}

{% block title %}Accès réservé | {{ parent() }}{% endblock %}

{% block body %}
<main class="min-h-[calc(100vh-10rem)] bg-slate-50 px-4 py-16 sm:py-24">
    <div class="mx-auto flex max-w-2xl items-center justify-center">
        <section class="w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60">
            <div class="bg-gradient-to-br from-indigo-700 via-indigo-600 to-blue-700 px-6 py-10 text-center sm:px-12">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white/15 text-3xl text-white ring-1 ring-white/30">
                    <i class="fas fa-lock"></i>
                </div>
                <p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-indigo-100">Espace sécurisé PACTE</p>
                <h1 class="mt-3 text-2xl font-extrabold text-white sm:text-3xl">Accès réservé</h1>
            </div>

            <div class="px-6 py-8 text-center sm:px-12 sm:py-10">
                <p class="text-lg font-semibold text-slate-800">Désolé, cette page est réservée aux utilisateurs autorisés.</p>
                <p class="mt-3 leading-7 text-slate-500">Veuillez vous connecter avec votre compte ou créer un compte candidat pour accéder à la plateforme.</p>

                <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
                    <a href="{{ path('app_login', {redirect: app.request.uri}) }}" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700">
                        <i class="fas fa-sign-in-alt"></i>
                        Se connecter
                    </a>
                    <a href="{{ path('app_home') }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 px-5 py-3 text-sm font-bold text-slate-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700">
                        <i class="fas fa-home"></i>
                        Retour à l’accueil
                    </a>
                </div>

                {% if not app.user %}
                    <p class="mt-6 text-sm text-slate-500">Pas encore de compte ? <a href="{{ path('app_register') }}" class="font-semibold text-indigo-600 hover:text-indigo-800">Créer un compte</a></p>
                {% endif %}
            </div>
        </section>
    </div>
</main>
{% endblock %}