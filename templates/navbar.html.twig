<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm"
     x-data="{ profileOpen: false }">
  <div class="flex items-center justify-between h-16 px-4 lg:px-6">

    <div class="flex items-center gap-3">
      <button id="sidebarToggle"
              class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-indigo-600 transition focus:outline-none focus:ring-2 focus:ring-indigo-400"
              aria-label="Toggle sidebar">
        <i class="fas fa-bars text-base"></i>
      </button>

      <div class="hidden md:flex items-center gap-2">
        {% set route = app.request.attributes.get('_route') %}

      {% set routeMap = {
        'app_dashboard':                    {'icon': 'chart-line',        'label': 'Tableau de bord'},
        'app_candidature_index':            {'icon': 'file-alt',          'label': 'Candidatures'},
        'app_candidature_new':              {'icon': 'plus-circle',       'label': 'Nouvelle candidature'},
        'app_candidature_edit':             {'icon': 'pen',               'label': 'Modifier une candidature'},
        'app_candidature_stat':             {'icon': 'chart-bar',         'label': 'Statistiques'},
        'app_candidature_impressions':      {'icon': 'download',          'label': 'Exports & Impressions'},
        'app_user_index':                   {'icon': 'users',             'label': 'Utilisateurs'},
        'app_user_new':                     {'icon': 'user-plus',         'label': 'Nouvel utilisateur'},
        'app_user_edit':                    {'icon': 'user-edit',         'label': 'Mon profil'},
        'app_user_change_password':         {'icon': 'key',               'label': 'Changer le mot de passe'},
        'app_etablissement_index':          {'icon': 'school',            'label': 'Établissements'},
        'app_etablissement_new':            {'icon': 'plus-circle',       'label': 'Nouvel établissement'},
        'app_etablissement_edit':           {'icon': 'building',          'label': 'Mon établissement'},
        'app_metier_index':                 {'icon': 'briefcase',         'label': 'Métiers'},
        'app_metier_new':                   {'icon': 'plus-circle',       'label': 'Nouveau métier'},
        'app_localite_index':               {'icon': 'map-marker-alt',    'label': 'Localités'},
        'app_admis_index':                  {'icon': 'user-graduate',     'label': 'Inscriptions définitives'},
        'app_admis_new':                    {'icon': 'user-plus',         'label': 'Nouvelle inscription'},
        'app_admis_search':                 {'icon': 'search',            'label': 'Recherche candidat'},
      } %}

      {% if routeMap[route] is defined %}
        {% set page = routeMap[route] %}
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100/70 border border-slate-200/60">
          <i class="fas fa-{{ page.icon }} text-indigo-500 text-xs"></i>
          <span class="text-sm font-semibold text-slate-700">{{ page.label }}</span>
        </div>
      {% else %}
        {% set fallback = route|replace({'app_': '', '_': ' '})|title %}
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100/70 border border-slate-200/60">
          <i class="fas fa-circle-dot text-indigo-400 text-xs"></i>
          <span class="text-sm font-semibold text-slate-600">{{ fallback }}</span>
        </div>
      {% endif %}
      </div>
    </div>

    <div class="flex items-center gap-3">
      {# ==================== SÉLECTEUR DE VAGUE DE RECRUTEMENT ==================== #}
      {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENT') or is_granted('ROLE_JURY') %}
        {% set sessions_consultables = session_context.sessions %}
        {% if sessions_consultables|length > 0 %}
          <form method="get" action="{{ app.request.pathInfo }}" class="m-0 flex items-center">
            <div class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-slate-100/80 border border-slate-200/80 hover:border-indigo-300 hover:bg-indigo-50/50 transition group shadow-sm">
              <span class="flex items-center justify-center w-6 h-6 rounded-lg bg-indigo-100 text-indigo-600 shrink-0">
                <i class="fas fa-layer-group text-xs"></i>
              </span>
              <div class="flex flex-col text-left">
                <span class="text-[9px] font-bold uppercase tracking-wider text-slate-400 group-hover:text-indigo-600 transition leading-none">Vague</span>
                <select id="select-session" name="session" onchange="this.form.submit()"
                        class="bg-transparent text-xs font-bold text-slate-800 border-0 p-0 pr-4 focus:ring-0 cursor-pointer -mt-0.5">
                  {% for s in sessions_consultables %}
                    <option value="{{ s.id }}" {{ session_context.currentSession and session_context.currentSession.id == s.id ? 'selected' : '' }}>
                      {{ s.nom }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            </div>
          </form>
        {% endif %}
      {% endif %}

      {% if app.user %}
      {% set userFullName = (app.user.nom or app.user.prenoms) ? ((app.user.nom ~ ' ' ~ app.user.prenoms)|trim) : app.user.email %}
      {% set userInitials = (app.user.nom or app.user.prenoms) ? ((app.user.nom|first|upper) ~ (app.user.prenoms|first|upper)) : (app.user.email|first|upper) %}
      <div class="relative">
      <button @click="profileOpen = !profileOpen"
              class="flex items-center gap-2.5 pl-1.5 pr-2.5 py-1.5 rounded-xl hover:bg-slate-100 transition focus:outline-none focus:ring-2 focus:ring-indigo-400"
              :class="{ 'bg-slate-100': profileOpen }">

        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-xs shrink-0 shadow-sm">
          {{ userInitials }}
        </div>

        <div class="hidden lg:flex flex-col items-start leading-tight">
          <span class="text-sm font-semibold text-slate-800">{{ userFullName }}</span>
          <span class="text-[10px] text-slate-400">{{ app.user.email }}</span>
        </div>

        <span class="hidden lg:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wide
          {% if is_granted('ROLE_ADMIN') %}bg-red-100 text-red-700
          {% elseif is_granted('ROLE_ENT') %}bg-amber-100 text-amber-700
          {% elseif is_granted('ROLE_JURY') %}bg-blue-100 text-blue-700
          {% else %}bg-emerald-100 text-emerald-700{% endif %}">
          {% if is_granted('ROLE_ADMIN') %}Admin
          {% elseif is_granted('ROLE_ENT') %}ENT
          {% elseif is_granted('ROLE_JURY') %}Jury
          {% else %}Candidat{% endif %}
        </span>

        <i class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"
           :class="{ 'rotate-180': profileOpen }"></i>
      </button>

      <div x-show="profileOpen"
           x-cloak
           x-transition:enter="transition ease-out duration-200"
           x-transition:enter-start="opacity-0 translate-y-1 scale-95"
           x-transition:enter-end="opacity-100 translate-y-0 scale-100"
           x-transition:leave="transition ease-in duration-150"
           x-transition:leave-start="opacity-100 translate-y-0 scale-100"
           x-transition:leave-end="opacity-0 translate-y-1 scale-95"
           @click.outside="profileOpen = false"
           class="absolute right-0 mt-2 w-60 bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden">

        <div class="px-4 py-4 bg-gradient-to-r from-indigo-50 to-purple-50 border-b border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm shadow-sm shrink-0">
              {{ userInitials }}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-bold text-slate-800 truncate">{{ userFullName }}</p>
              <p class="text-xs text-slate-400 truncate mt-0.5">{{ app.user.email }}</p>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold mt-1.5
                {% if is_granted('ROLE_ADMIN') %}bg-red-100 text-red-700
                {% elseif is_granted('ROLE_ENT') %}bg-amber-100 text-amber-700
                {% elseif is_granted('ROLE_JURY') %}bg-blue-100 text-blue-700
                {% else %}bg-emerald-100 text-emerald-700{% endif %}">
                {% if is_granted('ROLE_ADMIN') %}Administrateur
                {% elseif is_granted('ROLE_ENT') %}Établissement
                {% elseif is_granted('ROLE_JURY') %}Jury
                {% else %}Candidat{% endif %}
              </span>
            </div>
          </div>
        </div>

        <div class="py-1">
          <a href="{{ path('app_user_edit', {'id': app.user.id}) }}"
             class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-600 hover:bg-indigo-50 hover:text-indigo-700 transition group">
            <div class="w-7 h-7 rounded-lg bg-slate-100 group-hover:bg-indigo-100 flex items-center justify-center transition">
              <i class="fas fa-user-circle text-slate-400 group-hover:text-indigo-600 text-xs transition"></i>
            </div>
            <span class="font-medium">Mon profil</span>
          </a>

          <a href="{{ path('app_user_change_password') }}"
             class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-600 hover:bg-indigo-50 hover:text-indigo-700 transition group">
            <div class="w-7 h-7 rounded-lg bg-slate-100 group-hover:bg-indigo-100 flex items-center justify-center transition">
              <i class="fas fa-key text-slate-400 group-hover:text-indigo-600 text-xs transition"></i>
            </div>
            <span class="font-medium">Changer le mot de passe</span>
          </a>
        </div>

        <div class="border-t border-slate-100 mx-2"></div>

        <div class="py-1">
          <a href="{{ path('app_logout') }}"
             class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-500 hover:bg-red-50 hover:text-red-700 transition group">
            <div class="w-7 h-7 rounded-lg bg-red-50 group-hover:bg-red-100 flex items-center justify-center transition">
              <i class="fas fa-sign-out-alt text-red-400 text-xs"></i>
            </div>
            <span class="font-medium">Déconnexion</span>
          </a>
        </div>

      </div>
    </div>
    {% endif %}

    </div>

  </div>
</nav>

<div class="h-16"></div>
<style>[x-cloak]{display:none!important}</style>
