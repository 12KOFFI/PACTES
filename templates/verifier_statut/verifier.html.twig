{% extends 'base.html.twig' %}

{% block title %}Vérification de statut | PACTE{% endblock %}

{% block body %}

{# ==================== PERMISSIONS D'ACCÈS AUX ONGLETS ==================== #}
{% set peutVoirTest      = true %}
{% set peutVoirVisite    = candidature is not null and candidature.etustatut in [1, 2] %}
{% set peutVoirAdmission = candidature is not null
    and candidature.etustatut == 2
    and candidature.decisionJury == 2
    and candidature.visstatut in [1, 2] %}

<div class="min-h-screen py-12 bg-gradient-to-br from-indigo-50 via-white to-purple-50 sm:py-20"
     x-data="{
        tab: 'test',
        allowedTabs: [
            {% if peutVoirTest %}'test',{% endif %}
            {% if peutVoirVisite %}'visite',{% endif %}
            {% if peutVoirAdmission %}'admission',{% endif %}
        ],
        setTab(newTab) {
            if (this.allowedTabs.includes(newTab)) this.tab = newTab;
        }
     }"
     x-init="if (!allowedTabs.includes(tab)) tab = allowedTabs[0] ?? 'test'">

    <div class="container max-w-4xl px-4 mx-auto">

        {# ==================== EN-TÊTE ==================== #}
        <div class="mb-8 text-center">
            <div class="inline-flex items-center justify-center w-20 h-20 mb-4 rounded-full shadow-lg bg-gradient-to-br from-indigo-100 to-purple-100">
                <i class="text-3xl text-indigo-600 fas fa-user-check"></i>
            </div>
            <h1 class="mb-3 text-3xl font-bold sm:text-4xl text-slate-900">
                Vérification de statut
            </h1>
            <p class="max-w-2xl mx-auto text-base text-slate-600 sm:text-lg">
                Saisissez votre numéro de candidature ou votre adresse email pour vérifier votre statut à chaque étape du recrutement.
            </p>
        </div>

        {# ==================== BOUTON GUIDE ==================== #}
        <div class="mb-6 text-center">
            <button type="button"
                    onclick="openGuideModal()"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-indigo-600 font-semibold rounded-xl border border-indigo-200 shadow-sm hover:bg-indigo-50 hover:border-indigo-300 transition transform hover:scale-[1.02]">
                <i class="fas fa-lightbulb"></i>
                Comment vérifier mon statut ?
            </button>
        </div>

        {# ==================== FORMULAIRE DE RECHERCHE ==================== #}
        <div class="mb-8 overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
            <div class="p-6 sm:p-8">
                <form method="get" action="{{ path('app_verifier_statut') }}" class="space-y-4">
                    <div>
                        <label for="recherche" class="block mb-2 text-sm font-medium text-slate-700">
                            Numéro de candidature ou adresse email <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                                <i class="fas fa-search text-slate-400"></i>
                            </div>
                            <input type="text"
                                   id="recherche"
                                   name="recherche"
                                   value="{{ recherche|default('') }}"
                                   required
                                   placeholder="Ex: DK26010001 ou exemple@email.com"
                                   class="w-full py-3 pr-4 transition border pl-11 rounded-xl border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-slate-800 placeholder-slate-400">
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold rounded-xl hover:from-indigo-700 hover:to-purple-700 transition transform hover:scale-[1.02] shadow-lg">
                        <i class="fas fa-search"></i>
                        Vérifier mon statut
                    </button>

                    {% if recherche is not empty %}
                        <div class="pt-2 text-center">
                            <a href="{{ path('app_verifier_statut') }}"
                               class="inline-flex items-center gap-2 px-5 py-2 text-sm font-semibold transition rounded-lg text-slate-600 bg-slate-100 hover:bg-slate-200">
                                <i class="fas fa-redo"></i>
                                Nouvelle recherche
                            </a>
                        </div>
                    {% endif %}
                </form>

                {% if erreur %}
                    <div class="flex items-start gap-3 p-4 mt-6 text-sm text-red-700 border border-red-200 rounded-xl bg-red-50">
                        <i class="fas fa-exclamation-circle mt-0.5 flex-shrink-0"></i>
                        <p>{{ erreur }}</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# ==================== RÉSULTAT ==================== #}
        {% if candidature is not null %}

            {# Récapitulatif candidat #}
            <div class="p-5 mb-6 bg-white border shadow-lg rounded-2xl border-slate-200">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="text-xs tracking-wide uppercase text-slate-400">Candidat</p>
                        <p class="font-semibold text-slate-800">
                            {{ candidature.user ? (candidature.user.nom ~ ' ' ~ candidature.user.prenoms)|trim : '-' }}
                        </p>
                    </div>
                    <div>
                        <p class="text-xs tracking-wide uppercase text-slate-400">Numéro</p>
                        <p class="font-mono font-semibold text-indigo-600">{{ candidature.numero }}</p>
                    </div>
                    <div>
                        <p class="text-xs tracking-wide uppercase text-slate-400">Métier</p>
                        <p class="font-semibold text-slate-800">{{ candidature.metier ? candidature.metier.nom : '-' }}</p>
                    </div>
                </div>
            </div>

            {# ==================== ONGLETS ==================== #}
            <div class="overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">

                {# Navigation des onglets #}
                <div class="border-b border-slate-200 bg-slate-50">
                    <nav class="flex flex-wrap -mb-px">
                        {# ----- ONGLET TEST (toujours accessible) ----- #}
                        <button @click="setTab('test')"
                                :class="tab === 'test' ? 'border-indigo-600 text-indigo-600 bg-white' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'"
                                class="flex-1 min-w-[140px] py-4 px-4 text-center font-medium text-sm border-b-2 transition">
                            <i class="mr-2 fas fa-file-alt"></i>
                            Test de sélection
                        </button>

                        {# ----- ONGLET VISITE MÉDICALE (si etustatut = 2) ----- #}
                        {% if peutVoirVisite %}
                        <button @click="setTab('visite')"
                                :class="tab === 'visite' ? 'border-teal-600 text-teal-600 bg-white' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'"
                                class="flex-1 min-w-[140px] py-4 px-4 text-center font-medium text-sm border-b-2 transition">
                            <i class="mr-2 fas fa-heartbeat"></i>
                            Visite médicale
                        </button>
                        {% endif %}

                        {# ----- ONGLET ADMISSION FINALE (si decisionJury = 2 ET visstatut = 2) ----- #}
                        {% if peutVoirAdmission %}
                        <button @click="setTab('admission')"
                                :class="tab === 'admission' ? 'border-purple-600 text-purple-600 bg-white' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'"
                                class="flex-1 min-w-[140px] py-4 px-4 text-center font-medium text-sm border-b-2 transition">
                            <i class="mr-2 fas fa-graduation-cap"></i>
                            Admission finale
                        </button>
                        {% endif %}
                    </nav>
                </div>

                <div class="p-6 sm:p-8">

                    {# ============================================ #}
                    {# ONGLET 1 : TEST DE SÉLECTION                 #}
                    {# ============================================ #}
                    <div x-show="tab === 'test'" x-cloak>

                        {% if candidature.etustatut == 2 and candidature.entdate and candidature.jury %}
                            {# ✅ ÉLIGIBLE AU TEST #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 bg-green-100 rounded-full">
                                <i class="text-3xl text-green-600 fas fa-check-circle"></i>
                            </div>
                            <h2 class="mb-3 text-2xl font-bold text-center text-green-700">Félicitations !</h2>
                            <p class="mb-6 text-base leading-relaxed text-center text-slate-700">
                                Vous êtes <strong class="text-xl text-green-700">éligible</strong> pour les tests de sélection. </br>
                                Téléchargez et imprimez votre convocation, puis présentez-vous à la date et à l'heure indiquées.
                            </p>
                            <div class="p-5 mb-6 space-y-3 bg-slate-50 rounded-xl">
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Date de l'entretien</span>
                                    <span class="font-semibold text-slate-800">{{ candidature.entdate|date('d/m/Y') }}</span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Heure</span>
                                    <span class="font-semibold text-slate-800">
                                        {% if candidature.creneauEntretien == 2 or candidature.entdate|date('H') >= 13 %}
                                            13h00 - 15h00 (Créneau 2)
                                        {% else %}
                                            08h00 - 12h00 (Créneau 1)
                                        {% endif %}
                                    </span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Jury</span>
                                    <span class="font-semibold text-slate-800">{{ candidature.jury ? 'Jury ' ~ candidature.jury : '-' }}</span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Lieu</span>
                                    <span class="font-semibold text-slate-800">{{ candidature.entlieu ?? (candidature.etablissement ? candidature.etablissement.nom : '-') }}</span>
                                </div>
                            </div>
                            <a href="{{ path('app_candidature_imprimer_convocation', {'id': candidature.id, 'token': candidature.numero}) }}"
                               target="_blank"
                               class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white font-semibold rounded-xl hover:from-green-700 hover:to-emerald-700 transition transform hover:scale-[1.02] shadow-lg">
                                <i class="fas fa-file-pdf"></i>
                                Télécharger ma convocation
                            </a>

                        {% elseif candidature.etustatut == 2 %}
                            {# ⏳ ÉLIGIBLE MAIS PAS PROGRAMMÉ #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-full bg-amber-100">
                                <i class="text-3xl fas fa-clock text-amber-600"></i>
                            </div>
                            <h2 class="mb-3 text-xl font-bold text-center text-amber-700">Programmation en cours</h2>
                            <p class="text-center text-slate-600">
                                Votre dossier a été accepté. La programmation de votre entretien est en cours.
                                Revenez plus tard pour télécharger votre convocation.
                            </p>

                        {% elseif candidature.etustatut == 1 %}
                            {# ❌ REJETÉ #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full">
                                <i class="text-3xl text-red-600 fas fa-times-circle"></i>
                            </div>
                            <h2 class="mb-3 text-xl font-bold text-center text-red-700">Candidature non retenue</h2>
                            <p class="text-center text-slate-600">
                                Après étude de votre dossier, votre candidature n'a pas été retenue pour les tests de sélection. </br>
                                Nous vous remercions pour votre intérêt.
                            </p>

                        {% else %}
                            {# ⏳ EN ATTENTE D'ÉTUDE #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100">
                                <i class="text-3xl fas fa-hourglass-half text-slate-500"></i>
                            </div>
                            <h2 class="mb-3 text-xl font-bold text-center text-slate-700">Candidature en cours d'étude</h2>
                            <p class="text-center text-slate-600">
                                Votre dossier est actuellement en cours d'analyse.
                                Vous serez informé(e) dès que l'étude sera terminée.
                            </p>
                        {% endif %}
                    </div>

                    {# ============================================ #}
                    {# ONGLET 2 : VISITE MÉDICALE                  #}
                    {# ============================================ #}
                    {% if peutVoirVisite %}
                    <div x-show="tab === 'visite'" x-cloak>

                        {% if candidature.decisionJury == 2 %}
                            {# ✅ ADMISSIBLE POUR LA VISITE MÉDICALE #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 bg-teal-100 rounded-full">
                                <i class="text-3xl text-teal-600 fas fa-check-circle"></i>
                            </div>
                            <h2 class="mb-3 text-2xl font-bold text-center text-teal-700">Félicitations !</h2>
                            <p class="mb-6 text-base leading-relaxed text-center text-slate-700">
                                Vous êtes <strong class="text-xl text-teal-700">admissible</strong> pour la visite médicale. </br>
                                Veuillez vous préparer pour passer la visite médicale d'aptitude.
                            </p>
                            <div class="p-5 mb-6 space-y-3 bg-slate-50 rounded-xl">
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Statut</span>
                                    <span class="inline-flex items-center px-3 py-1 text-xl font-semibold text-teal-700 bg-teal-100 rounded-full">
                                        Admissible pour la visite médicale
                                    </span>
                                </div>
                                {% if candidature.visdate %}
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Date de la visite</span>
                                    <span class="font-semibold text-slate-800">{{ candidature.visdate|date('d/m/Y à H:i') }}</span>
                                </div>
                                {% endif %}
                                {% if candidature.vislieu %}
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Lieu</span>
                                    <span class="font-semibold text-slate-800">{{ candidature.vislieu }}</span>
                                </div>
                                {% endif %}
                            </div>

                            {% if candidature.visdate and candidature.vislieu %}
                                <a href="{{ path('app_candidature_imprimer_convocation_visite', {'id': candidature.id, 'token': candidature.numero}) }}"
                                   target="_blank"
                                   class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-teal-600 to-emerald-600 text-white font-semibold rounded-xl hover:from-teal-700 hover:to-emerald-700 transition transform hover:scale-[1.02] shadow-lg">
                                    <i class="fas fa-file-pdf"></i>
                                    Télécharger ma convocation visite médicale
                                </a>
                            {% else %}
                                <div class="p-4 text-sm border rounded-xl bg-amber-50 border-amber-200 text-amber-800">
                                    <i class="mr-2 fas fa-clock"></i>
                                    La programmation de votre visite médicale est en cours. Revenez plus tard pour télécharger votre convocation.
                                </div>
                            {% endif %}

                        {% elseif candidature.decisionJury == 1 %}
                            {# ❌ NON RETENU(E) POUR LA VISITE MÉDICALE #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full">
                                <i class="text-3xl text-red-600 fas fa-times-circle"></i>
                            </div>
                            <h2 class="mb-3 text-2xl font-bold text-center text-red-700">
                                Désolé, vous n'êtes pas retenu(e) !
                            </h2>
                            <p class="mb-6 text-base leading-relaxed text-center text-slate-700">
                                Après délibération, vous n'avez <strong class="text-xl text-red-700">pas été retenu(e)</strong>
                                pour la visite médicale. </br>
                                Nous vous remercions pour votre participation et vous souhaitons bonne chance pour la suite.
                            </p>

                        {% else %}
                            {# ⏳ EN ATTENTE #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100">
                                <i class="text-3xl fas fa-hourglass-half text-slate-500"></i>
                            </div>
                            <h2 class="mb-3 text-xl font-bold text-center text-slate-700">Résultats en attente</h2>
                            <p class="text-center text-slate-600">
                                Les résultats de l'entretien ne sont pas encore disponibles.
                                Revenez plus tard pour vérifier votre admissibilité à la visite médicale.
                            </p>
                        {% endif %}
                    </div>
                    {% endif %}

                    {# ============================================ #}
                    {# ONGLET 3 : ADMISSION DÉFINITIVE             #}
                    {# ============================================ #}
                    {% if peutVoirAdmission %}
                    <div x-show="tab === 'admission'" x-cloak>

                        {% if candidature.resultat == 2 %}
                            {# ✅ ADMIS DÉFINITIF #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 bg-purple-100 rounded-full">
                                <i class="text-3xl text-purple-600 fas fa-graduation-cap"></i>
                            </div>
                            <h2 class="mb-3 text-2xl font-bold text-center text-purple-700">
                                Félicitations, vous êtes admis(e) !
                            </h2>
                            <p class="mb-6 text-base leading-relaxed text-center text-slate-700">
                                Vous êtes <strong class="text-xl text-purple-700">admis(e) définitivement</strong> à la formation
                                d'installateur de systèmes solaires photovoltaïques.
                            </p>
                            <div class="p-5 mb-6 space-y-3 bg-slate-50 rounded-xl">
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Statut</span>
                                    <span class="inline-flex items-center px-3 py-1 text-xl font-semibold text-purple-700 bg-purple-100 rounded-full">
                                        Admis définitif
                                    </span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Établissement</span>
                                    <span class="font-semibold text-slate-800">{{ candidature.etablissement ? candidature.etablissement.nom : '-' }}</span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Métier</span>
                                    <span class="font-semibold text-slate-800">{{ candidature.metier ? candidature.metier.nom : '-' }}</span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-500">Cohorte de formation</span>
                                    <span class="font-semibold text-slate-800">
                                        {% if candidature.cohorte is not null %}
                                            VOUS ÊTES AFFECTÉ À LA COHORTE 
                                            <span class="inline-flex items-center px-3 py-1 text-xl font-semibold text-purple-700 bg-purple-100 rounded-full"> {{ candidature.cohorte }}</span>
                                        {% else %}
                                            Non précisée
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                            <div class="p-4 text-sm text-center text-purple-800 border border-purple-200 rounded-xl bg-purple-50">
                                <i class="mr-2 fas fa-envelope"></i>
                                Veuillez prendre contact avec votre établissement pour finaliser votre inscription définitive.
                            </div>

                        {% elseif candidature.resultat == 1 %}
                            {# ❌ NON ADMIS #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full">
                                <i class="text-3xl text-red-600 fas fa-times-circle"></i>
                            </div>
                            <h2 class="mb-3 text-xl font-bold text-center text-red-700">Désolé, vous n'êtes pas Admis(e) !</h2>
                            <p class="text-center text-slate-600">
                                Après délibération finale, vous n'êtes pas retenu(e) pour cette session. </br>
                                Nous vous remercions pour votre participation et vous souhaitons bonne chance pour la suite.
                            </p>

                        {% elseif candidature.visstatut == 2 %}
                            {# ⏳ VISITE MÉDICALE EFFECTUÉE — DÉLIBÉRATION FINALE EN COURS #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-full bg-amber-100">
                                <i class="text-3xl fas fa-hourglass-half text-amber-600"></i>
                            </div>
                            <h2 class="mb-3 text-xl font-bold text-center text-amber-700">Délibération en cours</h2>
                            <p class="text-center text-slate-600">
                                Vous avez passé la visite médicale avec succès. </br>
                                La délibération finale est en cours : revenez plus tard pour connaître votre admission définitive.
                            </p>

                        {% else %}
                            {# ⏳ EN ATTENTE — PAS ENCORE ADMISSIBLE #}
                            <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100">
                                <i class="text-3xl fas fa-hourglass-half text-slate-500"></i>
                            </div>
                            <h2 class="mb-3 text-xl font-bold text-center text-slate-700">Résultats finaux en attente</h2>
                            <p class="text-center text-slate-600">
                                Les résultats finaux ne sont pas encore disponibles. </br>
                                Revenez plus tard pour vérifier votre admission définitive.
                            </p>
                        {% endif %}
                    </div>
                    {% endif %}

                </div>
            </div>

        {% endif %}

        {# Lien retour #}
        <div class="mt-8 text-center">
            <a href="{{ path('app_home') }}"
               class="inline-flex items-center gap-2 text-sm font-medium text-indigo-600 transition hover:text-indigo-700">
                <i class="fas fa-arrow-left"></i>
                Retour à l'accueil
            </a>
        </div>
    </div>
</div>

{# ==================== MODALE : GUIDE UTILISATEUR ==================== #}

{# On détermine quels onglets présenter dans le guide :
   - Si aucune candidature n'est trouvée → on présente les 3 étapes à titre informatif
   - Sinon → on présente uniquement les onglets accessibles au candidat #}
{% set ongletTestGuide      = candidature is null or peutVoirTest %}
{% set ongletVisiteGuide    = candidature is null or peutVoirVisite %}
{% set ongletAdmissionGuide = candidature is null or peutVoirAdmission %}
{% set nbOngletsGuide       = (ongletTestGuide ? 1 : 0) + (ongletVisiteGuide ? 1 : 0) + (ongletAdmissionGuide ? 1 : 0) %}

<div id="guide-modal"
     class="fixed inset-0 z-50 items-center justify-center hidden p-4 bg-black/50 backdrop-blur-sm"
     role="dialog" aria-modal="true"
     onclick="if(event.target === this) closeGuideModal();">

    <div class="relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">

        {# En-tête de la modale #}
        <div class="flex items-center justify-between flex-shrink-0 px-6 py-4 border-b border-indigo-100 bg-gradient-to-r from-indigo-50 to-purple-50">
            <h2 class="flex items-center text-base font-bold text-slate-800 sm:text-lg">
                <div class="flex items-center justify-center w-8 h-8 mr-3 bg-indigo-100 rounded-lg">
                    <i class="text-indigo-600 fas fa-lightbulb"></i>
                </div>
                Comment vérifier mon statut ?
            </h2>
            <button type="button"
                    onclick="closeGuideModal()"
                    class="flex items-center justify-center w-8 h-8 transition rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-700">
                <i class="fas fa-times"></i>
            </button>
        </div>

        {# Corps de la modale (défilable) #}
        <div class="p-6 space-y-5 overflow-y-auto">

            {# Étape A — Saisie de l'identifiant #}
            <div class="flex items-start gap-3">
                <div class="flex items-center justify-center flex-shrink-0 text-xs font-bold text-white bg-indigo-600 rounded-full w-7 h-7">1</div>
                <div>
                    <p class="text-sm font-semibold text-slate-800">Saisissez votre identifiant</p>
                    <p class="mt-1 text-sm text-slate-600">
                        Entrez votre <strong class="text-indigo-600">numéro de candidature</strong>
                        (ex : <code class="px-1.5 py-0.5 font-semibold bg-slate-100 rounded text-xs">DK26010001</code>)
                        ou votre <strong class="text-indigo-600">adresse email</strong>
                        (celle utilisée lors de l'inscription), puis cliquez sur <strong class="text-indigo-600">« Vérifier mon statut »</strong>.
                    </p>
                </div>
            </div>

            {# Étape B — Onglets accessibles #}
            <div class="flex items-start gap-3">
                <div class="flex items-center justify-center flex-shrink-0 text-xs font-bold text-white bg-indigo-600 rounded-full w-7 h-7">2</div>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-800">
                        {% if candidature is not null %}
                            Consultez les onglets <strong class="text-indigo-600">accessibles</strong> pour suivre votre progression
                        {% else %}
                            Consultez les onglets pour suivre votre progression
                        {% endif %}
                    </p>

                    {# Message contextuel #}
                    {% if candidature is not null %}
                        <p class="mt-1 mb-3 text-sm text-slate-600">
                            {% if nbOngletsGuide == 1 %}
                                D'après votre situation actuelle, <strong class="text-indigo-600">un seul onglet</strong> vous est accessible :
                            {% elseif nbOngletsGuide == 2 %}
                                D'après votre situation actuelle, <strong class="text-indigo-600">deux onglets</strong> vous sont accessibles :
                            {% else %}
                                D'après votre situation actuelle, <strong class="text-indigo-600">les trois onglets</strong> vous sont accessibles :
                            {% endif %}
                        </p>
                    {% else %}
                        <p class="mt-1 mb-3 text-sm text-slate-600">
                            Le recrutement comporte <strong>3 étapes successives</strong>. Chaque onglet correspond à une étape.
                            <br>
                            <em class="text-xs text-slate-500">
                                <i class="mr-1 fas fa-info-circle"></i>
                                Selon votre situation, seuls les onglets pertinents vous seront affichés après la recherche.
                            </em>
                        </p>
                    {% endif %}

                    {# Grille des onglets — dynamique selon le nombre #}
                    <div class="grid grid-cols-1 gap-3{% if nbOngletsGuide == 2 %} sm:grid-cols-2{% elseif nbOngletsGuide == 3 %} sm:grid-cols-3{% endif %}">

                        {# --- Test de sélection --- #}
                        {% if ongletTestGuide %}
                        <div class="p-3 border border-indigo-100 rounded-lg bg-indigo-50">
                            <div class="flex items-center gap-2 mb-1">
                                <i class="text-indigo-600 fas fa-file-alt"></i>
                                <span class="text-xs font-bold text-indigo-700 uppercase">Test de sélection</span>
                            </div>
                            <p class="text-xs text-slate-600">
                                Convocation, date, jury et lieu de votre entretien.
                            </p>
                        </div>
                        {% endif %}

                        {# --- Visite médicale --- #}
                        {% if ongletVisiteGuide %}
                        <div class="p-3 border border-teal-100 rounded-lg bg-teal-50">
                            <div class="flex items-center gap-2 mb-1">
                                <i class="text-teal-600 fas fa-heartbeat"></i>
                                <span class="text-xs font-bold text-teal-700 uppercase">Visite médicale</span>
                            </div>
                            <p class="text-xs text-slate-600">
                                Résultat de la délibération et convocation à la visite médicale d'aptitude.
                            </p>
                        </div>
                        {% endif %}

                        {# --- Admission finale --- #}
                        {% if ongletAdmissionGuide %}
                        <div class="p-3 border border-purple-100 rounded-lg bg-purple-50">
                            <div class="flex items-center gap-2 mb-1">
                                <i class="text-purple-600 fas fa-graduation-cap"></i>
                                <span class="text-xs font-bold text-purple-700 uppercase">Admission finale</span>
                            </div>
                            <p class="text-xs text-slate-600">
                                Résultat définitif : admis(e) ou non à la formation.
                            </p>
                        </div>
                        {% endif %}

                    </div>

                    {# Si un seul onglet est accessible, on précise qu'il peut évoluer #}
                    {% if candidature is not null and nbOngletsGuide < 3 %}
                        <div class="flex items-start gap-2 p-2.5 mt-3 text-xs rounded-lg bg-indigo-50/60 border border-indigo-100 text-indigo-800">
                            <i class="fas fa-arrow-up-right-dots mt-0.5 flex-shrink-0"></i>
                            <p>
                                Les autres étapes du recrutement s'afficheront automatiquement
                                dès que votre dossier progressera à l'étape suivante.
                            </p>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Étape C — Codes couleurs #}
            <div class="flex items-start gap-3">
                <div class="flex items-center justify-center flex-shrink-0 text-xs font-bold text-white bg-indigo-600 rounded-full w-7 h-7">3</div>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-800">Interprétez facilement votre statut grâce aux couleurs</p>
                    <div class="flex flex-wrap gap-2 mt-2 text-xs">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-green-100 text-green-700 font-medium">
                            <i class="mr-1 fas fa-check-circle"></i> Validé / Félicitations
                        </span>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 font-medium">
                            <i class="mr-1 fas fa-hourglass-half"></i> En attente / En cours
                        </span>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-red-100 text-red-700 font-medium">
                            <i class="mr-1 fas fa-times-circle"></i> Non retenu
                        </span>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-teal-100 text-teal-700 font-medium">
                            <i class="mr-1 fas fa-notes-medical"></i> Étape en cours
                        </span>
                    </div>
                </div>
            </div>

            {# Astuce contextuelle #}
            <div class="flex items-start gap-2 p-3 mt-2 text-xs text-indigo-800 border border-indigo-100 rounded-lg bg-indigo-50">
                <i class="fas fa-info-circle mt-0.5 flex-shrink-0"></i>
                <p>
                    {% if candidature is not null %}
                        <strong>À noter :</strong> les onglets non affichés correspondent à des étapes qui ne vous concernent
                        pas encore. Ils apparaîtront automatiquement dès que votre candidature franchira l'étape correspondante.
                    {% else %}
                        <strong>Astuce :</strong> effectuez une recherche pour afficher les onglets correspondant à votre situation.
                        Seuls les onglets auxquels vous avez accès seront visibles.
                    {% endif %}
                </p>
            </div>

        </div>

        {# Pied de la modale #}
        <div class="flex justify-end flex-shrink-0 px-6 py-4 border-t border-slate-200 bg-slate-50">
            <button type="button"
                    onclick="closeGuideModal()"
                    class="px-5 py-2 font-semibold text-white transition bg-indigo-600 rounded-lg hover:bg-indigo-700">
                J'ai compris
            </button>
        </div>

    </div>
</div>

<script>
    function openGuideModal() {
        const modal = document.getElementById('guide-modal');
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeGuideModal() {
        const modal = document.getElementById('guide-modal');
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeGuideModal();
        }
    });
</script>

{% endblock %}