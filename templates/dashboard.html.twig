{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/chart.min.js') }}"></script>
    <script>
        (function() {
            function loadScript(src, cb) {
                var s = document.createElement('script');
                s.src = src;
                s.onload = cb;
                document.head.appendChild(s);
            }

            function setupCharts() {
                var dataEl = document.getElementById('participation-data');
                var objEl = document.getElementById('objectif-data');
                if (!dataEl || !objEl || typeof Chart === 'undefined') return;

                var rawData = JSON.parse(dataEl.textContent);
                var targetPercent = parseFloat(JSON.parse(objEl.textContent)) || 30;

                // 1. Initialisation des 4 Donut Gauges
                rawData.forEach(function(etape, index) {
                    var canvas = document.getElementById('gaugeDonut' + index);
                    if (!canvas) return;

                    var total = etape.total || 0;
                    var fem = etape.feminin || 0;
                    var masc = Math.max(0, total - fem);

                    var values = total > 0 ? [fem, masc] : [0, 1];
                    var colors = total > 0 ? ['#ec4899', '#6366f1'] : ['#e2e8f0', '#e2e8f0'];

                    new Chart(canvas, {
                        type: 'doughnut',
                        data: {
                            labels: ['Femmes', 'Hommes'],
                            datasets: [{
                                data: values,
                                backgroundColor: colors,
                                borderWidth: 0,
                                hoverOffset: total > 0 ? 3 : 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            cutout: '74%',
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    enabled: total > 0,
                                    callbacks: {
                                        label: function(ctx) {
                                            var val = ctx.raw;
                                            var pct = total > 0 ? Math.round((val / total) * 100) : 0;
                                            return ' ' + ctx.label + ' : ' + val + ' (' + pct + '%)';
                                        }
                                    }
                                }
                            }
                        }
                    });
                });
            }

            if (typeof Chart === 'undefined') {
                loadScript('https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js', function() {
                    setupCharts();
                });
            } else {
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', setupCharts);
                } else {
                    setupCharts();
                }
            }
        })();
    </script>
{% endblock %}
