{% extends 'base_dashboard.html.twig' %}

{% block title %}Tableau de bord | PACTE{% endblock %}

{% block body %}
<div class="mx-auto">
    <!-- En-tête -->
    <!-- En-tête -->
    <div class="p-4 sm:p-6 lg:p-8 mb-6 sm:mb-8 text-white bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl shadow-lg">
        <div class="flex items-center gap-3 sm:gap-4">
            <div class="flex items-center justify-center w-12 h-12 sm:w-16 sm:h-16 rounded-2xl bg-white/20 shrink-0">
                <i class="text-2xl sm:text-3xl fas fa-chart-line"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold">Tableau de bord</h1>
                <p class="text-xs sm:text-sm text-white/80">
                    {% if is_admin %}
                        Administration générale
                    {% elseif is_candidat %}
                        Ma candidature
                    {% elseif is_ent %}
                        Gestion de l'établissement : {{ etablissement ? etablissement.nom : 'Non défini' }}
                    {% elseif is_jury %}
                        Évaluations
                    {% endif %}
                </p>
            </div>
        </div>
        
        <!-- Statistiques rapides pour l'admin ET l'ENT -->
        {% if (is_admin or is_ent) and stats is defined %}
        <div class="grid grid-cols-2 gap-2.5 sm:gap-4 mt-6 sm:mt-8 sm:grid-cols-3 lg:grid-cols-7">
            <div class="p-3 sm:p-4 text-center bg-white/10 backdrop-blur-sm rounded-xl">
                <div class="text-xl sm:text-2xl font-bold">{{ stats.candidatures }}</div>
                <div class="text-[11px] sm:text-xs text-white/70">Candidatures</div>
            </div>
            <div class="p-3 sm:p-4 text-center bg-white/10 backdrop-blur-sm rounded-xl">
                <div class="text-xl sm:text-2xl font-bold">{{ stats.candidatures_aujourdhui }}</div>
                <div class="text-[11px] sm:text-xs text-white/70">Aujourd'hui</div>
            </div>
            <div class="p-3 sm:p-4 text-center bg-white/10 backdrop-blur-sm rounded-xl">
                <div class="text-xl sm:text-2xl font-bold">{{ stats.metiers }}</div>
                <div class="text-[11px] sm:text-xs text-white/70">Métiers</div>
            </div>
            
            {% if is_admin %}
            <div class="p-3 sm:p-4 text-center bg-white/10 backdrop-blur-sm rounded-xl">
                <div class="text-xl sm:text-2xl font-bold">{{ stats.etablissements }}</div>
                <div class="text-[11px] sm:text-xs text-white/70">Établissements</div>
            </div>
            {% endif %}
            
            <!-- Statistiques des admis -->
            {% if stats.admis is defined %}
            <div class="p-3 sm:p-4 text-center border bg-gradient-to-r from-blue-500/20 to-indigo-500/20 backdrop-blur-sm rounded-xl border-blue-300/30">
                <div class="text-xl sm:text-2xl font-bold text-blue-100">{{ stats.admis.admis }}</div>
                <div class="text-[11px] sm:text-xs text-blue-200">Admis</div>
            </div>
            <div class="p-3 sm:p-4 text-center border bg-gradient-to-r from-emerald-500/20 to-green-500/20 backdrop-blur-sm rounded-xl border-emerald-300/30">
                <div class="text-xl sm:text-2xl font-bold text-emerald-100">{{ stats.admis.admis_definitifs }}</div>
                <div class="text-[11px] sm:text-xs text-emerald-200">Admis Définitifs</div>
            </div>
            {% endif %}
        </div>
        {% endif %}

    </div>

    {% include 'partials/_flash_messages.html.twig' %}

    {% if participation_feminine is defined %}
    <div class="p-4 sm:p-6 mb-6 sm:mb-8 bg-white border shadow-xl rounded-2xl border-slate-200">
        <h2 class="text-base sm:text-lg font-bold text-slate-800">Participation féminine{% if session_consultee %} — {{ session_consultee.nom }}{% endif %}</h2>
        <p class="mb-4 text-xs text-slate-500">Indicateur statistique : objectif de {{ objectif_feminin }} % , de participation féminine </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
            {% for etape in participation_feminine %}
                <div class="p-3.5 sm:p-4 rounded-xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                    <div>
                        <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Étape {{ loop.index }}</span>
                        <p class="text-xs font-bold text-slate-700 leading-snug">{{ etape.libelle }}</p>
                        {% if etape.sous_titre is defined and etape.sous_titre %}
                            <p class="text-[11px] text-slate-400 mt-0.5">{{ etape.sous_titre }}</p>
                        {% endif %}
                    </div>
                    <div class="mt-3">
                        <p class="text-xl sm:text-2xl font-extrabold {{ etape.pourcentage is not null and etape.pourcentage >= objectif_feminin ? 'text-green-600' : 'text-amber-600' }}">
                            {{ etape.pourcentage is null ? '—' : etape.pourcentage ~ ' %' }}
                        </p>
                        <div class="flex items-center justify-between text-xs text-slate-500 mt-1">
                            <span>{{ etape.feminin }} femmes</span>
                            <span class="text-slate-400">sur {{ etape.total }}</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if admis_par_etablissement is defined %}
    <div class="p-4 sm:p-6 mb-6 sm:mb-8 bg-white border shadow-xl rounded-2xl border-slate-200">
        <h2 class="mb-3 text-lg font-bold text-slate-800">Admis par établissement{% if session_consultee %} — {{ session_consultee.nom }}{% endif %}</h2>
        {% for ligne in admis_par_etablissement %}
            <div class="flex justify-between py-1 text-sm border-b border-slate-100"><span>{{ ligne.etablissement }}</span><strong>{{ ligne.admis }}</strong></div>
        {% else %}
            <p class="text-sm text-slate-500">Aucun admis pour cette session.</p>
        {% endfor %}
    </div>
    {% endif %}

    <!-- Contenu principal -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <!-- Colonne principale (2/3) -->
        <div class="space-y-8 lg:col-span-2">
            <!-- Dernières candidatures (pour admin ET ent) -->
            {% if (is_admin or is_ent) and dernieres_candidatures is defined %}
            <div class="overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
                <div class="px-4 sm:px-6 py-3.5 sm:py-4 border-b border-slate-200 bg-gradient-to-r from-indigo-50 to-purple-50">
                    <h2 class="flex items-center text-base sm:text-lg font-semibold text-indigo-800">
                        <i class="mr-2 fas fa-clock"></i>
                        {% if is_ent and etablissement %}
                            Candidatures de {{ etablissement.nom }}
                        {% elseif is_ent %}
                            Candidatures de l'établissement
                        {% else %}
                            Dernières candidatures
                        {% endif %}
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[500px]">
                        <thead class="border-b bg-slate-50 border-slate-200">
                            <tr>
                                <th class="px-3 py-3 text-xs font-medium text-left uppercase text-slate-600">N°</th>
                                <th class="px-2 py-3 text-xs font-medium text-left uppercase text-slate-600">Candidat</th>
                                <th class="px-1 py-3 text-xs font-medium text-left uppercase text-slate-600">Métier</th>
                                <th class="px-2 py-3 text-xs font-medium text-left uppercase text-slate-600">Statut</th>
                                <th class="px-3 py-3 text-xs font-medium text-right uppercase text-slate-600">Date</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            {% for candidature in dernieres_candidatures|slice(0,5) %}
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-2 py-3 font-mono text-sm text-indigo-600">{{ candidature.numero }}</td>
                                <td class="px-2 py-3 text-sm">
                                    {% set user = candidature.user %}
                                    {% if user %}
                                        <div class="font-medium text-slate-800">{{ user.nom }}</div>
                                        <div class="text-sm text-slate-500">{{ user.prenoms }}</div>
                                    {% else %}
                                        <span class="text-slate-400">-</span>
                                    {% endif %}
                                </td>
                                <td class="px-1 py-3 font-bold text-[12px]">{{ candidature.metier ? candidature.metier.nom : '-' }}</td>
                                <td class="px-2 py-3">
                                    {% if candidature.resultat == 2 %}
                                        <span class="px-2 py-1 text-xs font-semibold text-green-700 border border-1 border-green-700 bg-green-100 rounded-full">Admis</span>
                                    {% elseif candidature.entstatut == 2 %}
                                        <span class="px-2 py-1 text-xs font-semibold text-blue-700 border border-1 border-blue-700 bg-blue-100 rounded-full">Admissible</span>
                                    {% elseif candidature.etustatut == 2 %}
                                        <span class="px-2 py-1 text-xs font-semibold text-yellow-700 border border-1 border-yellow-700 bg-yellow-100 rounded-full">Dossier OK</span>
                                    {% elseif candidature.etustatut == 1 %}
                                        <span class="px-2 py-1 text-xs font-semibold text-red-700 border border-1 border-red-700 bg-red-100 rounded-full">Rejeté</span>
                                    {% else %}
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full border border-1 border-slate-700 bg-slate-100 text-slate-600">En attente</span>
                                    {% endif %}
                                </td>
                                <td class="px-2 py-3 text-sm text-right text-slate-500">{{ candidature.creation|date('d/m/Y') }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="px-4 py-8 text-center text-slate-500">
                                    <i class="mb-2 text-3xl opacity-50 fas fa-inbox"></i>
                                    <p>Aucune candidature récente</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}

            <!-- Inscriptions définitives (pour admin ET ent) -->
            {% if (is_admin or is_ent) %}
            <div class="overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
                <div class="px-4 sm:px-6 py-3.5 sm:py-4 border-b border-slate-200 bg-gradient-to-r from-green-50 to-emerald-50">
                    <h2 class="flex items-center text-base sm:text-lg font-semibold text-green-800">
                        <i class="mr-2 fas fa-user-graduate"></i>
                        {% if is_ent and etablissement %}
                            Les admis définitifs - {{ etablissement.nom }}
                        {% elseif is_ent %}
                            Les admis définitifs
                        {% else %}
                            Les admis définitifs
                        {% endif %}
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[460px]">
                        <thead class="border-b bg-slate-50 border-slate-200">
                            <tr>
                                <th class="px-4 py-3 text-xs font-medium text-left uppercase text-slate-600">N° Inscription</th>
                                <th class="px-4 py-3 text-xs font-medium text-left uppercase text-slate-600">Candidat</th>
                                <th class="px-4 py-3 text-xs font-medium text-left uppercase text-slate-600">Métier</th>
                                <th class="px-4 py-3 text-xs font-medium text-left uppercase text-slate-600">Date</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            {% for admis in derniers_admis|default([])|slice(0,5) %}
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-4 py-3 font-mono text-sm text-green-600">{{ admis.numeroInscription }}</td>
                                <td class="px-4 py-3 text-sm">{{ admis.user.nom|upper }} {{ admis.user.prenoms }}</td>
                                <td class="px-4 py-3 text-sm">{{ admis.metier ? admis.metier.nom : '-' }}</td>
                                <td class="px-4 py-3 text-sm text-slate-500">{{ admis.dateInscription|date('d/m/Y') }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="px-4 py-8 text-center text-slate-500">
                                    <i class="mb-2 text-3xl opacity-50 fas fa-user-graduate"></i>
                                    <p>Aucune inscription définitive</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if is_admin %}
                <div class="px-6 py-3 border-t bg-green-50 border-slate-200">
                    <a href="{{ path('app_admis_index') }}" class="inline-flex items-center px-3 py-1.5 bg-green-600 text-white text-sm rounded-lg hover:bg-green-700 transition">
                        <i class="mr-1 fas fa-list"></i>
                        Voir la liste complète
                    </a>
                </div>
                {% endif %}
            </div>
            {% endif %}

            {% if is_candidat and mes_candidatures is defined %}
            <!-- Mes candidatures (Candidat) -->
            <div class="overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
                <div class="px-4 sm:px-6 py-3.5 sm:py-4 border-b border-slate-200 bg-gradient-to-r from-indigo-50 to-purple-50">
                    <h2 class="flex items-center text-base sm:text-lg font-semibold text-indigo-800">
                        <i class="mr-2 fas fa-file-alt"></i>
                        Ma candidature
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[460px]">
                        <thead class="border-b bg-slate-50 border-slate-200">
                            <tr>
                                <th class="px-2 py-3 text-xs font-medium text-left uppercase text-slate-600">N°</th>
                                <th class="px-2 py-3 text-xs font-medium text-left uppercase text-slate-600">Métier</th>
                                <th class="px-2 py-3 text-xs font-medium text-left uppercase text-slate-600">Établissement</th>
                                <th class="px-2 py-3 text-xs font-medium text-left uppercase text-slate-600">Statut</th>
                                <th class="px-2 py-3 text-xs font-medium text-right uppercase text-slate-600">Date</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            {% for candidature in mes_candidatures %}
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-2 py-3 font-mono text-sm text-indigo-600">{{ candidature.numero }}</td>
                                <td class="px-2 py-3 text-xs">{{ candidature.metier ? candidature.metier.nom : '-' }}</td>
                                <td class="px-2 py-3 text-xs">{{ candidature.etablissement ? candidature.etablissement.nom : '-' }}</td>
                                <td class="px-2 py-3">
                                    {% if candidature.resultat == 2 %}
                                        <span class="px-2 py-1 text-xs font-semibold text-green-700 bg-green-100 rounded-full">Admis</span>
                                    {% elseif candidature.entstatut == 2 %}
                                        <span class="px-2 py-1 text-xs font-semibold text-blue-700 bg-blue-100 rounded-full">Admissible</span>
                                    {% elseif candidature.etustatut == 2 %}
                                        <span class="px-2 py-1 text-xs font-semibold text-yellow-700 bg-yellow-100 rounded-full">Dossier accepté</span>
                                    {% elseif candidature.etustatut == 1 %}
                                        <span class="px-2 py-1 text-xs font-semibold text-red-700 bg-red-100 rounded-full">Rejeté</span>
                                    {% else %}
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-slate-100 text-slate-600">En attente</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 text-sm text-right text-slate-500">{{ candidature.creation|date('d/m/Y') }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="px-4 py-8 text-center text-slate-500">
                                    <i class="mb-2 text-3xl opacity-50 fas fa-file-alt"></i>
                                    <p class="mb-2">Vous n'avez pas encore de candidature</p>
                                    <a href="{{ path('app_candidature_new') }}" class="inline-flex items-center px-3 py-1.5 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700 transition">
                                        <i class="mr-1 fas fa-plus-circle"></i>
                                        Déposer une candidature
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Colonne latérale (1/3) -->
        <div class="space-y-8">
            <!-- Derniers inscrits (pour admin ET ent) -->
            {% if (is_admin or is_ent) and derniers_inscrits is defined %}
            <div class="overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
                <div class="px-4 sm:px-6 py-3.5 sm:py-4 border-b border-slate-200 bg-gradient-to-r from-indigo-50 to-purple-50">
                    <h2 class="flex items-center text-base sm:text-lg font-semibold text-indigo-800">
                        <i class="mr-2 fas fa-user-plus"></i>
                        {% if is_ent and etablissement %}
                            Derniers candidats - {{ etablissement.nom }}
                        {% elseif is_ent %}
                            Derniers candidats
                        {% else %}
                            Nouveaux inscrits
                        {% endif %}
                    </h2>
                </div>
                <div class="divide-y divide-slate-200">
                    {% for user in derniers_inscrits|slice(0,5) %}
                    <div class="px-4 sm:px-6 py-3 transition hover:bg-slate-50">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center justify-center flex-shrink-0 w-8 h-8 bg-indigo-100 rounded-full">
                                <i class="text-xs text-indigo-600 fas fa-user"></i>
                            </div>
                            <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate text-slate-800">{{ user.nom }} {{ user.prenoms }}</p>
            <p class="text-xs truncate text-slate-500">{{ user.email }}</p>
            
            {# Définition des couleurs de rôles et de leurs équivalents en couleur de texte #}
            {% set primaryRole = user.roles|first %}
            {% set roleConfig = {
                'ROLE_ADMIN': ['Administrateur', 'bg-red-500 text-white', 'text-red-600'],
                'ROLE_ENT': ['Etablissement', 'bg-green-500 text-white', 'text-green-600'],
                'ROLE_CANDIDAT': ['Candidat', 'bg-blue-500 text-white', 'text-blue-600'],
                'ROLE_AGENT': ['Agent', 'bg-yellow-500 text-white', 'text-yellow-600'],
                'ROLE_JURY': ['Jury', 'bg-purple-500 text-white', 'text-purple-600']
            } %}
            {% set mainRoleInfo = roleConfig[primaryRole] ?? [primaryRole|replace({'ROLE_': ''})|title, 'bg-gray-500 text-white', 'text-gray-600'] %}

            <div class="flex flex-wrap gap-1 mt-1">
                {% for role in user.roles %}
                {% set roleInfo = roleConfig[role] ?? [role|replace({'ROLE_': ''})|title, 'bg-gray-500 text-white', 'text-gray-600'] %}
                <span class="px-2 py-0.5 rounded text-xs font-medium {{ roleInfo[1] }}">{{ roleInfo[0] }}</span>
                {% endfor %}
            </div>
        </div>
        
        <div class="flex-shrink-0 text-right">
            <span class="hidden sm:block text-xs font-medium text-slate-400">Nouveau</span>
            <span class="block text-[11px] font-bold {{ mainRoleInfo[2] }} mt-0.5 whitespace-nowrap">
                <span class="hidden sm:inline">Inscrit le : </span>{{ user.createdAt ? user.createdAt|date('d/m/Y') : 'Non renseigné' }}
            </span>
        </div>
    </div>
</div>
                    {% else %}
                    <div class="px-6 py-8 text-center text-slate-500">
                        <i class="mb-2 text-3xl opacity-50 fas fa-users"></i>
                        <p>Aucun candidat récent</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <!-- Actions rapides -->
            <div class="overflow-hidden bg-white border shadow-xl rounded-2xl border-slate-200">
                <div class="px-4 sm:px-6 py-3.5 sm:py-4 border-b border-slate-200 bg-gradient-to-r from-indigo-50 to-purple-50">
                    <h2 class="flex items-center text-base sm:text-lg font-semibold text-indigo-800">
                        <i class="mr-2 fas fa-bolt"></i>
                        Actions rapides
                    </h2>
                </div>
                <div class="p-4 sm:p-6">
                    <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
                        {% if is_admin %}
                            <a href="{{ path('app_candidature_index') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-indigo-50 hover:bg-indigo-100">
                                <i class="mb-1 text-xl text-indigo-600 fas fa-list"></i>
                                <span class="text-xs text-indigo-700">Toutes les candidatures</span>
                            </a>
                            <a href="{{ path('app_admis_admin_liste') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-green-50 hover:bg-green-100">
                                <i class="mb-1 text-xl text-green-600 fas fa-user-graduate"></i>
                                <span class="text-xs text-green-700">Liste des admis</span>
                            </a>
                            <a href="{{ path('app_admis_index') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-emerald-50 hover:bg-emerald-100">
                                <i class="mb-1 text-xl fas fa-clipboard-check text-emerald-600"></i>
                                <span class="text-xs text-emerald-700">Admis définitifs</span>
                            </a>
                            <a href="{{ path('app_candidature_impressions') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-blue-50 hover:bg-blue-100">
                                <i class="mb-1 text-xl text-blue-600 fas fa-download"></i>
                                <span class="text-xs text-blue-700">Exports</span>
                            </a>
                            <a href="{{ path('app_candidature_stat') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-purple-50 hover:bg-purple-100">
                                 <i class="mb-1 text-xl text-purple-600 fas fa-chart-bar"></i>
                                 <span class="text-xs text-purple-700">Statistiques</span>
                            </a>
                            <a href="{{ path('app_metier_new') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-amber-50 hover:bg-amber-100">
                                <i class="mb-1 text-xl fas fa-briefcase text-amber-600"></i>
                                <span class="text-xs text-amber-700">Nouveau métier</span>
                            </a>
                            {% elseif is_ent and not is_admin %}
                            <a href="{{ path('app_candidature_index') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-indigo-50 hover:bg-indigo-100">
                                <i class="mb-1 text-xl text-indigo-600 fas fa-clipboard-check"></i>
                                <span class="text-xs text-indigo-700">Gérer les candidatures</span>
                            </a>
                            <a href="{{ path('app_admis_liste') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-green-50 hover:bg-green-100">
                                <i class="mb-1 text-xl text-green-600 fas fa-user-graduate"></i>
                                <span class="text-xs text-green-700">Liste des admis</span>
                            </a>
                            <a href="{{ path('app_candidature_impressions') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-purple-50 hover:bg-purple-100">
                                <i class="mb-1 text-xl text-purple-600 fas fa-print"></i>
                                <span class="text-xs text-purple-700">Impressions</span>
                            </a>
                        {% if etablissement %}
                            <a href="{{ path('app_candidature_stat', {'etablissement': etablissement.id}) }}" class="flex flex-col items-center p-3 transition rounded-lg bg-blue-50 hover:bg-blue-100">
                                 <i class="mb-1 text-xl text-blue-600 fas fa-chart-bar"></i>
                                 <span class="text-xs text-blue-700">Statistiques</span>
                             </a>
                            <a href="{{ path('app_etablissement_show', {'id': etablissement.id}) }}" class="flex flex-col items-center p-3 transition rounded-lg bg-amber-50 hover:bg-amber-100">
                                <i class="mb-1 text-xl fas fa-building text-amber-600"></i>
                                <span class="text-xs text-amber-700">Mon établissement</span>
                            </a>
                        {% endif %}
                        </div>
                        {% elseif is_candidat %}
                            <a href="{{ path('app_candidature_new') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-indigo-50 hover:bg-indigo-100">
                                <i class="mb-1 text-xl text-indigo-600 fas fa-plus-circle"></i>
                                <span class="text-xs text-indigo-700">Nouvelle candidature</span>
                            </a>
                            <a href="{{ path('app_user_edit', {'id': app.user.id}) }}" class="flex flex-col items-center p-3 transition rounded-lg bg-amber-50 hover:bg-amber-100">
                                <i class="mb-1 text-xl fas fa-user-edit text-amber-600"></i>
                                <span class="text-xs text-amber-700">Mon profil</span>
                            </a>
                            <a href="{{ path('app_candidature_impressions') }}" class="flex flex-col items-center p-3 transition rounded-lg bg-purple-50 hover:bg-purple-100">
                                <i class="mb-1 text-xl text-purple-600 fas fa-print"></i>
                                <span class="text-xs text-purple-700">Impressions</span>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
